#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
T109 任务轮询服务 - 数据库迁移脚本

添加 task_worker 需要的字段到 tasks 表
"""

import sqlite3
import os
import sys

DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'kanban_v5.db')

def migrate_database():
    """执行数据库迁移"""
    print(f"数据库路径：{DB_PATH}")
    
    if not os.path.exists(DB_PATH):
        print(f"❌ 数据库文件不存在：{DB_PATH}")
        return False
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # 获取当前表结构
    c.execute("PRAGMA table_info(tasks)")
    columns = [col[1] for col in c.fetchall()]
    
    print(f"当前字段数：{len(columns)}")
    print(f"当前字段：{', '.join(columns)}")
    
    # 需要添加的字段
    new_columns = [
        ('slurm_job_id', 'INTEGER', None),
        ('slurm_output_file', 'TEXT', None),
        ('retry_count', 'INTEGER', '0'),
    ]
    
    added = []
    skipped = []
    errors = []
    
    for col_name, col_type, default in new_columns:
        if col_name not in columns:
            try:
                if default:
                    sql = f"ALTER TABLE tasks ADD COLUMN {col_name} {col_type} DEFAULT {default}"
                else:
                    sql = f"ALTER TABLE tasks ADD COLUMN {col_name} {col_type}"
                
                c.execute(sql)
                added.append(col_name)
                print(f"✅ 添加字段：{col_name}")
            except sqlite3.OperationalError as e:
                errors.append((col_name, str(e)))
                print(f"❌ 添加字段失败 {col_name}: {e}")
        else:
            skipped.append(col_name)
            print(f"⏭️  字段已存在：{col_name}")
    
    conn.commit()
    conn.close()
    
    # 打印摘要
    print("\n" + "=" * 60)
    print("迁移完成")
    print("=" * 60)
    print(f"✅ 新增字段：{len(added)} - {', '.join(added) if added else '无'}")
    print(f"⏭️  已存在：{len(skipped)} - {', '.join(skipped) if skipped else '无'}")
    print(f"❌ 错误：{len(errors)}")
    
    if errors:
        print("\n错误详情:")
        for col, err in errors:
            print(f"  - {col}: {err}")
        return False
    
    return True


if __name__ == '__main__':
    success = migrate_database()
    sys.exit(0 if success else 1)
