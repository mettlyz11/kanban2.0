"""
P049项目 - API密钥管理和密码管理模块
技术栈: FastAPI风格 (基于现有Flask后端)
数据库: SQLite
认证: JWT Token
"""

import sqlite3
import hashlib
import secrets
import string
from datetime import datetime, timedelta
from functools import wraps
from flask import request, jsonify, current_app
import jwt
from werkzeug.security import generate_password_hash, check_password_hash

# ============================================
# 数据库表创建语句
# ============================================

CREATE_API_KEYS_TABLE = """
CREATE TABLE IF NOT EXISTS api_keys (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    key_name TEXT NOT NULL,
    api_key TEXT UNIQUE NOT NULL,
    api_secret TEXT NOT NULL,
    permissions TEXT DEFAULT 'read',  -- JSON array: ['read', 'write', 'delete', 'admin']
    is_active BOOLEAN DEFAULT 1,
    last_used_at TIMESTAMP,
    expires_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
"""

CREATE_PASSWORDS_TABLE = """
CREATE TABLE IF NOT EXISTS user_passwords (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    service_name TEXT NOT NULL,
    service_url TEXT,
    username TEXT,
    encrypted_password TEXT NOT NULL,
    notes TEXT,
    category TEXT DEFAULT 'other',  -- email, social, finance, work, other
    is_favorite BOOLEAN DEFAULT 0,
    last_used_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
"""

CREATE_USERS_TABLE = """
CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    email TEXT UNIQUE,
    password_hash TEXT NOT NULL,
    is_active BOOLEAN DEFAULT 1,
    is_admin BOOLEAN DEFAULT 0,
    last_login_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
"""

# ============================================
# 辅助函数
# ============================================

def get_db_connection(db_path):
    """获取数据库连接"""
    conn = sqlite3.connect(db_path)
    
    return conn

def generate_api_key():
    """生成API Key"""
    prefix = "ak_"
    key = prefix + secrets.token_urlsafe(32)
    return key

def generate_api_secret():
    """生成API Secret"""
    return secrets.token_urlsafe(64)

def generate_secure_password(length=16):
    """生成安全密码"""
    alphabet = string.ascii_letters + string.digits + string.punctuation
    while True:
        password = ''.join(secrets.choice(alphabet) for _ in range(length))
        if (any(c.islower() for c in password)
            and any(c.isupper() for c in password)
            and any(c.isdigit() for c in password)
            and any(c in string.punctuation for c in password)):
            return password

def hash_api_secret(secret):
    """哈希API Secret（存储用）"""
    return hashlib.sha256(secret.encode()).hexdigest()

def encrypt_password(password, master_key):
    """简单加密密码（实际生产环境应使用更安全的加密）"""
    # 这里使用简单的XOR加密作为示例，实际应使用AES等
    import base64
    encrypted = bytearray()
    key_bytes = master_key.encode()
    for i, c in enumerate(password.encode()):
        encrypted.append(c ^ key_bytes[i % len(key_bytes)])
    return base64.b64encode(bytes(encrypted)).decode()

def decrypt_password(encrypted_password, master_key):
    """解密密码"""
    import base64
    encrypted = base64.b64decode(encrypted_password)
    decrypted = bytearray()
    key_bytes = master_key.encode()
    for i, c in enumerate(encrypted):
        decrypted.append(c ^ key_bytes[i % len(key_bytes)])
    return bytes(decrypted).decode()

# ============================================
# JWT认证装饰器
# ============================================

def token_required(f):
    """JWT Token验证装饰器"""
    @wraps(f)
    def decorated(*args, **kwargs):
        token = None
        if 'Authorization' in request.headers:
            auth_header = request.headers['Authorization']
            try:
                token = auth_header.split(" ")[1]
            except IndexError:
                return jsonify({'success': False, 'error': 'Token格式错误'}), 401
        
        if not token:
            return jsonify({'success': False, 'error': '缺少认证Token'}), 401
        
        try:
            # 从应用配置获取JWT密钥
            jwt_secret = current_app.config.get('JWT_SECRET_KEY', 'your-secret-key')
            data = jwt.decode(token, jwt_secret, algorithms=["HS256"])
            current_user_id = data['user_id']
        except jwt.ExpiredSignatureError:
            return jsonify({'success': False, 'error': 'Token已过期'}), 401
        except jwt.InvalidTokenError:
            return jsonify({'success': False, 'error': '无效的Token'}), 401
        
        return f(current_user_id, *args, **kwargs)
    
    return decorated

def api_key_required(f):
    """API Key验证装饰器"""
    @wraps(f)
    def decorated(*args, **kwargs):
        api_key = None
        # 从Header获取
        if 'X-API-Key' in request.headers:
            api_key = request.headers['X-API-Key']
        # 从Query参数获取
        elif request.args.get('api_key'):
            api_key = request.args.get('api_key')
        
        if not api_key:
            return jsonify({'success': False, 'error': '缺少API Key'}), 401
        
        # 验证API Key
        db_path = current_app.config.get('DB_PATH')
        conn = get_db_connection(db_path)
        c = conn.cursor()
        c.execute('''
            SELECT id, user_id, permissions, is_active, expires_at 
            FROM api_keys 
            WHERE api_key = ?
        ''', (api_key,))
        key_data = c.fetchone()
        conn.close()
        
        if not key_data:
            return jsonify({'success': False, 'error': '无效的API Key'}), 401
        
        if not key_data['is_active']:
            return jsonify({'success': False, 'error': 'API Key已禁用'}), 401
        
        if key_data['expires_at'] and datetime.fromisoformat(key_data['expires_at']) < datetime.now():
            return jsonify({'success': False, 'error': 'API Key已过期'}), 401
        
        # 更新最后使用时间
        conn = get_db_connection(db_path)
        c = conn.cursor()
        c.execute('UPDATE api_keys SET last_used_at = ? WHERE id = ?',
                  (datetime.now().isoformat(), key_data['id']))
        conn.commit()
        conn.close()
        
        # 将API Key信息传递给被装饰的函数
        kwargs['api_key_data'] = {
            'key_id': key_data['id'],
            'user_id': key_data['user_id'],
            'permissions': json.loads(key_data['permissions']) if key_data['permissions'] else ['read']
        }
        
        return f(*args, **kwargs)
    
    return decorated

# ============================================
# 数据库初始化
# ============================================

def init_auth_tables(db_path):
    """初始化认证相关表"""
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    
    # 创建用户表
    c.execute(CREATE_USERS_TABLE)
    
    # 创建API Keys表
    c.execute(CREATE_API_KEYS_TABLE)
    
    # 创建密码管理表
    c.execute(CREATE_PASSWORDS_TABLE)
    
    conn.commit()
    conn.close()
    print("✅ 认证相关表初始化完成")

# ============================================
# API密钥管理服务
# ============================================

class APIKeyManager:
    """API密钥管理器"""
    
    def __init__(self, db_path):
        self.db_path = db_path
    
    def create_key(self, user_id, key_name, permissions=None, expires_days=None):
        """创建新的API Key"""
        api_key = generate_api_key()
        api_secret = generate_api_secret()
        secret_hash = hash_api_secret(api_secret)
        
        if permissions is None:
            permissions = ['read']
        
        expires_at = None
        if expires_days:
            expires_at = (datetime.now() + timedelta(days=expires_days)).isoformat()
        
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        try:
            c.execute('''
                INSERT INTO api_keys 
                (user_id, key_name, api_key, api_secret, permissions, expires_at)
                VALUES (?, ?, ?, ?, ?, ?)
            ''', (user_id, key_name, api_key, secret_hash, json.dumps(permissions), expires_at))
            
            key_id = c.lastrowid
            conn.commit()
            
            return {
                'success': True,
                'key_id': key_id,
                'api_key': api_key,
                'api_secret': api_secret,  # 只返回一次
                'key_name': key_name,
                'permissions': permissions,
                'expires_at': expires_at
            }
        except sqlite3.IntegrityError:
            return {'success': False, 'error': 'API Key生成失败，请重试'}
        finally:
            conn.close()
    
    def list_keys(self, user_id):
        """列出用户的所有API Key"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('''
            SELECT id, key_name, api_key, permissions, is_active, 
                   last_used_at, expires_at, created_at
            FROM api_keys
            WHERE user_id = ?
            ORDER BY created_at DESC
        ''', (user_id,))
        
        keys = []
        for row in c.fetchall():
            keys.append({
                'id': row['id'],
                'key_name': row['key_name'],
                'api_key': row['api_key'][:20] + '...',  # 部分隐藏
                'permissions': json.loads(row['permissions']) if row['permissions'] else ['read'],
                'is_active': bool(row['is_active']),
                'last_used_at': row['last_used_at'],
                'expires_at': row['expires_at'],
                'created_at': row['created_at']
            })
        
        conn.close()
        return {'success': True, 'keys': keys}
    
    def revoke_key(self, user_id, key_id):
        """撤销API Key"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('UPDATE api_keys SET is_active = 0 WHERE id = ? AND user_id = ?',
                  (key_id, user_id))
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': 'API Key已撤销'}
        else:
            result = {'success': False, 'error': 'API Key不存在或无权限'}
        
        conn.close()
        return result
    
    def delete_key(self, user_id, key_id):
        """删除API Key"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('DELETE FROM api_keys WHERE id = ? AND user_id = ?',
                  (key_id, user_id))
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': 'API Key已删除'}
        else:
            result = {'success': False, 'error': 'API Key不存在或无权限'}
        
        conn.close()
        return result
    
    def update_key(self, user_id, key_id, key_name=None, permissions=None, is_active=None):
        """更新API Key信息"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        updates = []
        values = []
        
        if key_name is not None:
            updates.append('key_name = ?')
            values.append(key_name)
        if permissions is not None:
            updates.append('permissions = ?')
            values.append(json.dumps(permissions))
        if is_active is not None:
            updates.append('is_active = ?')
            values.append(1 if is_active else 0)
        
        if not updates:
            conn.close()
            return {'success': False, 'error': '没有要更新的字段'}
        
        updates.append('updated_at = ?')
        values.append(datetime.now().isoformat())
        values.extend([key_id, user_id])
        
        c.execute(f'''
            UPDATE api_keys 
            SET {', '.join(updates)}
            WHERE id = ? AND user_id = ?
        ''', values)
        
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': 'API Key已更新'}
        else:
            result = {'success': False, 'error': 'API Key不存在或无权限'}
        
        conn.close()
        return result

# ============================================
# 密码管理服务
# ============================================

class PasswordManager:
    """密码管理器"""
    
    def __init__(self, db_path, master_key=None):
        self.db_path = db_path
        self.master_key = master_key or 'default-master-key-change-in-production'
    
    def add_password(self, user_id, service_name, encrypted_password, 
                     service_url=None, username=None, notes=None, category='other'):
        """添加密码"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        try:
            c.execute('''
                INSERT INTO user_passwords 
                (user_id, service_name, service_url, username, encrypted_password, notes, category)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (user_id, service_name, service_url, username, encrypted_password, notes, category))
            
            password_id = c.lastrowid
            conn.commit()
            
            return {
                'success': True,
                'password_id': password_id,
                'message': '密码已保存'
            }
        except Exception as e:
            return {'success': False, 'error': str(e)}
        finally:
            conn.close()
    

@app.route('/api/projects/<int:project_id>', methods=['GET'])\ndef get_project(project_id):
    """获取项目详情"""\n    conn = get_db()\n    c = conn.cursor()\n    c.execute(SELECT
    def list_passwords(self, user_id, category=None, search=None):
        """列出用户的所有密码"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        query = '''
            SELECT id, service_name, service_url, username, notes, category,
                   is_favorite, last_used_at, created_at
            FROM user_passwords
            WHERE user_id = ?
        '''
        params = [user_id]
        
        if category:
            query += ' AND category = ?'
            params.append(category)
        
        if search:
            query += ' AND (service_name LIKE ? OR username LIKE ? OR notes LIKE ?)'
            search_pattern = f'%{search}%'
            params.extend([search_pattern, search_pattern, search_pattern])
        
        query += ' ORDER BY is_favorite DESC, created_at DESC'
        
        c.execute(query, params)
        
        passwords = []
        for row in c.fetchall():
            passwords.append({
                'id': row['id'],
                'service_name': row['service_name'],
                'service_url': row['service_url'],
                'username': row['username'],
                'notes': row['notes'],
                'category': row['category'],
                'is_favorite': bool(row['is_favorite']),
                'last_used_at': row['last_used_at'],
                'created_at': row['created_at']
            })
        
        conn.close()
        return {'success': True, 'passwords': passwords}
    
    def get_password(self, user_id, password_id):
        """获取单个密码（解密）"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('''
            SELECT id, service_name, service_url, username, encrypted_password,
                   notes, category, is_favorite, created_at
            FROM user_passwords
            WHERE id = ? AND user_id = ?
        ''', (password_id, user_id))
        
        row = c.fetchone()
        
        if not row:
            conn.close()
            return {'success': False, 'error': '密码记录不存在'}
        
        # 解密密码
        try:
            decrypted_password = decrypt_password(row['encrypted_password'], self.master_key)
        except Exception as e:
            conn.close()
            return {'success': False, 'error': '密码解密失败'}
        
        # 更新最后使用时间
        c.execute('UPDATE user_passwords SET last_used_at = ? WHERE id = ?',
                  (datetime.now().isoformat(), password_id))
        conn.commit()
        conn.close()
        
        return {
            'success': True,
            'password': {
                'id': row['id'],
                'service_name': row['service_name'],
                'service_url': row['service_url'],
                'username': row['username'],
                'password': decrypted_password,
                'notes': row['notes'],
                'category': row['category'],
                'is_favorite': bool(row['is_favorite']),
                'created_at': row['created_at']
            }
        }
    
    def update_password(self, user_id, password_id, **kwargs):
        """更新密码"""
        allowed_fields = ['service_name', 'service_url', 'username', 
                         'encrypted_password', 'notes', 'category', 'is_favorite']
        
        updates = []
        values = []
        
        for field, value in kwargs.items():
            if field in allowed_fields and value is not None:
                updates.append(f'{field} = ?')
                values.append(value)
        
        if not updates:
            return {'success': False, 'error': '没有要更新的字段'}
        
        updates.append('updated_at = ?')
        values.append(datetime.now().isoformat())
        values.extend([password_id, user_id])
        
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute(f'''
            UPDATE user_passwords 
            SET {', '.join(updates)}
            WHERE id = ? AND user_id = ?
        ''', values)
        
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': '密码已更新'}
        else:
            result = {'success': False, 'error': '密码记录不存在或无权限'}
        
        conn.close()
        return result
    
    def delete_password(self, user_id, password_id):
        """删除密码"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('DELETE FROM user_passwords WHERE id = ? AND user_id = ?',
                  (password_id, user_id))
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': '密码已删除'}
        else:
            result = {'success': False, 'error': '密码记录不存在或无权限'}
        
        conn.close()
        return result
    
    def toggle_favorite(self, user_id, password_id):
        """切换收藏状态"""
        conn = get_db_connection(self.db_path)
        c = conn.cursor()
        
        c.execute('''
            UPDATE user_passwords 
            SET is_favorite = CASE WHEN is_favorite = 1 THEN 0 ELSE 1 END,
                updated_at = ?
            WHERE id = ? AND user_id = ?
        ''', (datetime.now().isoformat(), password_id, user_id))
        
        conn.commit()
        
        if c.rowcount > 0:
            result = {'success': True, 'message': '收藏状态已更新'}
        else:
            result = {'success': False, 'error': '密码记录不存在或无权限'}
        
        conn.close()
        return result
    
    def get_categories(self):
        """获取密码分类列表"""
        return {
            'success': True,
            'categories': [
                {'id': 'email', 'name': '邮箱', 'icon': 'email'},
                {'id': 'social', 'name': '社交', 'icon': 'people'},
