                    CASE m.priority 
                        WHEN 'high' THEN 1 
                        WHEN 'medium' THEN 2 
                        ELSE 3 
                    END,
                    m.created_at DESC
            ''', (source,))
        else:
            c.execute('''
                SELECT 
                    m.id,
                    m.task_type,
                    m.title,
                    m.description,
                    m.source,
                    m.status,
                    m.priority,
                    m.completion_notes as notes,
                    m.created_at,
                    m.completed_at,
                    m.completed_by as reviewer,
                    m.is_from_long_think,
                    m.original_task_id as source_id
                FROM manual_review_tasks m
                WHERE m.status = 'pending'
                ORDER BY 
                    CASE m.priority 
                        WHEN 'high' THEN 1 
                        WHEN 'medium' THEN 2 
                        ELSE 3 
                    END,
                    m.created_at DESC
            ''')
    
        tasks = [row_to_dict(row, c) for row in c.fetchall()]
        conn.close()
    
        return jsonify({
            'success': True,
            'count': len(tasks),
            'tasks': tasks
        })
    
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500


