    """获取股票统计"""
    try:
        conn = get_db()
        c = conn.cursor()
    
        c.execute('SELECT SUM(shares * avg_cost) FROM stocks')
        total_cost = c.fetchone()[0] or 0
    
        c.execute('SELECT SUM(shares * current_price) FROM stocks')
