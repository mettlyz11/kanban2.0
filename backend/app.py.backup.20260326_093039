            WHERE timestamp >= date('now', '-{} days')
            GROUP BY date(timestamp)
            ORDER BY date DESC
        '''.format(days))
    
        daily = []
        for row in c.fetchall():
            daily.append({
                'date': row[0],
                'tokens': row[1] or 0,
                'cost': round(row[2] or 0, 4),
                'requests': row[3]
            })
    
        conn.close()
        return jsonify({'success': True, 'daily': daily})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

