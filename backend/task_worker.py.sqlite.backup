#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
T109: MacMini 任务轮询服务

核心功能:
1. 轮询数据库获取待处理任务
2. 调用 SLURM 提交计算作业
3. 监控作业状态更新
4. 计算完成后读取结果文件
5. 更新数据库任务状态和结果
6. 支持多任务并行和错误恢复
7. 添加日志和心跳机制

作者: OpenClaw Subagent
创建时间: 2026-03-11
"""

import os
import sys
import json
import time
import sqlite3
import logging
import subprocess
import threading
import signal
from datetime import datetime, timedelta
from pathlib import Path
from typing import Dict, List, Optional, Any, Tuple
from dataclasses import dataclass, asdict
from enum import Enum
from concurrent.futures import ThreadPoolExecutor, as_completed
import traceback
import hashlib
import shutil

# ==================== 配置 ====================

# 数据库路径
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'kanban_v5.db')

# 日志配置
LOG_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'logs')
os.makedirs(LOG_DIR, exist_ok=True)

LOG_FILE = os.path.join(LOG_DIR, f'task_worker_{datetime.now().strftime("%Y%m%d")}.log')
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler(LOG_FILE, encoding='utf-8'),
        logging.StreamHandler(sys.stdout)
    ]
)
logger = logging.getLogger('TaskWorker')

# SLURM 配置
SLURM_CONFIG = {
    'partition': 'compute',
    'time': '24:00:00',
    'nodes': 1,
    'ntasks': 1,
    'cpus_per_task': 4,
    'mem': '8G',
    'output_dir': os.path.join(os.path.dirname(os.path.abspath(__file__)), 'slurm_output'),
}
os.makedirs(SLURM_CONFIG['output_dir'], exist_ok=True)

# 轮询配置
POLL_INTERVAL_SECONDS = 10  # 数据库轮询间隔
MAX_CONCURRENT_TASKS = 5    # 最大并行任务数
TASK_TIMEOUT_HOURS = 48     # 任务超时时间（小时）
HEARTBEAT_INTERVAL_SECONDS = 30  # 心跳间隔

# 任务状态
class TaskStatus(Enum):
    TODO = 'todo'
    IN_PROGRESS = 'in_progress'
    SUBMITTED = 'submitted'
    RUNNING = 'running'
    COMPLETED = 'completed'
    FAILED = 'failed'
    CANCELLED = 'cancelled'
    RETRYING = 'retrying'


# ==================== 数据模型 ====================

@dataclass
class Task:
    """任务数据类"""
    id: int
    project_id: int
    title: str
    description: str
    status: str
    priority: str
    details: Optional[Dict[str, Any]]
    created_at: str
    updated_at: str
    start_time: Optional[str]
    end_time: Optional[str]
    result_summary: Optional[str]
    depends_on: Optional[int]
    requires_audit: int
    audit_status: str
    
    # SLURM 相关
    slurm_job_id: Optional[int] = None
    slurm_output_file: Optional[str] = None
    retry_count: int = 0
    
    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


@dataclass
class SlurmJobResult:
    """SLURM 作业结果"""
    job_id: int
    status: str  # PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
    exit_code: Optional[int]
    output_file: str
    error_file: str
    start_time: Optional[str]
    end_time: Optional[str]
    error_message: str = ""


# ==================== 数据库操作 ====================

class TaskDatabase:
    """任务数据库操作类"""
    
    def __init__(self, db_path: str = DB_PATH):
        self.db_path = db_path
        self._local = threading.local()
    
    def _get_connection(self) -> sqlite3.Connection:
        """获取线程独立的数据库连接"""
        if not hasattr(self._local, 'conn') or self._local.conn is None:
            self._local.conn = sqlite3.connect(self.db_path, timeout=30)
            self._local.conn.row_factory = sqlite3.Row
        return self._local.conn
    
    def get_pending_tasks(self, limit: int = 10) -> List[Task]:
        """获取待处理任务"""
        conn = self._get_connection()
        c = conn.cursor()
        
        # 获取状态为 todo 且没有依赖或依赖已完成的任务
        c.execute('''
            SELECT t.id, t.project_id, t.title, t.description, t.status, t.priority,
                   t.details, t.created_at, t.updated_at, t.start_time, t.end_time,
                   t.result_summary, t.depends_on, t.requires_audit, t.audit_status
            FROM tasks t
            WHERE t.status = 'todo'
              AND (t.depends_on IS NULL OR 
                   EXISTS (SELECT 1 FROM tasks dt 
                           WHERE dt.id = t.depends_on 
                           AND dt.status = 'completed'))
            ORDER BY 
                CASE t.priority 
                    WHEN 'critical' THEN 1 
                    WHEN 'high' THEN 2 
                    WHEN 'medium' THEN 3 
                    WHEN 'low' THEN 4 
                    ELSE 5 
                END,
                t.created_at ASC
            LIMIT ?
        ''', (limit,))
        
        rows = c.fetchall()
        tasks = []
        for row in rows:
            details = None
            if row['details']:
                try:
                    details = json.loads(row['details'])
                except (json.JSONDecodeError, TypeError):
                    details = {'raw': row['details']}
            
            task = Task(
                id=row['id'],
                project_id=row['project_id'],
                title=row['title'],
                description=row['description'],
                status=row['status'],
                priority=row['priority'],
                details=details,
                created_at=row['created_at'],
                updated_at=row['updated_at'],
                start_time=row['start_time'],
                end_time=row['end_time'],
                result_summary=row['result_summary'],
                depends_on=row['depends_on'],
                requires_audit=row['requires_audit'],
                audit_status=row['audit_status']
            )
            tasks.append(task)
        
        return tasks
    
    def update_task_status(self, task_id: int, status: str, 
                          result_summary: Optional[str] = None,
                          slurm_job_id: Optional[int] = None,
                          slurm_output_file: Optional[str] = None,
                          error_message: Optional[str] = None):
        """更新任务状态"""
        conn = self._get_connection()
        c = conn.cursor()
        
        updates = [
            "status = ?",
            "updated_at = datetime('now')"
        ]
        values = [status]
        
        if result_summary:
            updates.append("result_summary = ?")
            values.append(result_summary)
        
        if slurm_job_id is not None:
            # 需要确保字段存在，如果不存在则忽略
            try:
                c.execute("ALTER TABLE tasks ADD COLUMN slurm_job_id INTEGER")
                conn.commit()
            except sqlite3.OperationalError:
                pass  # 字段已存在
            
            # 更新 slurm_job_id（使用直接 SQL）
            c.execute("UPDATE tasks SET slurm_job_id = ? WHERE id = ?", 
                     (slurm_job_id, task_id))
            conn.commit()
        
        if slurm_output_file is not None:
            try:
                c.execute("ALTER TABLE tasks ADD COLUMN slurm_output_file TEXT")
                conn.commit()
            except sqlite3.OperationalError:
                pass
            
            c.execute("UPDATE tasks SET slurm_output_file = ? WHERE id = ?",
                     (slurm_output_file, task_id))
            conn.commit()
        
        if error_message:
            # 记录错误到 details
            c.execute("SELECT details FROM tasks WHERE id = ?", (task_id,))
            row = c.fetchone()
            details = {}
            if row and row['details']:
                try:
                    details = json.loads(row['details'])
                except (json.JSONDecodeError, TypeError):
                    pass
            
            details['last_error'] = error_message
            details['last_error_time'] = datetime.now().isoformat()
            updates.append("details = ?")
            values.append(json.dumps(details, ensure_ascii=False))
        
        if status in ['in_progress', 'submitted', 'running']:
            updates.append("start_time = datetime('now')")
        elif status in ['completed', 'failed', 'cancelled']:
            updates.append("end_time = datetime('now')")
        
        values.append(task_id)
        
        sql = f"UPDATE tasks SET {', '.join(updates)} WHERE id = ?"
        c.execute(sql, values)
        conn.commit()
        
        logger.info(f"任务 {task_id} 状态更新为: {status}")
    
    def get_task_by_id(self, task_id: int) -> Optional[Task]:
        """根据 ID 获取任务"""
        conn = self._get_connection()
        c = conn.cursor()
        
        c.execute('''
            SELECT id, project_id, title, description, status, priority,
                   details, created_at, updated_at, start_time, end_time,
                   result_summary, depends_on, requires_audit, audit_status
            FROM tasks
            WHERE id = ?
        ''', (task_id,))
        
        row = c.fetchone()
        if not row:
            return None
        
        details = None
        if row['details']:
            try:
                details = json.loads(row['details'])
            except (json.JSONDecodeError, TypeError):
                details = {'raw': row['details']}
        
        return Task(
            id=row['id'],
            project_id=row['project_id'],
            title=row['title'],
            description=row['description'],
            status=row['status'],
            priority=row['priority'],
            details=details,
            created_at=row['created_at'],
            updated_at=row['updated_at'],
            start_time=row['start_time'],
            end_time=row['end_time'],
            result_summary=row['result_summary'],
            depends_on=row['depends_on'],
            requires_audit=row['requires_audit'],
            audit_status=row['audit_status']
        )
    
    def get_stuck_tasks(self, timeout_hours: int = TASK_TIMEOUT_HOURS) -> List[int]:
        """获取卡住的任务（超时未更新）"""
        conn = self._get_connection()
        c = conn.cursor()
        
        cutoff_time = datetime.now() - timedelta(hours=timeout_hours)
        
        c.execute('''
            SELECT id FROM tasks
            WHERE status IN ('in_progress', 'submitted', 'running')
              AND updated_at < ?
        ''', (cutoff_time.isoformat(),))
        
        return [row['id'] for row in c.fetchall()]
    
    def add_retry_count(self, task_id: int) -> int:
        """增加重试次数并返回新值"""
        conn = self._get_connection()
        c = conn.cursor()
        
        # 确保字段存在
        try:
            c.execute("ALTER TABLE tasks ADD COLUMN retry_count INTEGER DEFAULT 0")
            conn.commit()
        except sqlite3.OperationalError:
            pass
        
        # 获取当前重试次数
        c.execute("SELECT retry_count FROM tasks WHERE id = ?", (task_id,))
        row = c.fetchone()
        current_count = row['retry_count'] if row and row['retry_count'] else 0
        new_count = current_count + 1
        
        c.execute("UPDATE tasks SET retry_count = ? WHERE id = ?", (new_count, task_id))
        conn.commit()
        
        return new_count


# ==================== SLURM 作业管理 ====================

class SlurmManager:
    """SLURM 作业管理器"""
    
    def __init__(self, config: Dict[str, Any] = None):
        self.config = config or SLURM_CONFIG
        self.output_dir = self.config['output_dir']
    
    def submit_job(self, task: Task, script_content: str) -> Tuple[Optional[int], str]:
        """
        提交 SLURM 作业
        
        Returns:
            (job_id, error_message)
        """
        # 生成作业脚本文件
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        script_file = os.path.join(self.output_dir, f"task_{task.id}_{timestamp}.sh")
        
        # 创建 SLURM 脚本
        slurm_script = f"""#!/bin/bash
#SBATCH --partition={self.config['partition']}
#SBATCH --time={self.config['time']}
#SBATCH --nodes={self.config['nodes']}
#SBATCH --ntasks={self.config['ntasks']}
#SBATCH --cpus-per-task={self.config['cpus_per_task']}
#SBATCH --mem={self.config['mem']}
#SBATCH --job-name=task_{task.id}
#SBATCH --output={self.output_dir}/task_{task.id}_%j.out
#SBATCH --error={self.output_dir}/task_{task.id}_%j.err

# 任务信息
echo "任务 ID: {task.id}"
echo "任务标题：{task.title}"
echo "开始时间: $(date)"

# 执行计算脚本
{script_content}

# 检查执行结果
if [ $? -eq 0 ]; then
    echo "任务执行成功"
    exit 0
else
    echo "任务执行失败"
    exit 1
fi
"""
        
        try:
            # 写入脚本文件
            with open(script_file, 'w', encoding='utf-8') as f:
                f.write(slurm_script)
            
            # 设置执行权限
            os.chmod(script_file, 0o755)
            
            # 提交作业
            result = subprocess.run(
                ['sbatch', script_file],
                capture_output=True,
                text=True,
                timeout=30
            )
            
            if result.returncode == 0:
                # 解析作业 ID
                output = result.stdout.strip()
                match = re.search(r'Submitted batch job (\d+)', output)
                if match:
                    job_id = int(match.group(1))
                    output_file = os.path.join(self.output_dir, f"task_{task.id}_{job_id}.out")
                    logger.info(f"任务 {task.id} 提交成功，作业 ID: {job_id}")
                    return job_id, ""
                else:
                    logger.error(f"无法解析作业 ID: {output}")
                    return None, f"无法解析作业 ID: {output}"
            else:
                error_msg = f"SLURM 提交失败：{result.stderr}"
                logger.error(error_msg)
                return None, error_msg
                
        except subprocess.TimeoutExpired:
            error_msg = "SLURM 提交超时"
            logger.error(error_msg)
            return None, error_msg
        except FileNotFoundError:
            error_msg = "sbatch 命令未找到，请确保 SLURM 已安装"
            logger.error(error_msg)
            return None, error_msg
        except Exception as e:
            error_msg = f"SLURM 提交异常：{str(e)}"
            logger.error(error_msg)
            return None, error_msg
    
    def get_job_status(self, job_id: int) -> str:
        """获取作业状态"""
        try:
            result = subprocess.run(
                ['squeue', '-j', str(job_id), '-o', '%T', '-h'],
                capture_output=True,
                text=True,
                timeout=10
            )
            
            if result.returncode == 0:
                status = result.stdout.strip()
                if status:
                    return status
                else:
                    # 作业不在队列中，可能已完成或失败
                    return "COMPLETED"
            else:
                return "UNKNOWN"
                
        except Exception as e:
            logger.error(f"获取作业 {job_id} 状态失败：{e}")
            return "UNKNOWN"
    
    def cancel_job(self, job_id: int) -> bool:
        """取消作业"""
        try:
            result = subprocess.run(
                ['scancel', str(job_id)],
                capture_output=True,
                text=True,
                timeout=10
            )
            
            if result.returncode == 0:
                logger.info(f"作业 {job_id} 已取消")
                return True
            else:
                logger.error(f"取消作业 {job_id} 失败：{result.stderr}")
                return False
                
        except Exception as e:
            logger.error(f"取消作业 {job_id} 异常：{e}")
            return False
    
    def get_job_output(self, task_id: int, job_id: int) -> Optional[str]:
        """获取作业输出"""
        # 尝试查找输出文件
        output_pattern = os.path.join(self.output_dir, f"task_{task_id}_{job_id}.out")
        
        if os.path.exists(output_pattern):
            with open(output_pattern, 'r', encoding='utf-8', errors='ignore') as f:
                return f.read()
        
        # 尝试通配符匹配
        import glob
        output_files = glob.glob(os.path.join(self.output_dir, f"task_{task_id}_*.out"))
        if output_files:
            with open(output_files[-1], 'r', encoding='utf-8', errors='ignore') as f:
                return f.read()
        
        return None
    
    def parse_job_result(self, output: str) -> Dict[str, Any]:
        """解析作业输出，提取结果"""
        result = {
            'success': False,
            'summary': '',
            'metrics': {}
        }
        
        if not output:
            result['summary'] = '无输出'
            return result
        
        # 检查成功标记
        if '任务执行成功' in output or 'Completed successfully' in output:
            result['success'] = True
        
        # 提取能量信息（如果是计算任务）
        energy_match = re.search(r'Total energy:\s*([-\d.]+)', output, re.IGNORECASE)
        if energy_match:
            result['metrics']['total_energy'] = float(energy_match.group(1))
        
        # 提取执行时间
        time_match = re.search(r'执行时间：\s*([\d.]+)\s*秒', output)
        if time_match:
            result['metrics']['execution_time'] = float(time_match.group(1))
        
        # 提取摘要
        summary_match = re.search(r'摘要：(.+?)(?:\n|$)', output)
        if summary_match:
            result['summary'] = summary_match.group(1).strip()
        else:
            # 使用最后几行作为摘要
            lines = output.strip().split('\n')
            result['summary'] = '\n'.join(lines[-5:])
        
        return result


# ==================== 任务执行器 ====================

class TaskExecutor:
    """任务执行器"""
    
    def __init__(self, db: TaskDatabase, slurm: SlurmManager):
        self.db = db
        self.slurm = slurm
        self.max_retries = 3
    
    def generate_script(self, task: Task) -> str:
        """根据任务详情生成执行脚本"""
        if not task.details:
            # 默认脚本
            return """
echo "执行默认任务脚本"
echo "任务标题：$TASK_TITLE"
sleep 5
echo "任务执行成功"
"""
        
        # 根据任务类型生成脚本
        task_type = task.details.get('type', 'default')
        
        if task_type == 'psi4_calculation':
            return self._generate_psi4_script(task)
        elif task_type == 'data_processing':
            return self._generate_data_script(task)
        elif task_type == 'custom_script':
            return task.details.get('script', '')
        else:
            return self._generate_default_script(task)
    
    def _generate_psi4_script(self, task: Task) -> str:
        """生成 PSI4 计算脚本"""
        config = task.details.get('config', {})
        method = config.get('method', 'B3LYP')
        basis = config.get('basis', '6-31G(d)')
        geometry = task.details.get('geometry', '')
        
        return f"""
# PSI4 计算脚本
echo "开始 PSI4 计算"
echo "方法：{method}"
echo "基组：{basis}"

# 创建输入文件
cat > input.dat << EOF
memory 4 GB
molecule {{
{geometry}
}}

set {{
basis {basis}
scf_type df
}}

energy('{method}')
EOF

# 运行 PSI4
psi4 input.dat output.dat

# 检查结果
if [ $? -eq 0 ]; then
    echo "PSI4 计算成功"
    grep -i "Total energy" output.dat || echo "能量：计算完成"
else
    echo "PSI4 计算失败"
    exit 1
fi
"""
    
    def _generate_data_script(self, task: Task) -> str:
        """生成数据处理脚本"""
        script_path = task.details.get('script_path', '')
        input_file = task.details.get('input_file', '')
        output_file = task.details.get('output_file', 'output.json')
        
        return f"""
# 数据处理脚本
echo "开始数据处理"
echo "输入：{input_file}"
echo "输出：{output_file}"

python3 {script_path} {input_file} {output_file}

if [ $? -eq 0 ]; then
    echo "数据处理成功"
else
    echo "数据处理失败"
    exit 1
fi
"""
    
    def _generate_default_script(self, task: Task) -> str:
        """生成默认脚本"""
        return f"""
# 默认任务脚本
echo "执行任务：{task.title}"
echo "描述：{task.description}"
echo "优先级：{task.priority}"

# 模拟执行
sleep 10

echo "任务执行成功"
"""
    
    def execute_task(self, task: Task) -> bool:
        """执行单个任务"""
        logger.info(f"开始执行任务 {task.id}: {task.title}")
        
        try:
            # 1. 更新状态为进行中
            self.db.update_task_status(task.id, TaskStatus.IN_PROGRESS.value)
            
            # 2. 生成执行脚本
            script_content = self.generate_script(task)
            
            # 3. 提交 SLURM 作业
            job_id, error_msg = self.slurm.submit_job(task, script_content)
            
            if job_id:
                # 提交成功
                output_file = os.path.join(self.slurm.output_dir, f"task_{task.id}_{job_id}.out")
                self.db.update_task_status(
                    task.id, 
                    TaskStatus.SUBMITTED.value,
                    slurm_job_id=job_id,
                    slurm_output_file=output_file
                )
                logger.info(f"任务 {task.id} 已提交，作业 ID: {job_id}")
                return True
            else:
                # 提交失败，重试逻辑
                retry_count = self.db.add_retry_count(task.id)
                if retry_count < self.max_retries:
                    logger.warning(f"任务 {task.id} 提交失败，第 {retry_count} 次重试")
                    self.db.update_task_status(
                        task.id, 
                        TaskStatus.RETRYING.value,
                        error_message=error_msg
                    )
                    time.sleep(60 * retry_count)  # 指数退避
                    return self.execute_task(task)
                else:
                    logger.error(f"任务 {task.id} 提交失败，已达最大重试次数")
                    self.db.update_task_status(
                        task.id, 
                        TaskStatus.FAILED.value,
                        error_message=f"SLURM 提交失败：{error_msg}"
                    )
                    return False
                    
        except Exception as e:
            logger.error(f"执行任务 {task.id} 异常：{e}")
            logger.error(traceback.format_exc())
            self.db.update_task_status(
                task.id, 
                TaskStatus.FAILED.value,
                error_message=f"执行异常：{str(e)}"
            )
            return False


# ==================== 状态监控器 ====================

class StatusMonitor:
    """作业状态监控器"""
    
    def __init__(self, db: TaskDatabase, slurm: SlurmManager):
        self.db = db
        self.slurm = slurm
        self.executor = TaskExecutor(db, slurm)
    
    def check_submitted_tasks(self):
        """检查已提交的任务状态"""
        conn = self.db._get_connection()
        c = conn.cursor()
        
        # 检查 slurm_job_id 字段是否存在
        c.execute("PRAGMA table_info(tasks)")
        columns = [col[1] for col in c.fetchall()]
        
        if 'slurm_job_id' not in columns:
            # 字段不存在，添加
            try:
                c.execute("ALTER TABLE tasks ADD COLUMN slurm_job_id INTEGER")
                conn.commit()
                logger.info("已添加 slurm_job_id 字段")
            except sqlite3.OperationalError as e:
                logger.warning(f"无法添加 slurm_job_id 字段：{e}")
                return  # 跳过本次检查
        
        # 获取所有已提交或运行中的任务
        c.execute('''
            SELECT id, slurm_job_id FROM tasks
            WHERE status IN ('submitted', 'running')
        ''')
        
        for row in c.fetchall():
            task_id = row['id']
            job_id = row['slurm_job_id']
            
            if not job_id:
                continue
            
            # 获取 SLURM 作业状态
            slurm_status = self.slurm.get_job_status(job_id)
            
            # 映射状态
            if slurm_status in ['PENDING', 'CONFIGURING']:
                new_status = TaskStatus.SUBMITTED.value
            elif slurm_status in ['RUNNING', 'COMPLETING']:
                new_status = TaskStatus.RUNNING.value
            elif slurm_status in ['COMPLETED']:
                # 作业完成，读取结果
                new_status = TaskStatus.COMPLETED.value
                self._process_completed_task(task_id, job_id)
            elif slurm_status in ['FAILED', 'CANCELLED', 'TIMEOUT', 'OUT_OF_MEMORY']:
                new_status = TaskStatus.FAILED.value
                self._process_failed_task(task_id, job_id, slurm_status)
            else:
                # 未知状态，可能是已完成
                new_status = TaskStatus.COMPLETED.value
                self._process_completed_task(task_id, job_id)
            
            # 更新数据库
            if new_status != row.get('current_status'):
                self.db.update_task_status(task_id, new_status)
    
    def _process_completed_task(self, task_id: int, job_id: int):
        """处理完成的任务"""
        logger.info(f"处理完成的任务 {task_id}")
        
        # 读取输出
        output = self.slurm.get_job_output(task_id, job_id)
        
        # 解析结果
        result = self.slurm.parse_job_result(output) if output else {'success': True, 'summary': '完成'}
        
        # 更新数据库
        self.db.update_task_status(
            task_id,
            TaskStatus.COMPLETED.value,
            result_summary=result.get('summary', '任务完成')
        )
        
        logger.info(f"任务 {task_id} 处理完成：{result.get('summary', '')[:100]}")
    
    def _process_failed_task(self, task_id: int, job_id: int, failure_reason: str):
        """处理失败的任务"""
        logger.warning(f"处理失败的任务 {task_id}: {failure_reason}")
        
        # 读取错误输出
        error_file = os.path.join(self.slurm.output_dir, f"task_{task_id}_{job_id}.err")
        error_message = failure_reason
        
        if os.path.exists(error_file):
            with open(error_file, 'r', encoding='utf-8', errors='ignore') as f:
                error_message = f.read()[-1000:]  # 最后 1000 字符
        
        # 重试逻辑
        retry_count = self.db.add_retry_count(task_id)
        if retry_count < 3:
            logger.info(f"任务 {task_id} 失败，准备重试（第 {retry_count} 次）")
            self.db.update_task_status(
                task_id,
                TaskStatus.RETRYING.value,
                error_message=error_message
            )
            
            # 重新提交
            task = self.db.get_task_by_id(task_id)
            if task:
                time.sleep(60 * retry_count)
                self.executor.execute_task(task)
        else:
            logger.error(f"任务 {task_id} 失败，已达最大重试次数")
            self.db.update_task_status(
                task_id,
                TaskStatus.FAILED.value,
                error_message=f"作业失败：{failure_reason}. {error_message}"
            )
    
    def check_stuck_tasks(self):
        """检查卡住的任务"""
        # 检查 slurm_job_id 字段是否存在
        conn = self.db._get_connection()
        c = conn.cursor()
        c.execute("PRAGMA table_info(tasks)")
        columns = [col[1] for col in c.fetchall()]
        
        if 'slurm_job_id' not in columns:
            return  # 字段不存在，跳过检查
        
        stuck_ids = self.db.get_stuck_tasks()
        
        for task_id in stuck_ids:
            logger.warning(f"检测到卡住的任务 {task_id}")
            
            task = self.db.get_task_by_id(task_id)
            if task and task.slurm_job_id:
                # 检查 SLURM 作业
                status = self.slurm.get_job_status(task.slurm_job_id)
                if status == "UNKNOWN":
                    # 作业不存在，标记为失败
                    self.db.update_task_status(
                        task_id,
                        TaskStatus.FAILED.value,
                        error_message="任务超时且 SLURM 作业不存在"
                    )


# ==================== 心跳机制 ====================

class HeartbeatManager:
    """心跳管理器"""
    
    def __init__(self, interval: int = HEARTBEAT_INTERVAL_SECONDS):
        self.interval = interval
        self.last_beat = datetime.now()
        self.running = False
        self.thread = None
    
    def start(self):
        """启动心跳线程"""
        self.running = True
        self.thread = threading.Thread(target=self._heartbeat_loop, daemon=True)
        self.thread.start()
        logger.info("心跳线程已启动")
    
    def stop(self):
        """停止心跳线程"""
        self.running = False
        if self.thread:
            self.thread.join(timeout=5)
        logger.info("心跳线程已停止")
    
    def _heartbeat_loop(self):
        """心跳循环"""
        while self.running:
            self.beat()
            time.sleep(self.interval)
    
    def beat(self):
        """发送心跳"""
        self.last_beat = datetime.now()
        logger.debug(f"❤️ 心跳 - {self.last_beat.strftime('%Y-%m-%d %H:%M:%S')}")
    
    def is_alive(self) -> bool:
        """检查心跳是否正常"""
        return (datetime.now() - self.last_beat).total_seconds() < self.interval * 2


# ==================== 主服务 ====================

class TaskWorkerService:
    """任务轮询服务主类"""
    
    def __init__(self):
        self.db = TaskDatabase()
        self.slurm = SlurmManager()
        self.executor = TaskExecutor(self.db, self.slurm)
        self.monitor = StatusMonitor(self.db, self.slurm)
        self.heartbeat = HeartbeatManager()
        
        self.running = False
        self.executor_pool = None
    
    def start(self):
        """启动服务"""
        logger.info("=" * 60)
        logger.info("T109 MacMini 任务轮询服务启动")
        logger.info(f"数据库：{DB_PATH}")
        logger.info(f"SLURM 输出目录：{self.slurm.output_dir}")
        logger.info(f"轮询间隔：{POLL_INTERVAL_SECONDS}秒")
        logger.info(f"最大并行任务：{MAX_CONCURRENT_TASKS}")
        logger.info("=" * 60)
        
        # 启动心跳
        self.heartbeat.start()
        
        # 创建线程池
        self.executor_pool = ThreadPoolExecutor(max_workers=MAX_CONCURRENT_TASKS)
        
        # 注册信号处理
        signal.signal(signal.SIGINT, self._signal_handler)
        signal.signal(signal.SIGTERM, self._signal_handler)
        
        self.running = True
        
        # 主循环
        try:
            while self.running:
                # 1. 检查并更新已提交任务的状态
                self.monitor.check_submitted_tasks()
                
                # 2. 检查卡住的任务
                self.monitor.check_stuck_tasks()
                
                # 3. 获取待处理任务
                pending_tasks = self.db.get_pending_tasks(limit=MAX_CONCURRENT_TASKS)
                
                if pending_tasks:
                    logger.info(f"发现 {len(pending_tasks)} 个待处理任务")
                    
                    # 4. 并行执行任务
                    futures = []
                    for task in pending_tasks:
                        future = self.executor_pool.submit(self.executor.execute_task, task)
                        futures.append(future)
                    
                    # 等待所有任务提交
                    for future in as_completed(futures):
                        try:
                            result = future.result(timeout=300)
                            if not result:
                                logger.warning("有任务执行失败")
                        except Exception as e:
                            logger.error(f"任务执行异常：{e}")
                else:
                    logger.debug("暂无待处理任务")
                
                # 5. 等待下一次轮询
                time.sleep(POLL_INTERVAL_SECONDS)
                
        except Exception as e:
            logger.error(f"服务异常：{e}")
            logger.error(traceback.format_exc())
        finally:
            self.stop()
    
    def stop(self):
        """停止服务"""
        logger.info("正在停止服务...")
        self.running = False
        
        # 停止心跳
        self.heartbeat.stop()
        
        # 关闭线程池
        if self.executor_pool:
            self.executor_pool.shutdown(wait=True)
        
        logger.info("服务已停止")
    
    def _signal_handler(self, signum, frame):
        """信号处理"""
        logger.info(f"收到信号 {signum}，准备退出")
        self.stop()
        sys.exit(0)


# ==================== 命令行接口 ====================

def main():
    """主函数"""
    import argparse
    
    parser = argparse.ArgumentParser(description='T109 MacMini 任务轮询服务')
    parser.add_argument('--start', action='store_true', help='启动服务')
    parser.add_argument('--status', action='store_true', help='查看服务状态')
    parser.add_argument('--test', action='store_true', help='运行测试')
    parser.add_argument('--once', action='store_true', help='只执行一轮（不循环）')
    
    args = parser.parse_args()
    
    if args.start:
        service = TaskWorkerService()
        service.start()
    
    elif args.status:
        # 检查服务状态
        print("服务状态检查:")
        print(f"数据库：{'存在' if os.path.exists(DB_PATH) else '不存在'}")
        print(f"SLURM 输出目录：{'存在' if os.path.exists(SLURM_CONFIG['output_dir']) else '不存在'}")
        
        # 检查 SLURM
        try:
            result = subprocess.run(['squeue', '--version'], capture_output=True, text=True, timeout=5)
            print(f"SLURM: 已安装 ({result.stdout.strip()})")
        except:
            print("SLURM: 未安装或不可用")
        
        # 统计任务
        if os.path.exists(DB_PATH):
            db = TaskDatabase()
            todo = len(db.get_pending_tasks(limit=1000))
            print(f"\n任务统计:")
            print(f"待处理：{todo}")
    
    elif args.test:
        # 运行测试
        print("运行测试...")
        db = TaskDatabase()
        slurm = SlurmManager()
        
        # 测试数据库连接
        try:
            tasks = db.get_pending_tasks(limit=1)
            print("✅ 数据库连接正常")
        except Exception as e:
            print(f"❌ 数据库连接失败：{e}")
            return 1
        
        # 测试 SLURM
        try:
            result = subprocess.run(['squeue', '-h'], capture_output=True, text=True, timeout=5)
            print("✅ SLURM 可用")
        except:
            print("⚠️  SLURM 不可用，将使用模拟模式")
        
        print("\n测试完成")
    
    elif args.once:
        # 执行一轮
        print("执行单轮任务处理...")
        service = TaskWorkerService()
        
        # 检查状态
        service.monitor.check_submitted_tasks()
        service.monitor.check_stuck_tasks()
        
        # 获取并执行任务
        pending_tasks = service.db.get_pending_tasks(limit=MAX_CONCURRENT_TASKS)
        if pending_tasks:
            print(f"发现 {len(pending_tasks)} 个待处理任务")
            for task in pending_tasks:
                result = service.executor.execute_task(task)
                print(f"任务 {task.id}: {'成功' if result else '失败'}")
        else:
            print("暂无待处理任务")
    
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
