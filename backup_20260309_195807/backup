#!/bin/bash
# backup - 看板快速备份（本地+GitHub）

if [ $# -lt 2 ]; then
    echo "用法: $0 <版本号> <更新原因>"
    echo "例如: $0 v2.4.8 '修复API错误'"
    echo ""
    echo "这将同时执行:"
    echo "  1. 本地备份（数据库+后端+前端+配置）"
    echo "  2. GitHub推送（代码+标签）"
    exit 1
fi

cd /opt/kanban-react/backend
./backup_with_github.sh "$1" "$2"
