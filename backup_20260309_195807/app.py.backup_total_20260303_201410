        c = conn.cursor()
        
        c.execute('SELECT DISTINCT folder FROM emails ORDER BY folder')
        folders = [row[0] for row in c.fetchall()]
        
        if not folders:
            folders = ['inbox', 'sent', 'drafts', 'trash']
        
        conn.close()
        
        return jsonify({'success': True, 'folders': folders})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

@app.route('/api/emails/import', methods=['POST'])
def import_emails():
    """导入邮件"""
    try:
        data = request.get_json()
        emails = data.get('emails', [])
        
        conn = get_db()
        c = conn.cursor()
        
        imported_count = 0
        for email in emails:
            c.execute('INSERT OR IGNORE INTO emails (message_id, subject, sender, recipient, body, folder, received_at, sync_status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
                (email.get('message_id'), email.get('subject'), email.get('sender'), email.get('recipient'), email.get('body'), email.get('folder', 'inbox'), email.get('received_at'), 'synced'))
            if c.rowcount > 0:
                imported_count += 1
        
        conn.commit()
        conn.close()
        
        return jsonify({'success': True, 'imported': imported_count, 'total': len(emails)})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

