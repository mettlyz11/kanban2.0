""".strip()
    
    def enqueue_task(self, task: Dict) -> bool:
        """将任务加入执行队列"""
        try:
            queue_entry = {
                'task_id': task['id'],
                'task_title': task.get('title', ''),
                'priority': task.get('priority', 2),
                'enqueued_at': datetime.now().isoformat(),
                'prompt': self.build_subagent_command(task)
            }
            
            with open(self.queue_file, 'a') as f:
                f.write(json.dumps(queue_entry, ensure_ascii=False) + '\n')
            
            logger.info(f"✅ 任务 #{task['id']} 已加入队列")
            return True
        except Exception as e:
            logger.error(f"加入队列失败: {e}")
            return False
    
    def dispatch_tasks(self) -> int:
        """调度待执行任务 - SDS进程内直接启动子代理，不依赖外部HEARTBEAT"""
        logger.info("开始任务调度...")
        
        # 确保数据库连接
        if not self.conn:
            if not self.connect():
                logger.error("无法连接数据库，跳过调度")
                return 0
        
        if not self.has_available_slot():
            logger.info("无可用槽位，跳过调度")
            return 0
        
        # ✅ 优化调度逻辑：批量获取足够多的pending任务，保证能填满所有并发槽位
        # 即使有些任务状态异常被跳过，也有足够多的备用任务可以调度
        pending_tasks = self.get_pending_tasks(limit=4)  # 每周期获取4个任务
        logger.info(f"发现 {len(pending_tasks)} 个待执行任务，可用槽位: {self.max_concurrent}")
        
        dispatched = 0
        for task in pending_tasks:
            if not self.has_available_slot():
                logger.info(f"   已达到并发上限 {self.max_concurrent}，停止调度")
                break
            
            # ✅ 架构优化：SDS进程内直接启动子代理，不依赖HEARTBEAT
            # 完全实现自我驱动闭环，不依赖外部会话
            if self.start_subagent_directly(task):
                dispatched += 1
                logger.info(f"   ✅ 任务 #{task['id']} 子代理已后台启动执行")
            else:
                logger.info(f"   ⏭️  任务 #{task['id']} 跳过，尝试下一个")
            
            # 调度间隔，避免DB过载
            time.sleep(1)
        
        logger.info(f"本次调度 {dispatched} 个任务")
        return dispatched
    
    def start_subagent_directly(self, task: Dict) -> bool:
        """🚀 启动真实子代理执行脚本（直接启动，不依赖HEARTBEAT）
        
        架构说明：
        1. 先抢占式标记任务为 in_progress
        2. 生成完整的Python执行脚本（包含真实执行逻辑）
        3. 后台启动脚本，独立运行
        4. 脚本执行完成后自动更新数据库状态
        """
        try:
            task_id = task['id']
            task_title = task.get('title', '')
            
            # ✅ 状态一致性保障：先标记为in_progress，再启动子代理
            sql = "UPDATE tasks SET status = 'in_progress', updated_at = NOW() WHERE id = %s AND status IN ('pending', 'failed_retryable')"
            rows_affected = execute_update(sql, (task_id,))
            
            if rows_affected == 0:
                logger.warning(f"任务 #{task_id} 状态不是pending/failed_retryable，跳过启动")
                return False
            
            # 🎯 生成真实的子代理执行脚本
            script_content = self._generate_subagent_script(task_id, task_title)
            
            script_path = Path(f"/tmp/sds-subagent-{task_id}-{int(time.time())}.py")
            with open(script_path, 'w', encoding='utf-8') as f:
                f.write(script_content)
            
            # 🚀 后台启动执行（完全独立进程）
            subprocess.Popen(
                [sys.executable, str(script_path)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                cwd="/Users/mettlyz/.openclaw/workspace"
            )
            
            logger.info(f"🚀 真实子代理已启动 #{task_id}: {task_title[:50]}")
            logger.info(f"   📍 脚本路径: {script_path}")
            return True
            
        except Exception as e:
            logger.error(f"启动子代理失败 #{task_id}: {e}")
            try:
                sql_rollback = "UPDATE tasks SET status = 'pending', updated_at = NOW() WHERE id = %s"
                execute_update(sql_rollback, (task['id'],))
            except:
                pass
            return False
    
    def _generate_subagent_script(self, task_id: int, task_title: str) -> str:
        """生成真实执行的子代理脚本（从标准模板读取）"""
        import json
        from pathlib import Path
        
        # 读取标准模板
        template_path = Path(get_config('paths.templates') + "/subagent_executor.py")
        with open(template_path, 'r', encoding='utf-8') as f:
            template = f.read()
        
        # 替换占位符
        def escape_for_python(s: str) -> str:
            return json.dumps(s, ensure_ascii=False)
        
        script = template\
            .replace('{{task_id}}', str(task_id))\
            .replace('{{task_title_json}}', escape_for_python(task_title))\
            .replace('{{task_description_json}}', escape_for_python(f"执行任务：{task_title}"))
        
        return script
    
    def _build_subagent_task_description(self, task_id: int, task_title: str) -> str:
        """🧠 构建真实AI子代理的任务描述（标准模板）
        
        这是给真实AI执行的完整任务指令，包含：
        - 清晰的任务目标
        - 详细的执行步骤
        - 强制的输出要求
        - 必须执行的数据库更新SQL
        """
        from pathlib import Path
        
        # 读取标准任务模板
        template_path = Path(get_config('paths.templates') + "/subagent-task-template.md")
        with open(template_path, 'r', encoding='utf-8') as f:
            template = f.read()
        
        # 构建任务描述
        task_description = f"""【看板任务 #{task_id} - {task_title}】

## 任务目标
{self._extract_task_goal(task_title)}

## 执行步骤
1. 分析任务目标，明确需要交付的核心成果
2. 收集相关的历史上下文和最佳实践参考
3. 执行核心业务逻辑，完成所有预定操作
4. 生成执行报告和优化方案，保存到 output/task-{task_id}/ 目录
5. 验证所有产出文件的完整性和数据准确性
6. 执行下面的【任务完成强制动作】更新数据库

## 输出要求
- 生成文件：output/task-{task_id}/执行报告_{task_id}.md
- 生成文件：output/task-{task_id}/优化方案_{task_id}.md
- 数据库更新：status, task_summary, execution_log, result_summary
- 附件上传：将生成的文件记录到 attachments 表，URL 格式必须是 `/uploads/docs/文件名`

