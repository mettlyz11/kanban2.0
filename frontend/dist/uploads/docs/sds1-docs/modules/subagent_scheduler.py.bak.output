        return task_description
    
    def _extract_task_goal(self, task_title: str) -> str:
        """从任务标题提取任务目标"""
        # 根据标题模式智能提取目标
        if "优化" in task_title:
            return "识别当前存在的问题，制定具体优化方案，并输出可落地的行动计划"
        elif "研究" in task_title or "调研" in task_title:
            return "深入研究相关领域，收集整理最新信息，形成有价值的调研报告"
        elif "监控" in task_title or "健康检查" in task_title:
            return "全面检查系统健康状态，识别潜在风险，提出改进措施"
        elif "加速" in task_title or "推进" in task_title:
            return "分析当前进度瓶颈，制定加速方案，推动项目快速前进"
        else:
            return "高质量完成任务目标，生成详细的执行报告和优化方案"


class ResultCollector:
    """结果回收器 - 验证并回收任务执行结果"""
    
    def __init__(self):
        self.conn = None
        self.min_summary_length = 200
        self.min_log_length = 200
        
    def connect(self):
        """连接数据库"""
        try:
            self.conn = get_db_connection()
            return True
        except Exception as e:
            logger.error(f"数据库连接失败: {e}")
            return False
    
    def close(self):
        """关闭连接"""
        if self.conn:
            self.conn.close()
    
    def get_completed_tasks_to_verify(self) -> List[Dict]:
        """获取需要验证的已完成任务（只验证已完成超过2分钟的任务，避免子代理未完成就验证）"""
        sql = """
            SELECT id, number, title, status, task_type, task_summary,
                   execution_log, result_summary, updated_at, retry_count
            FROM tasks
            WHERE status = 'completed'
              AND (sds_verified IS NULL OR sds_verified = 0)
              AND updated_at <= DATE_SUB(NOW(), INTERVAL 2 MINUTE)
            ORDER BY updated_at DESC
            LIMIT 20
        """
        return execute_query(sql)
    
    def verify_task_completion(self, task: Dict) -> Tuple[bool, List[str]]:
        """验证任务完成质量"""
        issues = []
        
        # 1. 检查task_summary
        summary = task.get('task_summary') or ''
        if len(summary) < 30:
            issues.append(f"task_summary字数不足: {len(summary)} < 30")
        
        # 2. 检查execution_log
        log = task.get('execution_log') or ''
        if len(log) < 200:
            issues.append(f"execution_log字数不足: {len(log)} < 200 (必须写满200字详细执行过程)")
        
        # 3. 检查result_summary
        result = task.get('result_summary') or ''
        if len(result) < 100:
            issues.append(f"result_summary字数不足: {len(result)} < 100 (必须写满100字成果总结)")
        
        # 4. 检查附件
        sql = "SELECT COUNT(*) as count FROM attachments WHERE entity_type = 'task' AND entity_id = %s"
        results = execute_query(sql, (task['id'],))
        attachment_count = results[0]['count'] if results else 0
        
        # 自动生成的任务应该有产出
        if task.get('task_type') == 'auto_generated' and attachment_count == 0:
            issues.append("自动生成任务缺少附件产出")
        
        is_valid = len(issues) == 0
        return is_valid, issues
    
    def mark_task_verified(self, task_id: int, issues: List[str] = None) -> bool:
        """标记任务已验证"""
        try:
            if issues:
                verification_note = f"\n[SDS验证] 发现问题: {'; '.join(issues)}\n"
            else:
                verification_note = "\n[SDS验证] ✓ 验证通过，符合所有质量标准\n"
            
            execute_update("""
                UPDATE tasks
                SET sds_verified = 1,
                    execution_log = CONCAT(COALESCE(execution_log, ''), %s),
                    updated_at = NOW()
                WHERE id = %s
            """, (verification_note, task_id))
            return True
        except Exception as e:
            logger.error(f"标记验证状态失败: {e}", exc_info=True)
            return False
    
    def collect_and_verify(self) -> Dict:
        """收集并验证任务结果"""
        logger.info("开始结果收集与验证...")
        
        # 确保数据库连接
        if not self.conn:
            if not self.connect():
                logger.error("无法连接数据库，跳过验证")
                return {'verified': 0, 'failed': 0, 'issues_found': []}
        
        tasks = self.get_completed_tasks_to_verify()
        logger.info(f"发现 {len(tasks)} 个待验证任务")
        
        results = {
            'verified': 0,
            'failed': 0,
            'issues_found': []
        }
        
        for task in tasks:
            is_valid, issues = self.verify_task_completion(task)
            
            if is_valid:
                # 同步本地文件到远程服务器
                try:
                    from tools.kanban_task_manager import KanbanTaskManager
                    km = KanbanTaskManager()
                    if km.connect():
                        synced = km.sync_task_files_to_server(task['id'])
                        if synced:
                            logger.info(f"✓ 任务 #{task['id']} 已同步 {len(synced)} 个文件到服务器")
                        km.close()
                except Exception as sync_err:
                    logger.warning(f"⚠ 任务 #{task['id']} 文件同步失败: {sync_err}")
                
                if self.mark_task_verified(task['id']):
                    results['verified'] += 1
                    logger.info(f"✓ 任务 #{task['id']} 验证通过")
            else:
                results['failed'] += 1
                results['issues_found'].append({
                    'task_id': task['id'],
                    'issues': issues
                })
                logger.warning(f"✗ 任务 #{task['id']} 验证失败: {issues}")
                
                # 标记需要重试
                self.mark_for_retry(task['id'], issues)
        
        logger.info(f"验证完成: 通过 {results['verified']}, 失败 {results['failed']}")
        return results
    
    def mark_for_retry(self, task_id: int, issues: List[str]) -> bool:
        """标记任务需要重试"""
        try:
            retry_note = f"\n[SDS重试] 验证失败，需要重新执行: {'; '.join(issues)}\n"
            execute_update("""
                UPDATE tasks
                SET status = 'failed_retryable',
                    retry_count = COALESCE(retry_count, 0) + 1,
                    execution_log = CONCAT(COALESCE(execution_log, ''), %s),
                    updated_at = NOW()
                WHERE id = %s
            """, (retry_note, task_id))
            return True
        except Exception as e:
            logger.error(f"标记重试失败: {e}", exc_info=True)
            return False


def run_scheduler_cycle():
    """运行一次完整的调度周期"""
    logger.info("=" * 60)
    logger.info("SDS调度周期开始")
    logger.info("=" * 60)
    
    scheduler = SubagentScheduler()
    collector = ResultCollector()
    
    if not scheduler.connect() or not collector.connect():
        logger.error("数据库连接失败")
        return
    
    try:
        # 1. 调度新任务
        dispatched = scheduler.dispatch_tasks()
        
        # 2. 收集并验证结果
        verification = collector.collect_and_verify()
        
        # 3. 记录状态（旧状态文件已废弃，状态由 sds_main.py 统一管理）
        logger.info(f"周期完成: 调度={dispatched}, 验证通过={verification['verified']}, "
                   f"验证失败={verification['failed']}, 运行中={scheduler.get_running_tasks_count()}")
        
    except Exception as e:
        logger.error(f"调度周期执行异常: {e}", exc_info=True)
        return {'error': str(e)}
    finally:
        scheduler.close()
        collector.close()
        logger.info("=" * 60)


if __name__ == "__main__":
    run_scheduler_cycle()
