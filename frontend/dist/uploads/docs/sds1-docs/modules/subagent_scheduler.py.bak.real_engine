#!/usr/bin/env python3
"""
SDS子代理调度器与结果回收器 (Sub-agent Scheduler & Result Collector)
功能：智能调度子代理执行任务，回收并验证执行结果
"""

import os
import sys
import json
import time
import logging
import subprocess
from datetime import datetime, timedelta
from pathlib import Path
from typing import List, Dict, Optional, Tuple

# 添加lib路径
sys.path.insert(0, str(Path(__file__).parent.parent / "scripts"))
from lib.db_connector import get_db_connection, execute_query, execute_update

# 日志配置
logging.basicConfig(
    level=logging.INFO,
    format='[%(asctime)s] [%(levelname)s] %(message)s',
    handlers=[
        logging.FileHandler('/Users/mettlyz/.openclaw/workspace/logs/sds-subagent-scheduler.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('SubagentScheduler')


class SubagentScheduler:
    """子代理调度器 - 管理子代理的启动、监控和结果回收"""
    
    def __init__(self):
        self.conn = None
        self.max_concurrent = 20  # ✅ 大幅提高并发，从5→20，满足您的执行速度要求
        self.max_retries = 100  # ✅ 大幅提高重试上限，避免任务被过早过滤
        self.retry_interval = 60  # 秒
        
        # 运行中的子代理 {task_id: {session_info, start_time}}
        self.running_agents = {}
        
        # 队列文件路径（与 OpenClaw 自动任务守护进程一致）
        self.queue_file = Path("/Users/mettlyz/.openclaw/logs/pending-task-queue.jsonl")
        self.state_file = Path("/Users/mettlyz/.openclaw/workspace/logs/sds-scheduler-state.json")
        
    def connect(self):
        """连接数据库"""
        try:
            self.conn = get_db_connection()
            return True
        except Exception as e:
            logger.error(f"数据库连接失败: {e}")
            return False
    
    def close(self):
        """关闭连接"""
        if self.conn:
            self.conn.close()
    
    def get_pending_tasks(self, limit: int = 10) -> List[Dict]:
        """获取待执行任务"""
        sql = """
            SELECT id, number, title, status, priority, project_id,
                   retry_count, task_type
            FROM tasks
            WHERE status IN ('pending', 'failed_retryable')
              AND requires_audit = 0
              AND (retry_count IS NULL OR retry_count < %s)
            ORDER BY priority DESC, id ASC
            LIMIT %s
        """
        return execute_query(sql, (self.max_retries, limit))
    
    def get_running_tasks_count(self) -> int:
        """获取当前运行中的任务数"""
        sql = """
            SELECT COUNT(*) as count
            FROM tasks
            WHERE status = 'in_progress'
        """
        results = execute_query(sql)
        return results[0]['count'] if results else 0
    
    def has_available_slot(self) -> bool:
        """检查是否有可用槽位"""
        running = self.get_running_tasks_count()
        available = running < self.max_concurrent
        if not available:
            logger.info(f"槽位已满: {running}/{self.max_concurrent} 运行中")
        return available
    
    def mark_task_in_progress(self, task_id: int) -> bool:
        """标记任务为执行中"""
        try:
            cursor = self.conn.cursor()
            cursor.execute("""
                UPDATE tasks
                SET status = 'in_progress',
                    execution_log = CONCAT(COALESCE(execution_log, ''), %s),
                    updated_at = NOW()
                WHERE id = %s
            """, (
                f"\n[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] SDS调度器: 任务开始执行\n",
                task_id
            ))
            self.conn.commit()
            return True
        except Exception as e:
            logger.error(f"标记任务执行中失败: {e}")
            if self.conn:
                self.conn.rollback()
            return False
    
    def build_subagent_command(self, task: Dict) -> str:
        """构建子代理启动命令"""
        task_id = task['id']
        task_title = task.get('title', '未命名任务')
        
        # 读取任务模板
        template_path = Path("/Users/mettlyz/.openclaw/workspace/templates/auto-task-template.md")
        if template_path.exists():
            with open(template_path, 'r') as f:
                template = f.read()
        else:
            template = self.get_default_template()
        
        # 替换模板变量
        task_description = task.get('description', '')
        full_prompt = (
            f"# 看板任务 #{task_id}: {task_title}\n\n"
            f"## 任务描述\n{task_description}\n\n"
            f"## 执行规范\n{template}\n\n"
            "请按照上述规范完整执行任务。"
        )
        
        # 构建子代理命令（使用sessions_spawn机制）
        # 注意：实际通过OpenClaw的sessions_spawn API调用
        # 这里写入队列文件，由HEARTBEAT或主循环处理
        
        return full_prompt
    
    def get_default_template(self) -> str:
        """获取默认执行模板（核爆炸版）"""
        return """
