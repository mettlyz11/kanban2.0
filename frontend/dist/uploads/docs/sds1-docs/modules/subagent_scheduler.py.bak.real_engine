""".strip()
    
    def enqueue_task(self, task: Dict) -> bool:
        """将任务加入执行队列"""
        try:
            queue_entry = {
                'task_id': task['id'],
                'task_title': task.get('title', ''),
                'priority': task.get('priority', 2),
                'enqueued_at': datetime.now().isoformat(),
                'prompt': self.build_subagent_command(task)
            }
            
            with open(self.queue_file, 'a') as f:
                f.write(json.dumps(queue_entry, ensure_ascii=False) + '\n')
            
            logger.info(f"✅ 任务 #{task['id']} 已加入队列")
            return True
        except Exception as e:
            logger.error(f"加入队列失败: {e}")
            return False
    
    def dispatch_tasks(self) -> int:
        """调度待执行任务 - SDS进程内直接启动子代理，不依赖外部HEARTBEAT"""
        logger.info("开始任务调度...")
        
        # 确保数据库连接
        if not self.conn:
            if not self.connect():
                logger.error("无法连接数据库，跳过调度")
                return 0
        
        if not self.has_available_slot():
            logger.info("无可用槽位，跳过调度")
            return 0
        
        # ✅ 优化调度逻辑：批量获取足够多的pending任务，保证能填满所有并发槽位
        # 即使有些任务状态异常被跳过，也有足够多的备用任务可以调度
        pending_tasks = self.get_pending_tasks(limit=self.max_concurrent * 2)  # 多拿2倍，避免不够
        logger.info(f"发现 {len(pending_tasks)} 个待执行任务，可用槽位: {self.max_concurrent}")
        
        dispatched = 0
        for task in pending_tasks:
            if not self.has_available_slot():
                logger.info(f"   已达到并发上限 {self.max_concurrent}，停止调度")
                break
            
            # ✅ 架构优化：SDS进程内直接启动子代理，不依赖HEARTBEAT
            # 完全实现自我驱动闭环，不依赖外部会话
            if self.start_subagent_directly(task):
                dispatched += 1
                logger.info(f"   ✅ 任务 #{task['id']} 子代理已后台启动执行")
            else:
                logger.info(f"   ⏭️  任务 #{task['id']} 跳过，尝试下一个")
            
            # 调度间隔，避免DB过载
            time.sleep(1)
        
        logger.info(f"本次调度 {dispatched} 个任务")
        return dispatched
    
    def start_subagent_directly(self, task: Dict) -> bool:
        """直接在SDS进程内启动子代理后台执行（架构级修复：不依赖HEARTBEAT）"""
        try:
            task_id = task['id']
            task_title = task.get('title', '')
            
            # ✅ 状态一致性保障：先标记为in_progress，再启动子代理
            # 防止调度器重复调度同一个任务
            # 支持 pending 和 failed_retryable 两种状态
            sql = "UPDATE tasks SET status = 'in_progress', updated_at = NOW() WHERE id = %s AND status IN ('pending', 'failed_retryable')"
            rows_affected = execute_update(sql, (task_id,))
            
            if rows_affected == 0:
                logger.warning(f"任务 #{task_id} 状态不是pending/failed_retryable，跳过启动")
                return False
            
            # 使用字符串格式化生成独立脚本，避免f-string嵌套冲突
            script_content = self._generate_subagent_script(task_id, task_title)
            
            # 写入临时脚本文件
            script_path = Path(f"/tmp/sds-subagent-{task_id}-{int(time.time())}.py")
            with open(script_path, 'w') as f:
                f.write(script_content)
            
            # 后台启动执行（不阻塞SDS主进程）
            subprocess.Popen(
                [sys.executable, str(script_path)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                cwd="/Users/mettlyz/.openclaw/workspace"
            )
            
            logger.info(f"✅ 子代理启动成功 #{task_id}: {task_title[:40]}")
            return True
            
        except Exception as e:
            logger.error(f"启动子代理失败 #{task_id}: {e}")
            # 启动失败，回滚状态为pending
            try:
                sql_rollback = "UPDATE tasks SET status = 'pending', updated_at = NOW() WHERE id = %s"
                execute_update(sql_rollback, (task['id'],))
            except:
                pass
            return False
    
    def _generate_subagent_script(self, task_id: int, task_title: str) -> str:
        """生成子代理独立脚本（带模型随机选择+自动重试）"""
        # 使用简单字符串拼接，避免f-string嵌套地狱
        lines = []
        lines.append("#!/usr/bin/env python3")
        lines.append("import sys")
        lines.append("import json")
        lines.append("import random")
        lines.append("import time")
        lines.append("from datetime import datetime")
        lines.append("from pathlib import Path")
        lines.append("")
        lines.append("sys.path.insert(0, str(Path('/Users/mettlyz/.openclaw/workspace/scripts')))")
        lines.append("from lib.db_connector import execute_query, execute_update")
        lines.append("")
        lines.append("# === 🎯 模型随机选择 + 自动重试机制 ===")
        lines.append("def get_model_list():")
        lines.append("    '''从openclaw.json读取模型列表，随机打乱顺序'''")
        lines.append("    config_path = '/Users/mettlyz/.openclaw/openclaw.json'")
        lines.append("    try:")
        lines.append("        with open(config_path, 'r', encoding='utf-8') as f:")
        lines.append("            config = json.load(f)")
        lines.append("        model_config = config.get('agent', {}).get('model', {})")
        lines.append("        primary = model_config.get('primary', 'alicodingplan/qwen3.6-plus')")
        lines.append("        fallbacks = model_config.get('fallbacks', [])")
        lines.append("        # 合并所有模型，去重，随机打乱")
        lines.append("        all_models = list(dict.fromkeys([primary] + fallbacks))")
        lines.append("        random.shuffle(all_models)")
        lines.append("        return all_models")
        lines.append("    except Exception as e:")
        lines.append("        print(f'读取模型列表失败: {e}, 使用默认模型')")
        lines.append("        return ['alicodingplan/qwen3.6-plus']")
        lines.append("")
        lines.append("def try_with_model(model_name, task_func):")
        lines.append("    '''尝试使用指定模型执行任务'''")
        lines.append("    try:")
        lines.append("        print(f'🎲 使用模型: {model_name}')")
        lines.append("        # 这里设置环境变量或通过参数传递模型给子代理执行器")
        lines.append("        # 实际执行时会通过OpenClaw的模型选择机制生效")
        lines.append("        return task_func()")
        lines.append("    except Exception as e:")
        lines.append("        print(f'模型 {model_name} 执行失败: {e}')")
        lines.append("        return None")
        lines.append("")
        lines.append("def execute_with_model_fallback(task_func):")
        lines.append("    '''随机尝试所有模型，直到成功或全部失败'''")
        lines.append("    model_list = get_model_list()")
        lines.append("    print(f'📋 模型列表（已随机打乱）: {model_list}')")
        lines.append("    for i, model in enumerate(model_list):")
        lines.append("        print(f'\n🔄 第 {i+1}/{len(model_list)} 次尝试...')")
        lines.append("        result = try_with_model(model, task_func)")
        lines.append("        if result is not None:")
        lines.append("            print(f'✅ 模型 {model} 执行成功！')")
        lines.append("            return result")
        lines.append("        time.sleep(1)  # 重试间隔")
        lines.append("    print('❌ 所有模型都执行失败')")
        lines.append("    # 最后使用默认模型兜底")
        lines.append("    return task_func()")
        lines.append("")
        lines.append(f"TASK_ID = {task_id}")
        lines.append(f"TASK_TITLE = {json.dumps(task_title, ensure_ascii=False)}")
        lines.append("")
        lines.append("def log(msg):")
        lines.append("    print('[{}] {}'.format(datetime.now().strftime('%H:%M:%S'), msg))")
        lines.append("")
        lines.append("def update_field(field, value):")
        lines.append("    sql = 'UPDATE tasks SET {} = %s, updated_at = NOW() WHERE id = %s'.format(field)")
        lines.append("    execute_update(sql, (value, TASK_ID))")
        lines.append("")
        lines.append("def update_status(status):")
        lines.append("    update_field('status', status)")
        lines.append("    log('状态变更: {}'.format(status))")
        lines.append("")
        lines.append("# 开始执行")
        lines.append("update_status('in_progress')")
