#!/bin/bash
# SDS 自我驱动系统 - 启动脚本
# 版本: v4.6
# 作者: Dudu

SDS_DIR="/Users/mettlyz/.openclaw/workspace/sds"
LOG_DIR="/Users/mettlyz/.openclaw/workspace/logs"
PID_FILE="/tmp/sds.pid"

cd $SDS_DIR

# 加载环境变量（显式导出关键变量）
if [ -f "$HOME/.openclaw/.env" ]; then
    # 显式导出关键API Key
    export MOONSHOT_API_KEY=$(grep '^MOONSHOT_API_KEY=' "$HOME/.openclaw/.env" | cut -d'=' -f2)
    export ALICODINGPLAN_API_KEY=$(grep '^ALICODINGPLAN_API_KEY=' "$HOME/.openclaw/.env" | cut -d'=' -f2)
    export DEEPSEEK_API_KEY=$(grep '^DEEPSEEK_API_KEY=' "$HOME/.openclaw/.env" | cut -d'=' -f2)
    export DMXAPI_API_KEY=$(grep '^DMXAPI_API_KEY=' "$HOME/.openclaw/.env" | cut -d'=' -f2)
    echo "✅ 已显式导出API Key环境变量"
fi

# 检查是否已在运行
if [ -f "$PID_FILE" ]; then
    PID=$(cat $PID_FILE)
    if ps -p $PID > /dev/null 2>&1; then
        echo "⚠️  SDS 已经在运行 (PID: $PID)"
        exit 1
    else
        echo "🧹 清理旧的 PID 文件"
        rm $PID_FILE
    fi
fi

echo "🚀 启动 SDS v4.6 自我驱动系统..."
mkdir -p $LOG_DIR

# 后台连续运行
nohup python3 sds_main.py --continuous >> $LOG_DIR/sds-main.log 2>&1 &
PID=$!
echo $PID > $PID_FILE

sleep 2

if ps -p $PID > /dev/null 2>&1; then
    echo "✅ SDS v4.6 启动成功 (PID: $PID)"
    echo "📝 日志文件: $LOG_DIR/sds-main.log"
else
    echo "❌ SDS 启动失败，请查看日志"
    cat $LOG_DIR/sds-main.log | tail -20
fi
