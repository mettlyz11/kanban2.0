    log("\n📊 各目标 Pending 任务数:")
    needs_generation = False
    for code, info in GOALS.items():
        cnt = pending_by_goal.get(code, 0)
        bar = '█' * cnt + '░' * max(0, 5 - cnt)
        status = '✅' if cnt > 0 else '⚠️'
        log(f"  {status} {code} {info['name']}: {cnt}/5 {bar}")
        if cnt == 0:
            needs_generation = True
    return needs_generation

# ============================================
# 质量门控验证 (Quality Gate Validation)
# ============================================

def validate_recent_completions():
    """
    每轮调度检查最近完成的任务是否符合验收标准
    不符合的标记为failed，等待重新执行
    """
    with conn.cursor() as cursor:
        # 检查最近5分钟内标记为completed的任务
        cursor.execute("""
            SELECT id, title,
                   CHAR_LENGTH(IFNULL(execution_log,'')) as log_len,
                   CHAR_LENGTH(IFNULL(result_summary,'')) as result_len
            FROM tasks
            WHERE status IN ('completed','done')
            AND updated_at > DATE_SUB(NOW(), INTERVAL 5 MINUTE)
        """)
        recent = cursor.fetchall()
    
    if not recent:
        return 0
    
    rejected = 0
    for task in recent:
        log_ok = task['log_len'] >= MIN_EXECUTION_LOG_LEN
        result_ok = task['result_len'] >= MIN_RESULT_SUMMARY_LEN
        
        # AND逻辑：必须同时满足
        if not (log_ok and result_ok):
            # 验收不通过
            with conn.cursor() as cursor:
                fail_msg = f' [验收失败: execution_log={task["log_len"]}字(需{MIN_EXECUTION_LOG_LEN}), result_summary={task["result_len"]}字(需{MIN_RESULT_SUMMARY_LEN})，必须同时满足，重新执行]'
                cursor.execute("""
                    UPDATE tasks
                    SET status = 'pending',
                        task_summary = CONCAT(IFNULL(task_summary, ''), %s),
                        updated_at = NOW()
                    WHERE id = %s
                """, (fail_msg, task['id']))
                conn.commit()
            log(f"  🚫 #{task['id']} 验收失败: log={task['log_len']}字, result={task['result_len']}字 → pending")
            rejected += 1
        else:
            log(f"  ✅ #{task['id']} 验收通过: log={task['log_len']}字, result={task['result_len']}字")
            # 从已使用模型记录中移除
            global _used_models
            if task['id'] in _used_models:
                del _used_models[task['id']]
    
    if rejected:
        log(f"  📋 质量门控: {rejected}个任务验收不通过，重新执行")
    return rejected

# ============================================
# 心跳管理 (Heartbeat Management)
# ============================================

def check_heartbeats():
    """
    心跳健康检查 - 每轮调度执行
    
    返回: (recovered_count, warn_count)
    """
    with conn.cursor() as cursor:
        # 查找所有in_progress且有last_heartbeat的任务
        cursor.execute("""
            SELECT id, title, last_heartbeat, spawn_attempt, subagent_session_key
            FROM tasks 
            WHERE status = 'in_progress' 
            AND last_heartbeat IS NOT NULL
            ORDER BY last_heartbeat ASC
        """)
        tasks = cursor.fetchall()
    
    if not tasks:
        return 0, 0
    
    now = datetime.now()
    recovered = 0
    warned = 0
    
    for task in tasks:
        hb = task['last_heartbeat']
        if not hb:
            continue
        age_minutes = (now - hb).total_seconds() / 60
        
        if age_minutes >= HEARTBEAT_TIMEOUT_MINUTES:
            # 超时 → 自动恢复为pending
            msg = f'[心跳超时: 最后心跳{hb}，已超时{age_minutes:.0f}分钟，自动恢复为pending]'
            with conn.cursor() as cursor:
                cursor.execute("""
                    UPDATE tasks 
                    SET status = 'pending', 
                        task_summary = CONCAT(IFNULL(task_summary, ''), %s),
                        updated_at = NOW()
                    WHERE id = %s
                """, (msg, task['id']))
                conn.commit()
            # 从已使用模型记录中移除
            global _used_models
            if task['id'] in _used_models:
                del _used_models[task['id']]
            log(f"  ⏰ #{task['id']} 心跳超时 ({age_minutes:.0f}分钟) → 恢复为pending")
            recovered += 1
            
        elif age_minutes >= HEARTBEAT_WARN_MINUTES:
            # 警告 → 记录日志
            log(f"  ⚠️ #{task['id']} 心跳警告 ({age_minutes:.0f}分钟未更新)")
            warned += 1
    
    if recovered or warned:
        log(f"  💓 心跳检查: {recovered}个恢复, {warned}个警告")
    
    return recovered, warned

def detect_stale_tasks():
    """
    检测无心跳的in_progress任务
    这些任务从未发送心跳，可能是spawn成功但子代理未运行
    
    超过30分钟的无心跳任务视为僵尸
    """
    with conn.cursor() as cursor:
        cursor.execute("""
            SELECT id, title, updated_at
            FROM tasks
            WHERE status = 'in_progress'
            AND last_heartbeat IS NULL
            AND updated_at < DATE_SUB(NOW(), INTERVAL 30 MINUTE)
        """)
        stale = cursor.fetchall()
    
    if not stale:
        return 0
    
    for task in stale:
        msg = f'[无心跳僵尸任务: 最后更新{task["updated_at"]}，自动恢复]'
        with conn.cursor() as cursor:
            cursor.execute("""
                UPDATE tasks 
                SET status = 'pending',
                    task_summary = CONCAT(IFNULL(task_summary, ''), %s),
                    updated_at = NOW()
                WHERE id = %s
            """, (msg, task['id']))
            conn.commit()
        # 从已使用模型记录中移除
        global _used_models
        if task['id'] in _used_models:
            del _used_models[task['id']]
        log(f"  💀 #{task['id']} 无心跳僵尸 → 恢复为pending")
    
    return len(stale)

def run_scheduler_cycle(cycle_num):
    global conn
    global consecutive_failures, circuit_breaker_paused, circuit_breaker_pause_until
    global _used_models
    
    # 每轮调度开始时清零模型使用记录
    # 原因：上一轮的任务要么已完成，要么已被心跳检查恢复为 pending
    # 新周期应该重新分配模型，不受上一轮影响
    _used_models.clear()
    
    if circuit_breaker_paused:
        from datetime import datetime
        if datetime.now() < circuit_breaker_pause_until:
            log(f"🔌 熔断保护已触发: 连续失败{MAX_CONSECUTIVE_FAILURES}次，暂停到{circuit_breaker_pause_until}")
            return 0
        else:
            log(f"🔌 熔断保护结束，恢复调度")
            circuit_breaker_paused = False
            consecutive_failures = 0

    # 检查心跳和僵尸任务（带异常保护）
    try:
        check_heartbeats()
    except Exception as e:
        log(f"⚠️ 心跳检查异常: {e}")
        ensure_connection()
    
    try:
        detect_stale_tasks()
    except Exception as e:
        log(f"⚠️ 僵尸任务检测异常: {e}")
        ensure_connection()
    
    # 验证最近完成的任务质量
    try:
        validate_recent_completions()
    except Exception as e:
        log(f"⚠️ 质量门控异常: {e}")
        ensure_connection()

    in_progress = get_in_progress_count()
    available_slots = MAX_CONCURRENT - in_progress
    
    if available_slots <= 0:
        log(f"无可用槽位 (in_progress: {in_progress}, max: {MAX_CONCURRENT})，跳过本轮")
        return 0

    pending_tasks = get_pending_tasks(limit=available_slots)
    pending_count = get_pending_count()
    user_action_count = get_user_action_pending_count()
    launched = 0  # 初始化变量，避免无任务时 UnboundLocalError

    if not pending_tasks:
        log(f"无自动待处理任务（可自动执行: {pending_count}, 需要你亲自做: {user_action_count}）")
    else:
        log(f"发现 {len(pending_tasks)} 个可自动执行的任务（可自动执行: {pending_count}, 需要你亲自做: {user_action_count}）")
        for task in pending_tasks:
            log(f"  • #{task['id']}: {task['title']} [P{task['priority']}]")

        launched = 0
        for i, task in enumerate(pending_tasks):
            if i >= available_slots:
                break
            success = spawn_subagent(task['id'], task['title'], task.get('description', ''))
            if success:
                launched += 1
                consecutive_failures = 0  # 重置连续失败计数
                if i < min(len(pending_tasks), available_slots) - 1:
                    log(f"  等待 60 秒后启动下一个...")
                    time.sleep(60)
            else:
                consecutive_failures += 1
                if consecutive_failures >= MAX_CONSECUTIVE_FAILURES:
                    # 触发熔断
                    from datetime import datetime, timedelta
                    circuit_breaker_paused = True
                    circuit_breaker_pause_until = datetime.now() + timedelta(minutes=10)
                    log(f"🔌 熔断触发: 连续{consecutive_failures}次失败，暂停调度10分钟")
                    break
        log(f"\n本轮启动 {launched} 个子代理，连续失败{consecutive_failures}次")

    # V4.3: 均衡生成逻辑
    if pending_count < PENDING_THRESHOLD:
        log(f"\n📊 [Research] Pending ({pending_count}) < {PENDING_THRESHOLD}，触发 LLM 任务生成...")
        balance_needed = check_goal_balance()
        if balance_needed:
            log("  ⚠️ 检测到目标不均衡，启动 V4.3 均衡生成模式")
            spawn_llm_task_generator()
        else:
            log("  ✅ 目标分布均衡，跳过任务生成")

    return launched

