def log(msg):
    ts = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    print(f"[{ts}] {msg}", flush=True)

def get_db_connection():
    global conn
    for attempt in range(3):
        try:
            conn = _get_db_conn()
            log(f"✅ 数据库连接成功 (尝试 {attempt+1}/3)")
            return conn
        except Exception as e:
            log(f"⚠️ 数据库连接失败 (尝试 {attempt+1}/3): {e}")
            if attempt < 2:
                time.sleep(5 * (attempt + 1))
    return None

def ensure_connection():
    """确保全局连接有效，无效时自动重连并更新全局 conn"""
    global conn
    try:
        if conn:
            conn.ping(reconnect=True)
            return True
    except Exception:
        pass
    # 连接无效，重新建立
    log("⚠️ 数据库连接断开，重新连接...")
    new_conn = get_db_connection()
    if new_conn:
        conn = new_conn
        return True
    return False


def safe_db_operation(operation_name, func):
    """安全执行数据库操作，异常时不崩溃，返回 None 表示失败"""
    try:
        if not ensure_connection():
            log(f"⚠️ [{operation_name}] 数据库连接失败，跳过")
            return None
        return func()
    except Exception as e:
        log(f"⚠️ [{operation_name}] 数据库操作异常: {e}")
        # 尝试重连
        ensure_connection()
        return None

