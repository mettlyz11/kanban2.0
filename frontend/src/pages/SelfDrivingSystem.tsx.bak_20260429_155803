import { useState } from 'react'

export default function SelfDrivingSystem() {
  const [activeTab, setActiveTab] = useState('dashboard')

  const tabs = [
    { key: 'dashboard', label: '📊 系统概览' },
    { key: 'goals', label: '🎯 目标配置' },
    { key: 'tasks', label: '📋 任务规则' },
    { key: 'projects', label: '📁 项目阈值' },
    { key: 'realtime', label: '📡 实时监控' },
    { key: 'history', label: '📈 历史趋势' },
    { key: 'architecture', label: '🏗️ 架构编辑' },
    { key: 'documents', label: '📄 文档管理' },
  ]

  const renderContent = () => {
    return (
      <div>
        <h1 style={{ color: 'red', fontSize: '24px' }}>🔥 自我驱动系统已加载 🔥</h1>
        <p>当前 Tab: {activeTab}</p>
        <p>如果你是刘宇宙教授，说明页面正常工作！</p>
      </div>
    )
  }

  return (
    <div style={{ display: 'flex', gap: 20, padding: 20, minHeight: '100vh' }}>
      {/* 侧边栏 */}
      <div style={{
        width: 200,
        background: '#fff',
        borderRadius: 8,
        padding: 8,
        border: '1px solid #e5e7eb',
        height: 'fit-content'
      }}>
        <div style={{ padding: '8px 12px', fontWeight: 700, fontSize: 14, marginBottom: 8, color: '#333' }}>
          自我驱动
        </div>
        {tabs.map(tab => (
          <div
            key={tab.key}
            onClick={() => setActiveTab(tab.key)}
            style={{
              padding: '10px 12px',
              borderRadius: 6,
              cursor: 'pointer',
              marginBottom: 4,
              fontSize: 14,
              background: activeTab === tab.key ? '#3b82f6' : 'transparent',
              color: activeTab === tab.key ? '#fff' : '#333',
              fontWeight: activeTab === tab.key ? 600 : 400,
            }}
          >
            {tab.label}
          </div>
        ))}
      </div>

      {/* 内容区域 */}
      <div style={{
        flex: 1,
        background: '#fff',
        borderRadius: 8,
        padding: 24,
        border: '1px solid #e5e7eb'
      }}>
        {renderContent()}
      </div>
    </div>
  )
}
