import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import { 
  User, 
  Briefcase, 
  GraduationCap,
  ChevronLeft,
  Award,
  BookOpen,
  FileCheck,
  Trophy,
  Newspaper,
  FolderOpen,
  Download,
  File,
  FileSpreadsheet,
  FileImage,
  FileText,
  Plus
} from 'lucide-react'

interface TabItem {
  id: number
  title: string
  content: string
  item_date: string | null
  attachments?: any
}

interface Tab {
  id: number
  name: string
  type: string
  sort_order: number
  items: TabItem[]
}

interface Person {
  id: number
  name: string
  title?: string
  department?: string
  email?: string
  phone?: string
  bio?: string
  tabs: Tab[]
}

const iconMap: Record<string, any> = {
  basic: User,
  education: GraduationCap,
  experience: Briefcase,
  publications: BookOpen,
  patents: FileCheck,
  awards: Trophy,
  media: Newspaper,
  files: FolderOpen
}

const fileIconMap: Record<string, any> = {
  pdf: FileText,
  xlsx: FileSpreadsheet,
  xls: FileSpreadsheet,
  doc: FileText,
  docx: FileText,
  jpg: FileImage,
  jpeg: FileImage,
  png: FileImage,
  default: File
}

export function LiuYuzhou() {
  const navigate = useNavigate()
  const [person, setPerson] = useState<Person | null>(null)
  const [loading, setLoading] = useState(true)
  const [activeTab, setActiveTab] = useState<string>('basic')
  const [uploading, setUploading] = useState(false)

  useEffect(() => {
    fetchPersonData()
  }, [])

  const fetchPersonData = async () => {
    try {
      setLoading(true)
      const res = await fetch('/api/personal-info/people/4')
      const data = await res.json()
      
      if (data.success && data.person) {
        setPerson(data.person)
        if (data.person.tabs && data.person.tabs.length > 0) {
          setActiveTab(data.person.tabs[0].type)
        }
      }
    } catch (e) {
      console.error('Failed to fetch person data:', e)
    } finally {
      setLoading(false)
    }
  }

  const getIconComponent = (type: string) => iconMap[type] || User
  const getFileIcon = (fileType: string) => fileIconMap[fileType?.toLowerCase()] || fileIconMap.default

  const handleDownload = (fileUrl: string, fileName: string) => {
    const link = document.createElement('a')
    link.href = fileUrl
    link.download = fileName
    link.target = '_blank'
    document.body.appendChild(link)
    link.click()
    document.body.removeChild(link)
  }

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file || !person) return
    
    const filesTab = person.tabs.find(t => t.type === 'files')
    if (!filesTab) {
      alert('未找到文件列表标签页')
      return
    }
    
    setUploading(true)
    try {
      const formData = new FormData()
      formData.append('file', file)
      formData.append('entity_type', 'person')
      formData.append('entity_id', person.id.toString())
      
      const uploadRes = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      })
      const uploadData = await uploadRes.json()
      
      if (!uploadData.success) {
        throw new Error(uploadData.error || '上传失败')
      }
      
      const fileExt = file.name.split('.').pop()?.toLowerCase() || ''
      const fileSize = formatFileSize(file.size)
      
      const attachments = {
        file_url: uploadData.url,
        file_type: fileExt,
        file_size: fileSize
      }
      
      const itemRes = await fetch(`/api/persons/${person.id}/tabs/${filesTab.id}/items`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: file.name,
          content: '',
          attachments: attachments,
          item_date: new Date().toISOString().split('T')[0]
        })
      })
      
      const itemData = await itemRes.json()
      if (itemData.success) {
        await fetchPersonData()
      } else {
        throw new Error(itemData.error || '创建文件记录失败')
      }
    } catch (e) {
      console.error('上传失败:', e)
      alert('上传失败: ' + (e as Error).message)
    } finally {
      setUploading(false)
      e.target.value = ''
    }
  }
  
  const formatFileSize = (bytes: number): string => {
    if (bytes === 0) return '0 Bytes'
    const k = 1024
    const sizes = ['Bytes', 'KB', 'MB', 'GB']
    const i = Math.floor(Math.log(bytes) / Math.log(k))
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]
  }

  const renderTabContent = (tab: Tab) => {
    const IconComponent = getIconComponent(tab.type)

    if (tab.type === 'files') {
      return (
        <div className="card" style={{ marginBottom: '24px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px' }}>
            <h3 style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
              <IconComponent size={20} />
              {tab.name}
            </h3>
            <label style={{
              display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px',
              background: '#667eea', color: 'white', border: 'none', borderRadius: '6px',
              cursor: 'pointer', fontSize: '14px', fontWeight: '500'
            }}>
              <Plus size={16} />
              <span>{uploading ? '上传中...' : '上传文件'}</span>
              <input 
                type="file" 
                onChange={handleFileUpload} 
                disabled={uploading} 
                style={{ display: 'none' }} 
              />
            </label>
          </div>
          <div style={{ display: 'grid', gap: '12px' }}>
            {!tab.items || tab.items.length === 0 ? (
              <div style={{ padding: '40px', textAlign: 'center', color: '#888' }}>暂无文件，点击上方按钮上传</div>
            ) : (
              tab.items.map((item: TabItem, index: number) => {
                const attachments = item.attachments || {}
                const fileUrl = attachments.file_url
                const fileType = attachments.file_type || 'default'
                const fileSize = attachments.file_size || ''
                const FileIcon = getFileIcon(fileType)
                
                return (
                  <div key={index} style={{ 
                    padding: '16px', 
                    background: '#f8f9fa', 
                    borderRadius: '8px',
                    display: 'flex',
                    alignItems: 'center',
                    gap: '16px'
                  }}>
                    <FileIcon size={32} color="#667eea" />
                    <div style={{ flex: 1 }}>
                      <div style={{ fontWeight: '600', marginBottom: '4px' }}>{item.title}</div>
                      {item.content && <div style={{ color: '#666', fontSize: '0.9rem' }}>{item.content}</div>}
                      <div style={{ color: '#888', fontSize: '0.85rem' }}>
                        {fileType.toUpperCase()}{fileSize && ` • ${fileSize}`}{item.item_date && ` • ${item.item_date}`}
                      </div>
                    </div>
                    {fileUrl && (
                      <button onClick={() => handleDownload(fileUrl, item.title)} style={{
                        display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px',
                        background: '#667eea', color: 'white', border: 'none', borderRadius: '6px',
                        cursor: 'pointer', fontSize: '14px', fontWeight: '500'
                      }}>
                        <Download size={16} /> 下载
                      </button>
                    )}
                  </div>
                )
              })
            )}
          </div>
        </div>
      )
    }

    if (!tab.items || tab.items.length === 0) {
      return <div style={{ padding: '40px', textAlign: 'center', color: '#888' }}>暂无数据</div>
    }

    return (
      <div className="card" style={{ marginBottom: '24px' }}>
        <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
          <IconComponent size={20} />
          {tab.name}
        </h3>
        <div style={{ display: 'grid', gap: '12px' }}>
          {tab.items.map((item: TabItem, index: number) => (
            <div key={index} style={{ padding: '16px', background: '#f8f9fa', borderRadius: '8px' }}>
              <div style={{ fontWeight: '600', marginBottom: '4px' }}>{item.title}</div>
              {item.item_date && <div style={{ color: '#888', fontSize: '0.85rem' }}>{item.item_date}</div>}
              {item.content && <div style={{ color: '#666', fontSize: '0.9rem', whiteSpace: 'pre-wrap' }}>{item.content}</div>}
            </div>
          ))}
        </div>
      </div>
    )
  }

  if (loading) return <div style={{ padding: '40px', textAlign: 'center' }}>加载中...</div>
  if (!person) return <div style={{ padding: '40px', textAlign: 'center' }}>无法加载数据</div>

  return (
    <div style={{ padding: '24px', maxWidth: '1200px', margin: '0 auto' }}>
      <button onClick={() => navigate('/personal')} style={{
        display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '24px',
        padding: '8px 16px', background: 'transparent', border: 'none', cursor: 'pointer',
        color: '#667eea', fontSize: '16px'
      }}>
        <ChevronLeft size={20} /> 返回人员列表
      </button>

      <div style={{ marginBottom: '32px' }}>
        <h1 style={{ fontSize: '32px', marginBottom: '8px' }}>{person.name}</h1>
        <p style={{ color: '#888' }}>{person.title} | {person.department}</p>
        {person.bio && <p style={{ color: '#666', marginTop: '8px' }}>{person.bio}</p>}
      </div>

      <div style={{ display: 'flex', gap: '12px', marginBottom: '24px', borderBottom: '2px solid #e0e0e0', paddingBottom: '12px', flexWrap: 'wrap' }}>
        {person.tabs.map((tab) => {
          const IconComponent = getIconComponent(tab.type)
          return (
            <button key={tab.type} onClick={() => setActiveTab(tab.type)} style={{
              display: 'flex', alignItems: 'center', gap: '8px', padding: '12px 24px',
              background: activeTab === tab.type ? '#667eea' : 'transparent',
              color: activeTab === tab.type ? 'white' : '#666', border: 'none', borderRadius: '8px',
              cursor: 'pointer', fontWeight: activeTab === tab.type ? '600' : '400'
            }}>
              <IconComponent size={18} /> {tab.name}
            </button>
          )
        })}
      </div>

      {person.tabs.map(tab => tab.type === activeTab ? <div key={tab.type}>{renderTabContent(tab)}</div> : null)}
    </div>
  )
}

export default LiuYuzhou
