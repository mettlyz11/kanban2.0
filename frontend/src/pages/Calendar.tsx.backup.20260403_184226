import { useState, useEffect } from 'react';

interface Task {
  id: number;
  title: string;
  status: string;
  project_id: number;
  due_date?: string;
}

interface Project {
  id: number;
  name: string;
  color: string;
}

export function Calendar() {
  const [tasks, setTasks] = useState<Task[]>([]);
  const [projects, setProjects] = useState<Project[]>([]);
  const [loading, setLoading] = useState(true);
  const [currentDate, setCurrentDate] = useState(new Date());

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      setLoading(true);
      const [tasksRes, projectsRes] = await Promise.all([
        fetch('/api/tasks'),
        fetch('/api/projects')
      ]);
      
      const tasksData = await tasksRes.json();
      const projectsData = await projectsRes.json();
      
      // 过滤出有 due_date 的任务
      const tasksWithDates = (tasksData.tasks || []).filter((t: Task) => t.due_date);
      setTasks(tasksWithDates);
      setProjects(projectsData.projects || []);
    } catch (error) {
      console.error('Failed to fetch data:', error);
    } finally {
      setLoading(false);
    }
  };

  const getDaysInMonth = (date: Date) => {
    const year = date.getFullYear();
    const month = date.getMonth();
    const days = new Date(year, month + 1, 0).getDate();
    return days;
  };

  const getFirstDayOfMonth = (date: Date) => {
    const year = date.getFullYear();
    const month = date.getMonth();
    return new Date(year, month, 1).getDay();
  };

  const navigateMonth = (direction: number) => {
    const newDate = new Date(currentDate);
    newDate.setMonth(newDate.getMonth() + direction);
    setCurrentDate(newDate);
  };

  // 从各种日期格式中提取 YYYY-MM-DD 字符串
  const extractYMD = (dueDateStr: string): string | null => {
    // 尝试直接匹配 YYYY-MM-DD 格式
    const ymdMatch = dueDateStr.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (ymdMatch) {
      return `${ymdMatch[1]}-${ymdMatch[2]}-${ymdMatch[3]}`;
    }
    // 尝试解析 "Sun, 22 Feb 2026 00:00:00 GMT" 格式
    try {
      const date = new Date(dueDateStr);
      const year = date.getUTCFullYear();
      const month = date.getUTCMonth() + 1;
      const day = date.getUTCDate();
      return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    } catch {
      return null;
    }
  };

  const getTasksForDay = (year: number, month: number, day: number) => {
    const targetDate = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    return tasks.filter(task => {
      if (!task.due_date) return false;
      const ymd = extractYMD(task.due_date);
      if (ymd === targetDate && day === 2) {
        console.log(`✅ Matched task: ${task.title}`);
      }
      return ymd === targetDate;
    });
  };

  const getProjectColor = (projectId: number) => {
    const project = projects.find(p => p.id === projectId);
    return project?.color || '#3B82F6';
  };

  const getStatusColor = (status: string) => {
    switch(status) {
      case 'done': return '#10B981';
      case 'progress': return '#F59E0B';
      case 'todo': return '#6B7280';
      default: return '#3B82F6';
    }
  };

  const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月',
    '七月', '八月', '九月', '十月', '十一月', '十二月'];

  const dayNames = ['日', '一', '二', '三', '四', '五', '六'];

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-xl">加载中...</div>
      </div>
    );
  }

  const daysInMonth = getDaysInMonth(currentDate);
  const firstDay = getFirstDayOfMonth(currentDate);
  // 日历显示的月份基于用户本地时间，但任务日期存储为UTC 00:00
  // 使用本地时间的年月日生成targetDate，因为用户期望日期按本地日历显示
  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();

  // 统计当前月份的任务
  const currentMonthTasks = tasks.filter(task => {
    if (!task.due_date) return false;
    // 使用正则提取 YYYY-MM-DD
    const ymd = extractYMD(task.due_date);
    if (!ymd) return false;
    // 提取年份和月份
    const taskYear = parseInt(ymd.substring(0, 4), 10);
    const taskMonth = parseInt(ymd.substring(5, 7), 10) - 1; // 0-indexed
    return taskYear === year && taskMonth === month;
  });

  return (
    <div className="p-6 max-w-7xl mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-3xl font-bold text-gray-900">
          {monthNames[currentDate.getMonth()]} {currentDate.getFullYear()}
        </h1>
        <div className="flex gap-2">
          <button
            onClick={() => navigateMonth(-1)}
            className="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
          >
            ← 上月
          </button>
          <button
            onClick={() => setCurrentDate(new Date())}
            className="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600"
          >
            今天
          </button>
          <button
            onClick={() => navigateMonth(1)}
            className="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
          >
            下月 →
          </button>
        </div>
      </div>

      {/* Calendar Grid */}
      <div className="bg-white rounded-lg shadow overflow-hidden">
        {/* Day Headers */}
        <div className="grid grid-cols-7 bg-gray-50 border-b">
          {dayNames.map(day => (
            <div key={day} className="p-3 text-center font-semibold text-gray-700">
              {day}
            </div>
          ))}
        </div>

        {/* Calendar Days */}
        <div className="grid grid-cols-7">
          {/* Empty cells for days before the first day of month */}
          {Array.from({ length: firstDay }).map((_, i) => (
            <div key={`empty-${i}`} className="min-h-32 bg-gray-50 border-r border-b" />
          ))}

          {/* Days of the month */}
          {Array.from({ length: daysInMonth }).map((_, i) => {
            const day = i + 1;
            const dayTasks = getTasksForDay(year, month, day);
            const isToday = 
              day === new Date().getDate() &&
              currentDate.getMonth() === new Date().getMonth() &&
              currentDate.getFullYear() === new Date().getFullYear();

            return (
              <div
                key={day}
                className={`min-h-[8rem] border-r border-b p-2 ${
                  isToday ? 'bg-blue-50' : 'bg-white'
                }`}
              >
                <div className={`text-sm font-medium mb-1 ${
                  isToday ? 'text-blue-600' : 'text-gray-700'
                }`}>
                  {day} ({dayTasks.length})
                </div>
                <div className="space-y-1">
                  {dayTasks.slice(0, 4).map(task => (
                    <div
                      key={task.id}
                      className="text-xs p-1 rounded truncate text-black cursor-pointer hover:opacity-80"
                      style={{ backgroundColor: getProjectColor(task.project_id) }}
                      title={`${task.title} (${task.status})`}
                    >
                      <div className="flex items-center gap-1">
                        <div 
                          className="w-2 h-2 rounded-full bg-white"
                          style={{ backgroundColor: getStatusColor(task.status) }}
                        />
                        <span className="truncate">{task.title}</span>
                      </div>
                    </div>
                  ))}
                  {dayTasks.length > 4 && (
                    <div className="text-xs text-gray-500">
                      还有 {dayTasks.length - 4} 个任务
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Legend */}
      <div className="mt-6 bg-white rounded-lg shadow p-4">
        <h3 className="text-lg font-semibold mb-3">项目图例</h3>
        <div className="flex flex-wrap gap-4">
          {projects.map((project) => (
            <div key={project.id} className="flex items-center gap-2">
              <div
                className="w-4 h-4 rounded"
                style={{ backgroundColor: project.color }}
              />
              <span className="text-sm">{project.name}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Stats */}
      <div className="mt-6 grid grid-cols-1 md:grid-cols-4 gap-4">
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-2xl font-bold text-blue-600">{currentMonthTasks.length}</div>
          <div className="text-sm text-gray-600">本月任务</div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-2xl font-bold text-green-600">
            {currentMonthTasks.filter(t => t.status === 'done').length}
          </div>
          <div className="text-sm text-gray-600">已完成</div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-2xl font-bold text-yellow-600">
            {currentMonthTasks.filter(t => t.status === 'progress').length}
          </div>
          <div className="text-sm text-gray-600">进行中</div>
        </div>
        <div className="bg-white rounded-lg shadow p-4">
          <div className="text-2xl font-bold text-gray-600">
            {currentMonthTasks.filter(t => t.status === 'todo').length}
          </div>
          <div className="text-sm text-gray-600">待办</div>
        </div>
      </div>

      {/* Task List for Current Month */}
      {currentMonthTasks.length > 0 && (
        <div className="mt-6 bg-white rounded-lg shadow p-4">
          <h3 className="text-lg font-semibold mb-3">本月任务列表</h3>
          <div className="space-y-2 max-h-64 overflow-y-auto">
            {currentMonthTasks.map(task => (
              <div 
                key={task.id}
                className="flex items-center justify-between p-2 bg-gray-50 rounded"
              >
                <div className="flex items-center gap-3">
                  <div 
                    className="w-3 h-3 rounded-full"
                    style={{ backgroundColor: getProjectColor(task.project_id) }}
                  />
                  <span className="text-sm">{task.title}</span>
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-gray-500">{task.due_date}</span>
                  <span className={`text-xs px-2 py-1 rounded ${
                    task.status === 'done' ? 'bg-green-100 text-green-700' :
                    task.status === 'progress' ? 'bg-yellow-100 text-yellow-700' :
                    'bg-gray-100 text-gray-700'
                  }`}>
                    {task.status}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

export default Calendar
