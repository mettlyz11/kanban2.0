import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { 
  Building2, 
  Calendar, 
  User, 
  Award,
  ChevronLeft,
  Folder,
  Clock,
  Briefcase
} from 'lucide-react'

interface CompanyDetail {
  id: string
  fullName: string
  englishName: string
  creditCode: string
  address: string
  createDate: string
  registeredCapital: string
  legalRepresentative: string
  companyType: string
  businessScope: string[]
  mainBusiness: string[]
  team: {
    name: string
    position: string
    background: string
  }[]
  partners: string[]
}

const sampleDetail: CompanyDetail = {
  id: 'helight',
  fullName: '和光智成（北京）科技有限公司',
  englishName: 'Helight Intelligence Technology Co., Ltd.',
  creditCode: '91110108MA01xxxxx',
  address: '北京市海淀区xxxx',
  createDate: '2020-01-15',
  registeredCapital: '1000万元',
  legalRepresentative: '刘宇宙',
  companyType: '有限责任公司',
  businessScope: [
    '技术开发、技术咨询、技术服务',
    '人工智能应用软件开发',
    '化学计算与模拟服务',
    '数据处理和存储服务'
  ],
  mainBusiness: [
    'T109过渡态计算平台',
    'Pepi数字员工系统',
    'AI驱动的科研解决方案'
  ],
  team: [
    {
      name: '刘宇宙',
      position: '创始人/首席科学家',
      background: '北京大学博士，蓝天青年学者'
    }
  ],
  partners: [
    '北京航空航天大学',
    '中国科学院'
  ]
}

export function Helight() {
  const { companyId } = useParams<{ companyId: string }>()
  const navigate = useNavigate()
  const [detail, setDetail] = useState<CompanyDetail | null>(null)
  const [loading, setLoading] = useState(true)
  const [activeTab, setActiveTab] = useState<'overview' | 'business' | 'files'>('overview')

  useEffect(() => {
    fetchDetail()
  }, [companyId])

  const fetchDetail = async () => {
    try {
      // 根据companyId获取不同公司信息
      const res = await fetch(`/api/company-info/companies/${companyId}`)
      const data = await res.json()
      if (data.success) {
        setDetail(data.detail)
      } else {
        // 如果API返回失败，使用示例数据但更新公司名称
        setDetail({
          ...sampleDetail,
          id: companyId || 'helight',
          fullName: companyId === '1284' ? '北京深云智合科技有限公司' : 
                   companyId === '1283' ? '和光智成（北京）科技有限公司' : 
                   sampleDetail.fullName
        })
      }
    } catch (e) {
      setDetail({
        ...sampleDetail,
        id: companyId || 'helight',
        fullName: companyId === '1284' ? '北京深云智合科技有限公司' : 
                 companyId === '1283' ? '和光智成（北京）科技有限公司' : 
                 sampleDetail.fullName
      })
    } finally {
      setLoading(false)
    }
  }

  const goBack = () => {
    navigate('/company')
  }

  const formatDate = (dateStr: string) => {
    const date = new Date(dateStr)
    return date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  }

  if (loading) {
    return (
      <div className="page-container">
        <div className="loading">加载中...</div>
      </div>
    )
  }

  if (!detail) {
    return (
      <div className="page-container">
        <div className="empty-state">
          <p>未找到公司信息</p>
          <button onClick={goBack} className="btn btn-primary">返回</button>
        </div>
      </div>
    )
  }

  return (
    <div className="page-container">
      {/* 返回按钮 */}
      <button 
        onClick={goBack}
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '8px',
          padding: '8px 16px',
          background: 'transparent',
          border: '1px solid #ddd',
          borderRadius: '8px',
          cursor: 'pointer',
          marginBottom: '20px'
        }}
      >
        <ChevronLeft size={20} />
        返回公司列表
      </button>

      {/* 公司信息头部 */}
      <div className="card" style={{ marginBottom: '24px' }}>
        <div style={{ display: 'flex', gap: '24px', alignItems: 'flex-start' }}>
          <div style={{
            width: '100px',
            height: '100px',
            borderRadius: '16px',
            background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            fontSize: '48px',
            flexShrink: 0
          }}>
            🏢
          </div>
          <div style={{ flex: 1 }}>
            <h2 style={{ margin: '0 0 8px 0', fontSize: '1.8rem' }}>{detail.fullName}</h2>
            <p style={{ margin: '0 0 12px 0', color: '#666', fontSize: '1rem' }}>
              {detail.englishName}
            </p>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: '16px', color: '#888', fontSize: '0.9rem' }}>
              <span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                <Building2 size={16} />
                统一社会信用代码: {detail.creditCode}
              </span>
              <span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                <Calendar size={16} />
                成立日期: {formatDate(detail.createDate)}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Tab导航 */}
      <div style={{ 
        display: 'flex', 
        gap: '12px', 
        marginBottom: '24px',
        borderBottom: '2px solid #e0e0e0',
        paddingBottom: '12px'
      }}>
        <button
          onClick={() => setActiveTab('overview')}
          style={{
            padding: '12px 24px',
            background: activeTab === 'overview' ? '#667eea' : 'transparent',
            color: activeTab === 'overview' ? 'white' : '#666',
            border: 'none',
            borderRadius: '8px',
            cursor: 'pointer',
            fontWeight: activeTab === 'overview' ? '600' : '400'
          }}
        >
          工商信息
        </button>
        <button
          onClick={() => setActiveTab('business')}
          style={{
            padding: '12px 24px',
            background: activeTab === 'business' ? '#667eea' : 'transparent',
            color: activeTab === 'business' ? 'white' : '#666',
            border: 'none',
            borderRadius: '8px',
            cursor: 'pointer',
            fontWeight: activeTab === 'business' ? '600' : '400'
          }}
        >
          业务信息
        </button>
        <button
          onClick={() => setActiveTab('files')}
          style={{
            padding: '12px 24px',
            background: activeTab === 'files' ? '#667eea' : 'transparent',
            color: activeTab === 'files' ? 'white' : '#666',
            border: 'none',
            borderRadius: '8px',
            cursor: 'pointer',
            fontWeight: activeTab === 'files' ? '600' : '400'
          }}
        >
          文件档案
        </button>
      </div>

      {/* Tab内容 */}
      {activeTab === 'overview' && (
        <>
          {/* 基本信息 */}
          <div className="card" style={{ marginBottom: '24px' }}>
            <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <Building2 size={20} />
              工商登记信息
            </h3>
            <div style={{ display: 'grid', gap: '16px' }}>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>公司名称</span>
                <span style={{ fontWeight: 500 }}>{detail.fullName}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>英文名称</span>
                <span>{detail.englishName}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>统一社会信用代码</span>
                <span>{detail.creditCode}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>注册地址</span>
                <span>{detail.address}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>成立日期</span>
                <span>{formatDate(detail.createDate)}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>注册资本</span>
                <span style={{ color: '#667eea', fontWeight: 600 }}>{detail.registeredCapital}</span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>法定代表人</span>
                <span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                  <User size={16} />
                  {detail.legalRepresentative}
                </span>
              </div>
              <div style={{ display: 'flex', padding: '12px', background: '#f8f9fa', borderRadius: '8px' }}>
                <span style={{ width: '150px', color: '#666' }}>公司类型</span>
                <span>{detail.companyType}</span>
              </div>
            </div>
          </div>

          {/* 经营范围 */}
          <div className="card">
            <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <Briefcase size={20} />
              经营范围
            </h3>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
              {detail.businessScope.map((scope, index) => (
                <div
                  key={index}
                  style={{
                    padding: '12px 16px',
                    background: '#f8f9fa',
                    borderRadius: '8px',
                    borderLeft: '4px solid #667eea'
                  }}
                >
                  {scope}
                </div>
              ))}
            </div>
          </div>
        </>
      )}

      {activeTab === 'business' && (
        <>
          {/* 主营业务 */}
          <div className="card" style={{ marginBottom: '24px' }}>
            <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <Award size={20} />
              主营业务
            </h3>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
              {detail.mainBusiness.map((business, index) => (
                <div
                  key={index}
                  style={{
                    padding: '16px',
                    background: 'linear-gradient(135deg, #f0f4ff 0%, #e0e7ff 100%)',
                    borderRadius: '8px',
                    border: '2px solid #667eea'
                  }}
                >
                  <div style={{ fontWeight: 600, color: '#667eea' }}>{business}</div>
                </div>
              ))}
            </div>
          </div>

          {/* 核心团队 */}
          <div className="card" style={{ marginBottom: '24px' }}>
            <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <User size={20} />
              核心团队
            </h3>
            {detail.team.map((member, index) => (
              <div key={index} style={{ 
                padding: '16px', 
                background: '#f8f9fa', 
                borderRadius: '8px',
                marginBottom: '12px'
              }}>
                <div style={{ fontWeight: 600, marginBottom: '4px' }}>{member.name}</div>
                <div style={{ color: '#667eea', marginBottom: '4px' }}>{member.position}</div>
                <div style={{ color: '#888', fontSize: '0.85rem' }}>{member.background}</div>
              </div>
            ))}
          </div>

          {/* 合作伙伴 */}
          <div className="card">
            <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <Building2 size={20} />
              合作伙伴
            </h3>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: '8px' }}>
              {detail.partners.map((partner, index) => (
                <span
                  key={index}
                  style={{
                    padding: '8px 16px',
                    background: '#e8f5e9',
                    color: '#2e7d32',
                    borderRadius: '20px',
                    fontSize: '0.9rem'
                  }}
                >
                  {partner}
                </span>
              ))}
            </div>
          </div>
        </>
      )}

      {activeTab === 'files' && (
        <div className="card">
          <h3 style={{ marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '8px' }}>
            <Folder size={20} />
            文件档案
          </h3>
          
          <div style={{ display: 'grid', gap: '16px' }}>
            {[
              { name: '合同', count: 0, icon: '📄' },
              { name: '营业执照', count: 0, icon: '📋' },
              { name: '财务报表', count: 0, icon: '📊' },
              { name: '项目文档', count: 0, icon: '📁' },
              { name: '知识产权', count: 0, icon: '💡' },
              { name: '其他', count: 0, icon: '📎' }
            ].map((folder, index) => (
              <div
                key={index}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '16px',
                  padding: '16px',
                  background: '#f8f9fa',
                  borderRadius: '8px',
                  cursor: 'pointer',
                  transition: 'all 0.2s'
                }}
                onMouseEnter={e => {
                  e.currentTarget.style.background = '#e8f4ff'
                }}
                onMouseLeave={e => {
                  e.currentTarget.style.background = '#f8f9fa'
                }}
              >
                <span style={{ fontSize: '32px' }}>{folder.icon}</span>
                <div style={{ flex: 1 }}>
                  <div style={{ fontWeight: '600', marginBottom: '4px' }}>{folder.name}</div>
                  <div style={{ color: '#888', fontSize: '0.85rem' }}>
                    {folder.count} 个文件
                  </div>
                </div>
                <div style={{ color: '#667eea' }}>›</div>
              </div>
            ))}
          </div>

          <div style={{ 
            marginTop: '24px', 
            padding: '16px', 
            background: '#f0f4ff', 
            borderRadius: '8px',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}>
            <Clock size={18} color="#667eea" />
            <span style={{ color: '#667eea', fontSize: '0.9rem' }}>
              本地文件夹同步状态: ✅ 已同步
            </span>
          </div>
        </div>
      )}
    </div>
  )
}
