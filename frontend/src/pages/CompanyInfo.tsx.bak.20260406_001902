import { useState, useEffect } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { Building2, ChevronLeft, MapPin, Phone, Mail, Globe, User, Calendar, ExternalLink } from 'lucide-react'

// 简化公司名称，去掉冗余词汇
const simplifyCompanyName = (name: string): string => {
  if (!name) return '';
  // 去掉常见的冗余词汇
  return name
    .replace(/硅研/g, '')
    .replace(/新材/g, '材料')
    .replace(/科技/g, '')
    .replace(/技术/g, '')
    .replace(/有限/g, '')
    .replace(/公司/g, '')
    .replace(/股份/g, '')
    .replace(/集团/g, '')
    .replace(/\s+/g, '')
    .trim();
};

interface CompanyInfo {
  id: number
  name: string
  short_name: string
  legal_representative: string
  industry: string
  address: string
  phone: string
  email: string
  website: string
  description: string
  create_date: string
  is_favorite: boolean
  last_updated: string
}

export function CompanyInfo() {
  const { id } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const [company, setCompany] = useState<CompanyInfo | null>(null)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    if (id) {
      fetchCompanyDetail(parseInt(id))
    }
  }, [id])

  const fetchCompanyDetail = async (companyId: number) => {
    try {
      setLoading(true)
      const res = await fetch(`/api/company-info/companies/${companyId}`)
      const data = await res.json()
      if (data.success) {
        setCompany(data.company)
      }
    } catch (e) {
      console.error('获取公司详情失败:', e)
    } finally {
      setLoading(false)
    }
  }

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50">
        <div className="animate-spin w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full"></div>
      </div>
    )
  }

  if (!company) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50">
        <div className="text-center">
          <Building2 className="w-16 h-16 mx-auto mb-4 text-gray-300" />
          <p className="text-gray-500">未找到公司信息</p>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* 顶部导航 */}
      <div className="bg-white border-b border-gray-200 sticky top-0 z-10">
        <div className="max-w-5xl mx-auto px-6 py-4">
          <button
            onClick={() => navigate('/company')}
            className="flex items-center gap-2 text-gray-600 hover:text-blue-600 transition-colors"
          >
            <ChevronLeft className="w-5 h-5" />
            返回公司列表
          </button>
        </div>
      </div>

      <div className="max-w-5xl mx-auto px-6 py-8">
        {/* 公司卡片 */}
        <div className="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
          {/* Header - 渐变背景 */}
          <div className="relative bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-12">
            <div className="flex items-center gap-6">
              {/* Logo */}
              <div className="w-24 h-24 bg-white rounded-2xl shadow-xl flex items-center justify-center text-4xl font-bold text-blue-600">
                {company.short_name?.charAt(0) || company.name.charAt(0)}
              </div>
              
              {/* 公司名 */}
              <div className="text-white">
                <h1 className="text-3xl font-bold">{company.name}</h1>
                {company.short_name && company.short_name !== company.name && (
                  <p className="text-blue-100 text-lg mt-1">{company.short_name}</p>
                )}
                <div className="flex items-center gap-3 mt-3">
                  {company.industry && (
                    <span className="px-3 py-1 bg-white/20 rounded-full text-sm">
                      {company.industry}
                    </span>
                  )}
                  {company.create_date && (
                    <span className="flex items-center gap-1 text-blue-100 text-sm">
                      <Calendar className="w-4 h-4" />
                      {company.create_date}
                    </span>
                  )}
                </div>
              </div>
            </div>
          </div>

          {/* 内容 */}
          <div className="p-8">
            {/* 联系信息网格 */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
              {company.legal_representative && (
                <div className="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                  <div className="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                    <User className="w-6 h-6 text-blue-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">法定代表人</p>
                    <p className="font-semibold text-gray-800">{company.legal_representative}</p>
                  </div>
                </div>
              )}
              
              {company.phone && (
                <div className="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                  <div className="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                    <Phone className="w-6 h-6 text-green-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">联系电话</p>
                    <p className="font-semibold text-gray-800">{company.phone}</p>
                  </div>
                </div>
              )}
              
              {company.email && (
                <div className="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                  <div className="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                    <Mail className="w-6 h-6 text-purple-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">电子邮箱</p>
                    <p className="font-semibold text-gray-800">{company.email}</p>
                  </div>
                </div>
              )}
              
              {company.website && (
                <div className="flex items-center gap-4 p-4 bg-gray-50 rounded-xl">
                  <div className="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
                    <Globe className="w-6 h-6 text-orange-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">官方网站</p>
                    <a href={company.website} target="_blank" rel="noopener noreferrer" className="font-semibold text-blue-600 hover:underline">
                      {company.website}
                    </a>
                  </div>
                </div>
              )}
              
              {company.address && (
                <div className="flex items-center gap-4 p-4 bg-gray-50 rounded-xl md:col-span-2">
                  <div className="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
                    <MapPin className="w-6 h-6 text-red-600" />
                  </div>
                  <div>
                    <p className="text-sm text-gray-500">公司地址</p>
                    <p className="font-semibold text-gray-800">{company.address}</p>
                  </div>
                </div>
              )}
            </div>

            {/* 公司简介 */}
            {company.description && (
              <div className="border-t border-gray-100 pt-8">
                <h2 className="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                  <Building2 className="w-6 h-6 text-blue-600" />
                  公司简介
                </h2>
                <div className="prose prose-gray max-w-none bg-gray-50 rounded-xl p-6">
                  <p className="text-gray-700 whitespace-pre-wrap leading-relaxed">{company.description}</p>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}

export default CompanyInfo
