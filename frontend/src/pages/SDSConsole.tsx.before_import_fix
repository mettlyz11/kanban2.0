import React, { useState, useRef, useEffect, useCallback } from 'react'
import { useRealtimeWS } from '../hooks/useRealtimeWS'

// ─── Types ───
interface V { cpu:number; mem:number; disk:number; up:number; proc:number }
interface Stats { pending:number; in_progress:number; completed:number; failed:number; blocked:number; total:number }
interface LLMS { total_calls:number; ok_calls:number; failed_calls:number; success_rate:number; avg_latency:number; by_provider:Record<string,number>; by_model:Record<string,number> }
interface RevS { total:number; passed:number; rejected:number; fast_pass:number; pass_rate:number; by_reviewer:Record<string,{passed:number;rejected:number;fast_pass:number;total:number}> }
interface TP { hourly:number[]; daily:Record<string,number>; avg_completion_sec:number; today_completed:number }
interface DBH { connections:number; slow_queries:number; uptime_sec:number; health_score:number }
interface ErrAgg { by_type:Record<string,number>; total:number; recent:string[] }
interface SubS { total_runs:number; completed:number; success_rate:number; by_type:Record<string,{total:number;completed:number;avg_time_sec:number}> }
interface MC { primary_model?:string; fallbacks?:string[]; providers_count:number; models_count:number }
interface Task { task_id:number; step_tag:string; detail:string; status:string; ts:string }

// ─── Helpers ───
const bg=(p:number)=>p>90?'#ef4444':p>70?'#f59e0b':'#22c55e'
const upt=(s:number)=>`${Math.floor(s/86400)}d ${Math.floor((s%86400)/3600)}h ${Math.floor((s%3600)/60)}m`
const MAX=60

// ─── Sparkline ───
const Sp: React.FC<{d:number[];c?:string}> = ({d,c='#3b82f6'})=>{
  if(d.length<2)return<svg width={100} height={28}><text x={50} y={18} textAnchor="middle" fill="#333" fontSize={10}>waiting...</text></svg>
  const w=100,h=28,mn=Math.min(...d),mx=Math.max(...d),r=mx-mn||1
  const pts=d.map((v,i)=>`${(i/(d.length-1))*w},${h-((v-mn)/r)*(h-4)-2}`).join(' ')
  return<svg width={w} height={h}><polyline points={pts} fill="none" stroke={c} strokeWidth={1.5} strokeLinecap="round" strokeLinejoin="round"/><text x={w-4} y={10} textAnchor="end" fill={c} fontSize={10} fontWeight={600}>{d[d.length-1]}%</text></svg>
}

// ─── Bar Chart ───
const Bar: React.FC<{d:number[];h?:number;c?:string}> = ({d,h=60,c='#3b82f6'})=>{
  const mx=Math.max(...d,1),gap=1,bw=(120-d.length*gap)/d.length
  return<svg width={120} height={h}>
    {d.map((v,i)=><rect key={i} x={i*(bw+gap)} y={h-(v/mx)*(h-8)-4} width={bw} height={Math.max((v/mx)*(h-8),2)} fill={c} rx={1} opacity={0.8}/>)}
  </svg>
}

const QC=[{id:'restart_scheduler',l:'⏩ 重启调度',c:'#3b82f6'},{id:'run_review',l:'🕵️ 触发审核',c:'#8b5cf6'},{id:'run_dependency',l:'🔗 依赖巡检',c:'#06b6d4'},{id:'flush_cache',l:'🧹 清缓存',c:'#f59e0b'},{id:'clear_stale_locks',l:'🧹 清锁',c:'#ef4444'},{id:'batch_rerun_failed',l:'🔄 重跑失败',c:'#22c55e'},{id:'trigger_patience',l:'🐢 耐心模式',c:'#f97316'},{id:'sync_config',l:'⚙️ 同步配置',c:'#14b8a6'},{id:'reload_sds_module',l:'🔄 热重载',c:'#ec4899'}]

const SDS: React.FC = () => {
  // ─── State ───
  const [v,setV]=useState<V|null>(null)
  const [st,setSt]=useState<Stats|null>(null)
  const [llm,setLlm]=useState<LLMS|null>(null)
  const [rev,setRev]=useState<RevS|null>(null)
  const [tp,setTp]=useState<TP|null>(null)
  const [dbh,setDbh]=useState<DBH|null>(null)
  const [err,setErr]=useState<ErrAgg|null>(null)
  const [sub,setSub]=useState<SubS|null>(null)
  const [mc,setMc]=useState<MC|null>(null)
  const [tasks,setTasks]=useState<Task[]>([])
  const [evts,setEvts]=useState<{id:string;t:string;s:string;type:string}[]>([])
  const [logs,setLogs]=useState<string[]>([])
  const [logL,setLogL]=useState(true)
  const [actC,setActC]=useState<string|null>(null)
  const [mob,setMob]=useState(window.innerWidth<640)
  const [tab,setTab]=useState<'all'|'stats'|'llm'|'tasks'|'review'|'system'>('all')
  const [expandedErr,setExpandedErr]=useState<string|null>(null)
  const [chartTab,setChartTab]=useState<'cpu'|'mem'|'both'>('both')
  const [clock,setClock]=useState<string>(``)
  const [sproutOnline,setSproutOnline]=useState(false)
  const [sproutStats,setSproutStats]=useState<any>({})
  const [reconnCount,setReconn]=useState(0)
  const [autoScroll,setAutoScroll]=useState(true)
  const [range24h,setRange24h]=useState(false)
  const lastUpd=useRef(Date.now())
  const cpuH=useRef<number[]>([]),memH=useRef<number[]>([]),logE=useRef<HTMLDivElement>(null)

  useEffect(()=>{const f=()=>setMob(window.innerWidth<640);window.addEventListener('resize',f);return ()=>window.removeEventListener('resize',f)},[])
  useEffect(()=>{const t=setInterval(()=>setClock(new Date().toLocaleTimeString('zh-CN',{hour12:false})),5000);setClock(new Date().toLocaleTimeString('zh-CN',{hour12:false}));return ()=>clearInterval(t)},[])
  useEffect(()=>{lastUpd.current=Date.now()},[v,st,llm,rev,tp,dbh,err,sub,tasks])
  useEffect(()=>{err&&err.total>0&&setToast(`🔴 ${err.total}个错误`)},[err])
  useEffect(()=>{if(!isConnected)setReconn(c=>c+1)},[isConnected])
  useEffect(()=>{autoScroll&&logE.current?.scrollIntoView({behavior:'smooth'})},[logs])
  useEffect(()=>{const f=(e:KeyboardEvent)=>{const n=parseInt(e.key);if(n>=1&&n<=9&&QC[n-1])hCmd(QC[n-1].id)};window.addEventListener('keydown',f);return ()=>window.removeEventListener('keydown',f)},[isConnected])
  useEffect(()=>{typeof Notification!=='undefined'&&Notification.permission==='default'&&Notification.requestPermission()},[])

  const addEv=(type:string,s:string,t:string)=>setEvts(p=>[{id:t+Math.random(),t,s,type},...p.slice(0,49)])

  const {isConnected,sendCommand}=useRealtimeWS((ev)=>{
    const t=new Date().toLocaleTimeString('zh-CN',{hour12:false})
    if(ev.event==='metrics'&&ev.data?.metrics){
      const m=ev.data.metrics,cp=m.cpu?.percent||0,me=m.memory?.percent||0
      setV({cpu:cp,mem:me,disk:m.disk?.percent||0,up:m.uptime||0,proc:m.processes||0})
      cpuH.current=[...cpuH.current.slice(-(range24h?299:MAX-1)),cp]
      memH.current=[...memH.current.slice(-(range24h?299:MAX-1)),me]
      if(tab==='all')addEv('metrics',`📊 CPU ${cp}% · MEM ${me}%`,t)
    }
    if(ev.event==='stats_snapshot'&&ev.data){setSt(ev.data as Stats);addEv('stats',`📊 pend=${ev.data.pending} done=${ev.data.completed} fail=${ev.data.failed}`,t)}
    if(ev.event==='llm_stats'&&ev.data){setLlm(ev.data as LLMS);if(ev.data.total_calls>0)addEv('llm',`🤖 ${ev.data.total_calls}次 ${(ev.data.success_rate*100).toFixed(0)}%`,t)}
    if(ev.event==='review_stats'&&ev.data){setRev(ev.data as RevS);if(ev.data.total>0)addEv('review',`🕵️ ${ev.data.total}条 通过${(ev.data.pass_rate*100).toFixed(0)}%`,t)}
    if(ev.event==='task_throughput'&&ev.data){setTp(ev.data as TP);if(ev.data.today_completed>0)addEv('throughput',`📈 今日${ev.data.today_completed} 平${ev.data.avg_completion_sec}s`,t)}
    if(ev.event==='db_health'&&ev.data){setDbh(ev.data as DBH)}
    if(ev.event==='error_aggregation'&&ev.data&&ev.data.total>0){setErr(ev.data as ErrAgg);addEv('error',`🔴 ${ev.data.total}个错误`,t);if(ev.data.total>5&&typeof Notification!=='undefined'&&Notification.permission==='granted')new Notification('SDS 错误',{body:`${ev.data.total}个错误`})}
    if(ev.event==='subagent_stats'&&ev.data){setSub(ev.data as SubS);if(ev.data.total_runs>0)addEv('subagent',`🧬 ${ev.data.total_runs}次 ${(ev.data.success_rate*100).toFixed(0)}%`,t)}
    if(ev.event==='model_config_data'&&ev.data){setMc(ev.data as MC)}
    if(ev.event==='subagent_progress'&&ev.data){const d=ev.data;setTasks(p=>{const ei=p.findIndex(x=>x.task_id===d.task_id);const e:Task={task_id:d.task_id,step_tag:d.step_tag||'',detail:d.detail||'',status:d.status,ts:t};if(ei>=0){const n=[...p];n[ei]=e;return n}return[e,...p.slice(0,19)]});addEv('task',`T${d.task_id} ${d.step_tag||''}`,t)}
    if(ev.event==='review'&&ev.data)addEv('review',`${ev.data.decision==='rejected'?'⛔':'✅'} T${ev.data.task_id} ${ev.data.decision}`,t)
    if(ev.event==='log_tail'&&ev.data?.lines){setLogs(ev.data.lines);setLogL(false)}
  })

  const hCmd=(id:string)=>{if(!isConnected)return;setActC(id);sendCommand(id);addEv('cmd',`🎮 ${id}`,new Date().toLocaleTimeString('zh-CN',{hour12:false}));setTimeout(()=>setActC(null),3000)}

  // ─── Compute derived stats ───
  const healthScore = dbh?.health_score ?? (
    (v&&v.cpu<80?30:0)+(v&&v.mem<80?30:0)+(st&&st.failed<10?20:0)+(st&&st.blocked<5?20:0)
  )
  
  const G=(title?:any,children?:any,opts?:any)=>(
    <div style={{background:'#1e293b',borderRadius:12,border:'1px solid #334155',overflow:'hidden',marginBottom:mob?8:12,...opts}}>
      {title&&<div style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:mob?'8px 10px':'10px 14px',borderBottom:'1px solid #334155',...title.props?.style}}>{title}</div>}
      <div style={{padding:mob?8:12,...opts?.body}}>{children}</div>
    </div>
  )

  const tabs = [
    {id:'all',l:'🏠 概览'},{id:'stats',l:'📊 大盘'},{id:'llm',l:'🤖 LLM'},{id:'tasks',l:'🏃 任务'},{id:'review',l:'🕵️ 审核'},{id:'system',l:'⚙️ 系统'}
  ]

  const sec=(title:string,val:string|number,badge?:string)=>(
    <div style={{background:'#0f172a',borderRadius:8,padding:mob?8:10,textAlign:'center',border:'1px solid #1e293b'}}>
      <div style={{color:'#64748b',fontSize:mob?10:11,marginBottom:2}}>{title}</div>
      <div style={{fontSize:mob?18:24,fontWeight:700,color:'#e2e8f0',fontFamily:'monospace'}}>{val}</div>
      {badge&&<div style={{color:'#475569',fontSize:10,marginTop:2}}>{badge}</div>}
    </div>
  )

  return (
    <div style={{padding:mob?10:20,maxWidth:mob?'100%':1400,margin:'0 auto',background:'#0f172a',minHeight:'calc(100vh-64px)',color:'#e2e8f0',fontSize:mob?13:14}}>
      {/* ───── Header ───── */}
      <div style={{display:'flex',alignItems:'center',gap:8,marginBottom:mob?8:12,flexWrap:'wrap'}}>
        <h1 style={{margin:0,fontSize:mob?16:22,fontWeight:700}}>🖥️ SDS Ultimate</h1>
        <span style={{fontSize:mob?10:11,padding:'2px 8px',borderRadius:4,background:isConnected?'#065f4622':'#7f1d1d22',color:isConnected?'#22c55e':'#ef4444',animation:isConnected?'none':'pulse-wait 1.5s ease-in-out infinite'}}>{isConnected?'● 在线':'○ 离线'}</span>
        {mc&&<span style={{fontSize:10,color:'#475569'}}>{mc.providers_count}个Provider · {mc.models_count}个模型</span>}
        <span style={{color:'#475569',fontSize:9,fontFamily:'monospace',marginLeft:'auto'}}>{clock||new Date().toLocaleTimeString('zh-CN',{hour12:false})}</span>
        <span style={{padding:'2px 6px',borderRadius:4,background:Date.now()-lastUpd.current<60000?'#065f4622':'#7f1d1d22',color:Date.now()-lastUpd.current<60000?'#22c55e':'#ef4444',fontSize:9}}>{(Date.now()-lastUpd.current)/1000>120?'>2m':'<2m'}</span>
        <span style={{color:'#333',fontSize:8}}>WS:{reconnCount}</span>
        <button onClick={()=>{const d={v,st,llm,rev,tp,dbh,err,sub,mc};navigator.clipboard.writeText(JSON.stringify(d,null,2))}} style={{background:'none',border:'none',color:'#475569',cursor:'pointer',fontSize:10,padding:2}}>📋</button>
      </div>

      <style>{'@keyframes pulse-wait{0%,100%{opacity:1}50%{opacity:0.3}}'}</style>
      {/* ───── WS Disconnect Banner ───── */}
      {!isConnected&&<div style={{background:'#7f1d1d',border:'1px solid #ef4444',borderRadius:8,padding:'8px 12px',marginBottom:8,display:'flex',alignItems:'center',gap:8,fontSize:mob?11:13,color:'#fca5a5'}}>
        <span style={{fontSize:18}}>⚠️</span>
        <span>WebSocket 已断开 — 数据不会更新。尝试 <a href="javascript:location.reload()" style={{color:'#fca5a5',textDecoration:'underline',cursor:'pointer'}}>刷新页面</a></span>
      </div>}

      {/* ───── Tabs ───── */}
      <div style={{display:'flex',gap:mob?2:4,marginBottom:mob?8:12,overflowX:'auto',paddingBottom:4}}>
        {tabs.map(t=><button key={t.id} onClick={()=>setTab(t.id as any)}
          style={{padding:mob?'8px 12px':'6px 14px',minHeight:36,border:'none',borderRadius:8,cursor:'pointer',
            background:tab===t.id?'#334155':'transparent',color:tab===t.id?'#e2e8f0':'#64748b',
            fontSize:mob?13:12,fontWeight:600,whiteSpace:'nowrap',transition:'all 0.15s',position:'relative'}}>{t.l}{(t.id==='tasks'&&st&&st.in_progress>0)&&<span style={{position:'absolute',top:0,right:0,background:'#f59e0b',color:'#000',fontSize:8,fontWeight:700,fontFamily:'monospace',padding:'1px 4px',borderRadius:8,lineHeight:'12px'}}>{st.in_progress}</span>}{(t.id==='system'&&st&&st.failed>0)&&<span style={{position:'absolute',top:0,right:0,background:'#ef4444',color:'#fff',fontSize:8,fontWeight:700,fontFamily:'monospace',padding:'1px 4px',borderRadius:8,lineHeight:'12px'}}>{st.failed}</span>}</button>)}
      </div>

      {/* ════════════════════ ALL / OVERVIEW ════════════════════ */}
      {tab==='all'&&<>
        {/* ── 4 Gauge Cards ── */}
        <div style={{display:'grid',gridTemplateColumns:mob?'repeat(2,1fr)':'repeat(4,1fr)',gap:mob?6:10,marginBottom:mob?8:12}}>
          <div style={{background:'#1e293b',borderRadius:12,border:'1px solid #334155',padding:mob?'10px 8px':'14px 12px'}}>
            <div style={{display:'flex',justifyContent:'space-between',marginBottom:4}}>
              <span style={{color:'#94a3b8',fontSize:mob?10:11,fontWeight:600}}>🖥️ 系统健康 {healthScore>80?'💚':healthScore>50?'💛':'❤️'}</span>
              <span style={{fontSize:mob?14:18,fontWeight:700,color:healthScore>80?'#22c55e':healthScore>50?'#f59e0b':'#ef4444',fontFamily:'monospace'}}>{healthScore}</span>
            </div>
            <div style={{height:6,background:'#0f172a',borderRadius:3,overflow:'hidden'}}>
              <div style={{width:`${healthScore}%`,height:'100%',background:`linear-gradient(90deg,${healthScore>80?'#22c55e':healthScore>50?'#f59e0b':'#ef4444'},${healthScore>90?'#4ade80':healthScore>60?'#fbbf24':'#f87171'})`,borderRadius:3,transition:'width 0.5s'}}/>
            </div>
            {dbh&&<div style={{color:'#475569',fontSize:10,marginTop:4}}>{dbh.connections}连接 · {dbh.slow_queries}慢查询</div>}
          </div>
          <div style={{background:'#1e293b',borderRadius:12,border:'1px solid #334155',padding:mob?'10px 8px':'14px 12px'}}>
            <div style={{color:'#94a3b8',fontSize:mob?10:11,fontWeight:600,marginBottom:4}}>📊 今日完成</div>
            <div style={{fontSize:mob?18:24,fontWeight:700,color:'#22c55e',fontFamily:'monospace',animation:tp?undefined:'pulse-wait 1.5s ease-in-out infinite'}}>{tp?.today_completed??'...'}</div>
            <div style={{color:'#475569',fontSize:10,marginTop:2}}>平均{tp?.avg_completion_sec??'...'}s/个</div>
          </div>
          <div style={{background:'#1e293b',borderRadius:12,border:'1px solid #334155',padding:mob?'10px 8px':'14px 12px'}}>
            <div style={{color:'#94a3b8',fontSize:mob?10:11,fontWeight:600,marginBottom:4}}>🤖 LLM 调用</div>
            <div style={{fontSize:mob?18:24,fontWeight:700,color:'#3b82f6',fontFamily:'monospace',animation:llm?undefined:'pulse-wait 1.5s ease-in-out infinite'}}>{llm?.total_calls??'...'}</div>
            <div style={{color:'#475569',fontSize:10,marginTop:2}}>成功率{llm?`${(llm.success_rate*100).toFixed(0)}%`:'...'}</div>
          </div>
          <div style={{background:'#1e293b',borderRadius:12,border:'1px solid #334155',padding:mob?'10px 8px':'14px 12px'}}>
            <div style={{color:'#94a3b8',fontSize:mob?10:11,fontWeight:600,marginBottom:4}}>🧬 子代理运行</div>
            <div style={{fontSize:mob?18:24,fontWeight:700,color:'#8b5cf6',fontFamily:'monospace',animation:sub?undefined:'pulse-wait 1.5s ease-in-out infinite'}}>{sub?.total_runs??'...'}</div>
            <div style={{color:'#475569',fontSize:10,marginTop:2}}>成功率{sub?`${(sub.success_rate*100).toFixed(0)}%`:'...'}</div>
          </div>
        </div>

        {/* ── Stats Badges ── */}
        {st&&<div style={{display:'flex',gap:mob?4:8,marginBottom:mob?8:12,flexWrap:'wrap'}}>
          {[{l:'待处理',v:st.pending,c:'#3b82f6'},{l:'运行中',v:st.in_progress,c:'#f59e0b'},{l:'已完成',v:st.completed,c:'#22c55e'},{l:'失败',v:st.failed,c:'#ef4444'},{l:'阻塞',v:st.blocked,c:'#8b5cf6'}].map(b=><div key={b.l} style={{padding:mob?'4px 10px':'6px 14px',background:'#0f172a',borderRadius:8,border:'1px solid #1e293b',display:'flex',alignItems:'center',gap:6}}>
            <span style={{color:b.c,fontWeight:700,fontFamily:'monospace',fontSize:mob?14:18}}>{b.v}</span>
            <span style={{color:'#64748b',fontSize:mob?10:11}}>{b.l}</span>
          </div>)}
        </div>}

        {/* ── CPU/MEM charts + Stats ── */}
        <div style={{display:'grid',gridTemplateColumns:mob?'1fr':'1.2fr 1fr',gap:mob?0:12,marginBottom:mob?8:12}}>
          <G title={<><span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>📈 实时指标</span></>}>
            <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:8}}>
              {[{l:'CPU',d:cpuH.current,c:'#3b82f6',p:v?.cpu||0},{l:'内存',d:memH.current,c:'#22c55e',p:v?.mem||0}].map(m=><div key={m.l} style={{background:'#0f172a',borderRadius:8,padding:8,border:'1px solid #1e293b'}}>
                <div style={{display:'flex',justifyContent:'space-between',marginBottom:4}}>
                  <span style={{color:'#94a3b8',fontSize:11,fontWeight:600}}>{m.l}</span>
                  <span style={{color:m.c,fontSize:16,fontWeight:700,fontFamily:'monospace'}}>{m.p}%</span>
                </div>
                <Sp d={m.d} c={m.c}/>
                <div style={{height:3,background:'#1e293b',borderRadius:2,marginTop:4,overflow:'hidden'}}>
                  <div style={{width:`${m.p}%`,height:'100%',background:m.c,borderRadius:2,transition:'width 0.5s'}}/>
                </div>
              </div>)}
            </div>
            <div style={{display:'flex',gap:4,marginTop:4,justifyContent:'flex-end'}}>
              <button onClick={()=>setRange24h(!range24h)} style={{padding:'2px 8px',border:'1px solid #334155',borderRadius:4,cursor:'pointer',background:range24h?'#334155':'transparent',color:range24h?'#e2e8f0':'#64748b',fontSize:10,fontWeight:600}}>{range24h?'24h':'5min'}</button>
            </div>
            {v&&<div style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:6,marginTop:8}}>
              <div style={{textAlign:'center',color:'#475569',fontSize:10}}><span style={{color:'#64748b'}}>磁盘</span><br/><span style={{color:bg(v.disk),fontWeight:600,fontFamily:'monospace'}}>{v.disk}%</span></div>
              <div style={{textAlign:'center',color:'#475569',fontSize:10}}><span style={{color:'#64748b'}}>进程</span><br/><span style={{color:'#64748b',fontWeight:600,fontFamily:'monospace'}}>{v.proc}</span></div>
              <div style={{textAlign:'center',color:'#475569',fontSize:10}}><span style={{color:'#64748b'}}>运行</span><br/><span style={{color:'#64748b',fontWeight:600,fontFamily:'monospace'}}>{upt(v.up)}</span></div>
              <div style={{textAlign:'center',color:'#475569',fontSize:10}}><span style={{color:'#64748b'}}>DB</span><br/><span style={{color:dbh?'#22c55e':'#475569',fontWeight:600,fontFamily:'monospace'}}>{dbh?.connections??'?'}</span></div>
            </div>}
          </G>

          <G title={<><span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>📊 大盘</span></>}>
            <div style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:mob?4:6}}>
              {[
                {l:'待处理',v:st?.pending??'...',c:'#3b82f6'},{l:'运行中',v:st?.in_progress??'...',c:'#f59e0b'},
                {l:'已完成',v:st?.completed??'...',c:'#22c55e'},{l:'失败',v:st?.failed??'...',c:'#ef4444'},
                {l:'阻塞',v:st?.blocked??'...',c:'#8b5cf6'},{l:'总计',v:st?.total??'...',c:'#64748b'},
              ].map(m=><div key={m.l} style={{backgroundColor:'#0f172a',borderRadius:6,padding:'8px 4px',textAlign:'center',border:'1px solid #1e293b'}}>
                <div style={{color:'#64748b',fontSize:mob?9:10,marginBottom:2}}>{m.l}</div>
                <div style={{fontSize:mob?16:20,fontWeight:700,color:m.c,fontFamily:'monospace'}}>{m.v}</div>
              </div>)}
            </div>
            {tp&&<div style={{marginTop:8}}>
