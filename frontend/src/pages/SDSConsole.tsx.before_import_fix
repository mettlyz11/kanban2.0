      {tab==='review'&&<>
        {rev?<>
          <div style={{display:'grid',gridTemplateColumns:mob?'repeat(2,1fr)':'repeat(4,1fr)',gap:mob?6:10,marginBottom:12}}>
            {sec('审核总数',rev.total,'24h'),sec('通过',rev.passed,`${(rev.passed/rev.total*100).toFixed(0)}%`),sec('驳回',rev.rejected,`${(rev.rejected/rev.total*100).toFixed(0)}%`),sec('快速通过',rev.fast_pass)}
          </div>
          <G title={<span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>🎯 通过率</span>}>
            <div style={{display:'flex',alignItems:'center',gap:12}}>
              <div style={{flex:1}}>
                <div style={{height:24,background:'#0f172a',borderRadius:12,overflow:'hidden',display:'flex'}}>
                  {rev.passed>0&&<div style={{flex:rev.passed,background:'#22c55e',display:'flex',alignItems:'center',justifyContent:'center',fontSize:11,fontWeight:600,color:'#fff',minWidth:40}}>通过 {(rev.passed/rev.total*100).toFixed(0)}%</div>}
                  {rev.fast_pass>0&&<div style={{flex:rev.fast_pass,background:'#06b6d4',display:'flex',alignItems:'center',justifyContent:'center',fontSize:11,fontWeight:600,color:'#fff',minWidth:40}}>快过 {(rev.fast_pass/rev.total*100).toFixed(0)}%</div>}
                  {rev.rejected>0&&<div style={{flex:rev.rejected,background:'#ef4444',display:'flex',alignItems:'center',justifyContent:'center',fontSize:11,fontWeight:600,color:'#fff'}}>驳回 {(rev.rejected/rev.total*100).toFixed(0)}%</div>}
                </div>
              </div>
            </div>
          </G>
          {Object.keys(rev.by_reviewer).length>0&&<G title={<span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>👤 审核官表现</span>}>
            {Object.entries(rev.by_reviewer).map(([k,v],i)=><div key={k} style={{padding:'8px 0',borderBottom:i<Object.keys(rev.by_reviewer).length-1?'1px solid #334155':'none'}}>
              <div style={{display:'flex',justifyContent:'space-between',marginBottom:4}}>
                <span style={{color:'#e2e8f0',fontWeight:600,fontSize:12}}>🕵️ {k}</span>
                <span style={{color:'#94a3b8',fontFamily:'monospace'}}>{v.total}条</span>
              </div>
              <div style={{display:'flex',gap:8,fontSize:11}}>
                <span style={{color:'#22c55e'}}>✅ {v.passed}</span>
                <span style={{color:'#ef4444'}}>❌ {v.rejected}</span>
                <span style={{color:'#06b6d4'}}>🏃 {v.fast_pass}</span>
                <span style={{color:'#64748b'}}>通过率{(v.passed/(v.total||1)*100).toFixed(0)}%</span>
              </div>
              <div style={{height:3,background:'#0f172a',borderRadius:2,marginTop:4,overflow:'hidden',display:'flex'}}>
                {v.passed>0&&<div style={{flex:v.passed,background:'#22c55e'}}/>}
                {v.rejected>0&&<div style={{flex:v.rejected,background:'#ef4444'}}/>}
                {v.fast_pass>0&&<div style={{flex:v.fast_pass,background:'#06b6d4'}}/>}
              </div>
            </div>)}
          </G>}
        </>:<div style={{textAlign:'center',color:'#333',padding:40,fontSize:13}}>等待审核统计数据推送 (每5min)...</div>}
      </>}

      {/* ════════════════════ SYSTEM TAB ════════════════════ */}
      {tab==='system'&&<>
        <div style={{display:'grid',gridTemplateColumns:mob?'1fr':'1fr 1fr',gap:mob?0:12,marginBottom:12}}>
          <G title={<><span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>⚙️ 系统信息</span><span style={{fontSize:10,color:'#475569',cursor:'pointer'}} onClick={()=>{const t=Date.now();setScreenshot(`http://127.0.0.1:18794/screen?_=${t}`)}}>📷 截屏</span></>}>
            <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:8}}>
              {[
                {l:'CPU',v:v?`${v.cpu}%`:'...',c:bg(v?.cpu??0)},
                {l:'内存',v:v?`${v.mem}%`:'...',c:bg(v?.mem??0)},
                {l:'磁盘',v:v?`${v.disk}%`:'...',c:bg(v?.disk??0)},
                {l:'运行时间',v:v?upt(v.up):'...',c:'#64748b'},
                {l:'进程数',v:v?.proc??'...',c:'#64748b'},
                {l:'DB连接',v:dbh?.connections??'...',c:'#64748b'},
                {l:'慢查询',v:dbh?.slow_queries??'...',c:dbh&&dbh.slow_queries>0?'#f59e0b':'#22c55e'},
                {l:'DB健康',v:dbh?`${dbh.health_score}分`:'...',c:'#64748b'},
              ].map(m=><div key={m.l} style={{display:'flex',justifyContent:'space-between',padding:'6px 8px',background:'#0f172a',borderRadius:6,border:'1px solid #1e293b'}}>
                <span style={{color:'#64748b',fontSize:11}}>{m.l}</span>
                <span style={{color:m.c,fontWeight:600,fontFamily:'monospace',fontSize:12}}>{m.v}</span>
              </div>)}
            <div style={{textAlign:'center',color:'#475569',fontSize:9,marginTop:8}}>推送:metrics=5s / stats=5min</div>
            <div style={{textAlign:'center',color:'#475569',fontSize:9}}>数据: {Math.round((Date.now()-lastUpd.current)/1000)}s前</div>
          </div>
          </G>
          <G title={<span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>🧠 模型配置</span>}>
            {mc?<div>
              <div style={{display:'flex',gap:12,marginBottom:8}}>
                <div style={{background:'#0f172a',borderRadius:8,padding:'8px 12px',border:'1px solid #1e293b'}}>
                  <div style={{color:'#64748b',fontSize:10}}>主模型</div>
                  <div style={{color:'#3b82f6',fontSize:13,fontWeight:600,fontFamily:'monospace',marginTop:2}}>{mc.primary_model??'-'}</div>
                </div>
                <div style={{background:'#0f172a',borderRadius:8,padding:'8px 12px',border:'1px solid #1e293b'}}>
                  <div style={{color:'#64748b',fontSize:10}}>Prov/模型</div>
                  <div style={{color:'#e2e8f0',fontSize:13,fontWeight:600,fontFamily:'monospace',marginTop:2}}>{mc.providers_count}/{mc.models_count}</div>
                </div>
              </div>
              {mc.fallbacks&&mc.fallbacks.length>0&&<div>
                <div style={{color:'#94a3b8',fontSize:11,fontWeight:600,marginBottom:4}}>Fallback 链:</div>
                <div style={{display:'flex',gap:4,flexWrap:'wrap'}}>
                  {mc.fallbacks.map((f,i)=><span key={i} style={{padding:'2px 8px',background:'#0f172a',borderRadius:4,border:'1px solid #1e293b',color:'#64748b',fontSize:10}}>
                    {i>0&&<span style={{color:'#333',marginRight:2}}>→</span>}{f}
                  </span>)}
                </div>
              </div>}
            </div>:<div style={{color:'#333',fontSize:11,padding:16,textAlign:'center'}}>等待模型配置...</div>}
          </G>
        </div>
        {screenshot&&<div style={{marginBottom:12}}>
          <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:4}}>
            <span style={{color:'#94a3b8',fontSize:11,fontWeight:600}}>🖼️ 实时桌面</span>
            <button onClick={()=>setScreenshot(null)} style={{background:'none',border:'none',color:'#475569',cursor:'pointer',fontSize:12}}>✕</button>
          </div>
          <img src={screenshot} style={{width:'100%',borderRadius:8,border:'1px solid #334155',maxHeight:mob?200:400,objectFit:'contain'}}/>
        </div>}
        <G title={<span style={{color:'#94a3b8',fontSize:13,fontWeight:600}}>🔴 错误日志分析</span>}>
          {err?<div style={{display:'flex',flexWrap:'wrap',gap:8}}>
            {Object.entries(err.by_type).sort((a,b)=>b[1]-a[1]).map(([k,v])=><div key={k} style={{padding:'8px 14px',background:'#0f172a',borderRadius:8,border:'1px solid #1e293b',textAlign:'center',cursor:'pointer'}} onClick={()=>setExpandedErr(expandedErr===k?null:k)}>
              <div style={{color:'#ef4444',fontSize:18,fontWeight:700,fontFamily:'monospace'}}>{v}</div>
              <div style={{color:'#64748b',fontSize:10,marginTop:2}}>{k}</div>
              {expandedErr===k&&err.recent&&<div style={{marginTop:6,paddingTop:6,borderTop:'1px solid #1e293b',maxHeight:120,overflowY:'auto',textAlign:'left'}}>
                {err.recent.map((rl,i)=><div key={i} style={{color:'#94a3b8',fontSize:9,fontFamily:'monospace',marginBottom:2,whiteSpace:'nowrap',overflow:'hidden',textOverflow:'ellipsis'}}>{rl}</div>)}
              </div>}
            </div>)}
            {err.total===0&&<div style={{color:'#22c55e',padding:8,fontSize:12}}>✅ 暂无错误</div>}
          </div>:<div style={{color:'#333',fontSize:11,padding:16,textAlign:'center'}}>等待错误数据...</div>}
        </G>
      </>}
    </div>
  )
}
export default SDS

