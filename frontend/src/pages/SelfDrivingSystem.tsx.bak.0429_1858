import { useState, useEffect, useCallback } from 'react'

interface SdsStats {
  pending: number
  running: number
  completed: number
  failed: number
  failed_retryable: number
  archived: number
}

interface GoalConfig {
  id: number
  title: string
  description: string
  category: string
  status: string
  project_count: number
}

interface ProjectConfig {
  id: number
  name: string
  number: string
  description: string
  status: string
  priority: string
  goal_id: number
  goal_title: string | null
}

interface ScriptInfo {
  path: string
  description: string
}

interface CronJob {
  name: string
  schedule: string
  command: string
  description: string
}

interface SdsCoreConfig {
  version: string
  cycle_interval_minutes: number
  max_concurrent_tasks: number
  quality_gates: {
    execution_log_min_chars: number
    result_summary_min_chars: number
  }
  triple_guards: Record<string, any>
  smart_retry: Record<string, string>
  zombie_detection: Record<string, string>
  heartbeat_schedule: Record<string, string>
}

export default function SelfDrivingSystem() {
  const [activeTab, setActiveTab] = useState('dashboard')
  const [loading, setLoading] = useState(true)
  
  // Data states
  const [stats, setStats] = useState<SdsStats | null>(null)
  const [goals, setGoals] = useState<GoalConfig[]>([])
  const [projects, setProjects] = useState<ProjectConfig[]>([])
  const [sdsCore, setSdsCore] = useState<SdsCoreConfig | null>(null)
  const [cronJobs, setCronJobs] = useState<CronJob[]>([])
  const [scripts, setScripts] = useState<ScriptInfo[]>([])
  const [goalDefs, setGoalDefs] = useState<Record<string, any>>({})
  const [recoverySteps, setRecoverySteps] = useState<string[]>([])
  const [dbSchemas, setDbSchemas] = useState<Record<string, string>>({})
  const [exportData, setExportData] = useState<string>('')

  const fetchConfig = useCallback(async (key: string) => {
    try {
      const res = await fetch(`/api/sds/config/${key}`)
      const json = await res.json()
      if (json.success) {
        return typeof json.data === 'string' ? JSON.parse(json.data) : json.data
      }
    } catch (e) {
      console.error(`Failed to fetch ${key}:`, e)
    }
    return null
  }, [])

  useEffect(() => {
    const loadData = async () => {
      // Fetch stats
      try {
        const res = await fetch('/api/sds/stats')
        const json = await res.json()
        if (json.success) {
          const ts = json.data.task_stats || {}
          setStats({
            pending: ts.pending || 0,
            running: ts.in_progress || 0,
            completed: ts.completed || 0,
            failed: (ts.failed || 0) + (ts.failed_retryable || 0),
            failed_retryable: ts.failed_retryable || 0,
            archived: ts.archived || 0
          })
        }
      } catch (e) { console.error('Stats fetch failed:', e) }

      // Fetch all configs in parallel
      const [goalsData, projectsData, coreData, cronData, scriptsData, goalDefsData, recoveryData, allData] = await Promise.all([
        fetchConfig('goals_config'),
        fetchConfig('projects_config'),
        fetchConfig('sds_core_config'),
        fetchConfig('cron_jobs'),
        fetchConfig('scripts'),
        fetchConfig('goals_config').then(d => d?.definitions || {}),
        fetchConfig('recovery_instructions'),
        fetchConfig('metadata'),
      ])

      if (goalsData?.goals) setGoals(goalsData.goals)
      if (projectsData?.all_projects) setProjects(projectsData.all_projects)
      if (coreData) setSdsCore(coreData)
      if (cronData) setCronJobs(cronData)
      if (scriptsData) setScripts(scriptsData)
      if (goalDefsData) setGoalDefs(goalDefsData)
      if (recoveryData?.full_reset_steps) setRecoverySteps(recoveryData.full_reset_steps)
      if (recoveryData?.database_schema) setDbSchemas(recoveryData.database_schema)

      // Build export JSON
      if (allData) {
        setExportData(JSON.stringify(allData, null, 2))
      }

      setLoading(false)
    }
    loadData()
  }, [fetchConfig])

  const handleDownloadConfig = () => {
    const blob = new Blob([exportData], { type: 'application/json' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `sds-system-config-${new Date().toISOString().slice(0,10)}.json`
    a.click()
    URL.revokeObjectURL(url)
  }

  const handleCopyConfig = async () => {
    try {
      await navigator.clipboard.writeText(exportData)
      alert('✅ 配置已复制到剪贴板')
    } catch (e) {
      alert('❌ 复制失败')
    }
  }

  const renderDashboard = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📊 SDS 系统概览</h2>
      
      {/* 系统状态 */}
      <div style={{
        background: '#d4edda',
        padding: 16,
        borderRadius: 8,
        marginBottom: 20,
        display: 'flex',
        alignItems: 'center',
        gap: 12
      }}>
        <span style={{
          width: 12, height: 12, borderRadius: '50%', background: '#28a745',
          animation: 'pulse 2s infinite'
        }} />
        <span style={{ fontWeight: 600 }}>SDS v{sdsCore?.version || '4.6'} 系统运行中</span>
        {loading && <span style={{ color: '#666', marginLeft: 8 }}>加载中...</span>}
      </div>

      {/* 统计卡片 */}
      <div style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))',
        gap: 12,
        marginBottom: 24
      }}>
        {[
          { label: '待执行', value: stats?.pending || 0, color: '#ffd93d' },
          { label: '执行中', value: stats?.running || 0, color: '#4d96ff' },
          { label: '已完成', value: stats?.completed || 0, color: '#28a745' },
          { label: '失败', value: stats?.failed || 0, color: '#ff6b6b' },
          { label: '已归档', value: stats?.archived || 0, color: '#6c757d' },
        ].map(card => (
          <div key={card.label} style={{
            background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8,
            padding: 16, textAlign: 'center'
          }}>
            <div style={{ fontSize: 24, fontWeight: 700, color: card.color }}>{card.value}</div>
            <div style={{ fontSize: 12, color: '#666', marginTop: 4 }}>{card.label}</div>
          </div>
        ))}
      </div>

      {/* 目标分布 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14, color: '#333' }}>🎯 战略目标分布</h3>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: 8 }}>
          {goals.map(g => (
            <div key={g.id} style={{ padding: 8, background: '#f8f9fa', borderRadius: 4 }}>
              <strong>G{g.id}</strong>: {g.title}
              <span style={{ float: 'right', color: '#667eea', fontWeight: 600 }}>
                {g.project_count || 0}个项目
              </span>
            </div>
          ))}
        </div>
      </div>

      {/* SDS核心配置 */}
      {sdsCore && (
        <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
          <h3 style={{ marginBottom: 12, fontSize: 14, color: '#333' }}>⚙️ SDS核心配置</h3>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(180px, 1fr))', gap: 8, fontSize: 13 }}>
            <div>🔄 周期: <strong>{sdsCore.cycle_interval_minutes}分钟</strong></div>
            <div>👥 最大并发: <strong>{sdsCore.max_concurrent_tasks}</strong></div>
            <div>📝 execution_log: <strong>≥{sdsCore.quality_gates?.execution_log_min_chars}字</strong></div>
            <div>📋 result_summary: <strong>≥{sdsCore.quality_gates?.result_summary_min_chars}字</strong></div>
          </div>
        </div>
      )}
    </div>
  )

  const renderGoals = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>🎯 目标配置</h2>
      <p style={{ color: '#666', marginBottom: 16 }}>7大战略目标配置 - 系统恢复时自动重建</p>
      {goals.map(g => {
        const def = goalDefs[String(g.id)] || {}
        return (
          <div key={g.id} style={{
            background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8,
            padding: 16, marginBottom: 12
          }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
              <h3 style={{ margin: 0, fontSize: 16 }}>G{g.id}: {g.title}</h3>
              <span style={{
                background: def.priority === 'P1' ? '#fee2e2' : def.priority === 'P2' ? '#fef3c7' : '#d1fae5',
                color: def.priority === 'P1' ? '#dc2626' : def.priority === 'P2' ? '#d97706' : '#059669',
                padding: '2px 8px', borderRadius: 4, fontSize: 12, fontWeight: 600
              }}>{def.priority || 'P2'}</span>
            </div>
            <p style={{ margin: '4px 0 8px', fontSize: 13, color: '#666' }}>{g.description}</p>
            <div style={{ fontSize: 12, color: '#888' }}>
              <strong>核心项目:</strong> {(def.key_projects || []).join('、') || '暂无'}
            </div>
            <div style={{ fontSize: 12, color: '#888', marginTop: 4 }}>
              <strong>任务规则:</strong> {def.task_generation_rules || '暂无'}
            </div>
          </div>
        )
      })}
    </div>
  )

  const renderTasks = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📋 任务规则</h2>
      {sdsCore && (
        <>
          {/* 三重保障 */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
            <h3 style={{ marginBottom: 12, fontSize: 14 }}>🛡️ 三重保障系统</h3>
            <div style={{ fontSize: 13, lineHeight: 1.8 }}>
              <div><strong>1. 幂等性保障:</strong> 相同标题+目标的任务只生成一次</div>
              <div><strong>2. 频率限制:</strong> 每目标每24h最多{sdsCore.triple_guards?.['2_rate_limit']?.max_new_per_goal_per_24h || 2}个新任务，pending最多{sdsCore.triple_guards?.['2_rate_limit']?.max_pending_per_goal || 3}个</div>
              <div><strong>3. 语义去重:</strong> Levenshtein相似度阈值{sdsCore.triple_guards?.['3_semantic_dedup']?.threshold || 0.85}</div>
            </div>
          </div>

          {/* 智能重试 */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
            <h3 style={{ marginBottom: 12, fontSize: 14 }}>⚡ 智能重试策略</h3>
            {Object.entries(sdsCore.smart_retry || {}).map(([k, v]) => (
              <div key={k} style={{ fontSize: 13, marginBottom: 4 }}>
                <strong>{k}:</strong> {v as string}
              </div>
            ))}
          </div>

          {/* 僵尸检测 */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
            <h3 style={{ marginBottom: 12, fontSize: 14 }}>🧟 僵尸任务检测</h3>
            {Object.entries(sdsCore.zombie_detection || {}).map(([k, v]) => (
              <div key={k} style={{ fontSize: 13, marginBottom: 4 }}>
                <strong>{k}:</strong> {v as string}
              </div>
            ))}
          </div>

          {/* 质量门控 */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
            <h3 style={{ marginBottom: 12, fontSize: 14 }}>✅ 质量门控标准</h3>
            <table style={{ width: '100%', fontSize: 13, borderCollapse: 'collapse' }}>
              <thead>
                <tr style={{ borderBottom: '1px solid #e5e7eb' }}>
                  <th style={{ textAlign: 'left', padding: 8 }}>字段</th>
                  <th style={{ textAlign: 'left', padding: 8 }}>最低要求</th>
                </tr>
              </thead>
              <tbody>
                <tr><td style={{ padding: 8 }}>execution_log</td><td style={{ padding: 8 }}>≥{sdsCore.quality_gates?.execution_log_min_chars}字</td></tr>
                <tr><td style={{ padding: 8 }}>result_summary</td><td style={{ padding: 8 }}>≥{sdsCore.quality_gates?.result_summary_min_chars}字</td></tr>
              </tbody>
            </table>
          </div>
        </>
      )}
    </div>
  )

  const renderProjects = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📁 项目阈值</h2>
      <p style={{ color: '#666', marginBottom: 16 }}>共{projects.length}个活跃项目 - 按目标分组</p>
      {goals.map(g => {
        const goalProjects = projects.filter(p => p.goal_id === g.id)
        if (goalProjects.length === 0) return null
        return (
          <div key={g.id} style={{ marginBottom: 16 }}>
            <h3 style={{ fontSize: 14, color: '#667eea', marginBottom: 8 }}>
              G{g.id}: {g.title} ({goalProjects.length}个项目)
            </h3>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))', gap: 8 }}>
              {goalProjects.map(p => (
                <div key={p.id} style={{
                  padding: 10, background: '#f8f9fa', borderRadius: 6,
                  border: '1px solid #e5e7eb', fontSize: 13
                }}>
                  <div style={{ fontWeight: 600 }}>{p.number} {p.name}</div>
                  <div style={{ color: '#666', fontSize: 12, marginTop: 2 }}>{p.description || '暂无描述'}</div>
                  <div style={{ marginTop: 4 }}>
                    <span style={{
                      background: p.status === 'active' ? '#d1fae5' : p.status === 'todo' ? '#fef3c7' : '#fee2e2',
                      color: p.status === 'active' ? '#059669' : p.status === 'todo' ? '#d97706' : '#dc2626',
                      padding: '1px 6px', borderRadius: 3, fontSize: 11, marginRight: 4
                    }}>{p.status}</span>
                    <span style={{
                      background: p.priority === 'high' ? '#fee2e2' : p.priority === 'medium' ? '#fef3c7' : '#e5e7eb',
                      color: p.priority === 'high' ? '#dc2626' : p.priority === 'medium' ? '#d97706' : '#6b7280',
                      padding: '1px 6px', borderRadius: 3, fontSize: 11
                    }}>{p.priority}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      })}
    </div>
  )

  const renderRealtime = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📡 实时监控</h2>
      
      {/* SDS仪表盘iframe */}
      <div style={{ marginBottom: 16 }}>
        <h3 style={{ fontSize: 14, marginBottom: 8 }}>📈 SDS HTML仪表盘</h3>
        <iframe
          src="/output/task-1570/sds-dashboard.html"
          style={{ width: '100%', height: 500, border: '1px solid #e5e7eb', borderRadius: 8 }}
          title="SDS Dashboard"
        />
      </div>

      {/* Cron Jobs */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>⏰ 定时任务</h3>
        {cronJobs.map((job, i) => (
          <div key={i} style={{
            padding: 10, background: '#f8f9fa', borderRadius: 6, marginBottom: 8,
            border: '1px solid #e5e7eb'
          }}>
            <div style={{ fontWeight: 600, fontSize: 13 }}>{job.name}</div>
            <div style={{ fontSize: 12, color: '#666', marginTop: 2 }}>
              🕐 {job.schedule}
            </div>
            <code style={{ fontSize: 11, color: '#3b82f6', display: 'block', marginTop: 4, background: '#eef2ff', padding: 4, borderRadius: 3 }}>
              {job.command}
            </code>
            <div style={{ fontSize: 12, color: '#888', marginTop: 4 }}>{job.description}</div>
          </div>
        ))}
      </div>
    </div>
  )

  const renderHistory = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📈 历史趋势</h2>
      
      {/* 任务状态统计 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>📊 任务状态分布</h3>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))', gap: 8 }}>
          {[
            { label: 'pending', value: stats?.pending || 0, color: '#ffd93d' },
            { label: 'in_progress', value: stats?.running || 0, color: '#4d96ff' },
            { label: 'completed', value: stats?.completed || 0, color: '#28a745' },
            { label: 'failed', value: stats?.failed || 0, color: '#ff6b6b' },
            { label: 'failed_retryable', value: stats?.failed_retryable || 0, color: '#f97316' },
            { label: 'archived', value: stats?.archived || 0, color: '#6c757d' },
          ].map(s => (
            <div key={s.label} style={{
              padding: 12, background: '#f8f9fa', borderRadius: 6, textAlign: 'center'
            }}>
              <div style={{ fontSize: 20, fontWeight: 700, color: s.color }}>{s.value}</div>
              <div style={{ fontSize: 12, color: '#666' }}>{s.label}</div>
            </div>
          ))}
        </div>
      </div>

      {/* 目标任务统计 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>🎯 各目标任务统计</h3>
        <div style={{ fontSize: 13, lineHeight: 1.8 }}>
          {goals.map(g => (
            <div key={g.id} style={{ padding: 4, borderBottom: '1px solid #f0f0f0' }}>
              <strong>G{g.id}</strong> {g.title}: {g.project_count || 0}个项目
            </div>
          ))}
        </div>
      </div>
    </div>
  )

  const renderArchitecture = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>🏗️ 架构编辑</h2>
      
      {/* 系统架构 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>📐 SDS系统架构</h3>
        <pre style={{
          background: '#f8f9fa', padding: 12, borderRadius: 6, fontSize: 12,
          overflow: 'auto', maxHeight: 400, lineHeight: 1.6
        }}>
{`SDS v4.6 自我驱动系统
├── core/                          # 核心模块
│   ├── task_generation_guard_v46.py  # 三重保障核心
│   ├── execution_evaluator.py        # 执行质量评估器
│   └── tavily_research.py            # Research驱动引擎
├── modules/                       # 功能模块
│   ├── auto_task_generator_v46.py  # 自动任务生成器
│   ├── subagent_scheduler.py       # 子代理调度器
│   ├── task_analyzer.py            # 任务分析器
│   ├── observability_dashboard.py  # 可视化仪表盘
│   ├── safety_guardrails.py        # 安全护栏系统
│   └── monitoring_72h.py           # 72小时无人值守监控
├── tools/                         # 工具脚本
│   ├── kanban_task_manager.py      # Kanban任务管理
│   ├── check_sds_status.py         # SDS状态检查
│   └── sds-dashboard.py            # 仪表盘生成
└── sds_main.py                    # 主入口

数据流:
  任务分析 → 任务生成(三重保障) → 子代理调度 → 结果验证 → 仪表盘更新
      ↑____________ 30分钟周期循环 ____________↓`}
        </pre>
      </div>

      {/* 脚本清单 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>📜 核心脚本清单 ({scripts.length}个)</h3>
        <table style={{ width: '100%', fontSize: 12, borderCollapse: 'collapse' }}>
          <thead>
            <tr style={{ borderBottom: '2px solid #e5e7eb' }}>
              <th style={{ textAlign: 'left', padding: 6 }}>路径</th>
              <th style={{ textAlign: 'left', padding: 6 }}>说明</th>
            </tr>
          </thead>
          <tbody>
            {scripts.map((s, i) => (
              <tr key={i} style={{ borderBottom: '1px solid #f0f0f0' }}>
                <td style={{ padding: 6, fontFamily: 'monospace', color: '#3b82f6' }}>{s.path}</td>
                <td style={{ padding: 6, color: '#666' }}>{s.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )

  const renderDocuments = () => (
    <div>
      <h2 style={{ marginBottom: 20 }}>📄 文档管理</h2>
      
      {/* 一键导出 */}
      <div style={{ background: '#eff6ff', border: '1px solid #bfdbfe', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 8, fontSize: 14, color: '#1e40af' }}>🔄 系统完全恢复</h3>
        <p style={{ fontSize: 13, color: '#1e40af', marginBottom: 12 }}>
          导出完整SDS配置JSON。即使Mac mini被完全重置，也可从此配置恢复所有目标、项目、任务规则和脚本清单。
        </p>
        <div style={{ display: 'flex', gap: 8 }}>
          <button onClick={handleDownloadConfig} style={{
            padding: '8px 16px', background: '#3b82f6', color: '#fff', border: 'none',
            borderRadius: 6, cursor: 'pointer', fontSize: 13, fontWeight: 600
          }}>📥 下载配置JSON</button>
          <button onClick={handleCopyConfig} style={{
            padding: '8px 16px', background: '#10b981', color: '#fff', border: 'none',
            borderRadius: 6, cursor: 'pointer', fontSize: 13, fontWeight: 600
          }}>📋 复制到剪贴板</button>
        </div>
      </div>

      {/* 恢复步骤 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>📖 系统恢复步骤</h3>
        <ol style={{ fontSize: 13, lineHeight: 2, paddingLeft: 20 }}>
          {recoverySteps.map((step, i) => (
            <li key={i}>{step}</li>
          ))}
        </ol>
      </div>

      {/* 配置文件清单 */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>📁 关键配置文件</h3>
        <div style={{ fontSize: 13, fontFamily: 'monospace', lineHeight: 1.8 }}>
          {['~/.openclaw/workspace/AGENTS.md', '~/.openclaw/workspace/SOUL.md', '~/.openclaw/workspace/USER.md',
            '~/.openclaw/workspace/MEMORY.md', '~/.openclaw/workspace/TOOLS.md', '~/.openclaw/workspace/HEARTBEAT.md',
            '~/.openclaw/workspace/BOOTSTRAP.md', '~/.openclaw/.env'
          ].map(f => (
            <div key={f} style={{ padding: 2, color: '#3b82f6' }}>{f}</div>
          ))}
        </div>
      </div>

      {/* 数据库Schema */}
      <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16 }}>
        <h3 style={{ marginBottom: 12, fontSize: 14 }}>🗄️ 数据库Schema (恢复用DDL)</h3>
        {Object.entries(dbSchemas).map(([table, ddl]) => (
          <details key={table} style={{ marginBottom: 8 }}>
            <summary style={{ cursor: 'pointer', fontWeight: 600, fontSize: 13 }}>{table}</summary>
            <pre style={{
              background: '#f8f9fa', padding: 8, borderRadius: 4, fontSize: 11,
              overflow: 'auto', maxHeight: 300, marginTop: 4
            }}>{ddl as string}</pre>
          </details>
        ))}
      </div>
    </div>
  )

  const tabs = [
    { key: 'dashboard', label: '📊 系统概览' },
    { key: 'goals', label: '🎯 目标配置' },
    { key: 'tasks', label: '📋 任务规则' },
    { key: 'projects', label: '📁 项目阈值' },
    { key: 'realtime', label: '📡 实时监控' },
    { key: 'history', label: '📈 历史趋势' },
    { key: 'architecture', label: '🏗️ 架构编辑' },
    { key: 'documents', label: '📄 文档管理' },
  ]

  const renderContent = () => {
    switch (activeTab) {
      case 'dashboard': return renderDashboard()
      case 'goals': return renderGoals()
      case 'tasks': return renderTasks()
      case 'projects': return renderProjects()
      case 'realtime': return renderRealtime()
      case 'history': return renderHistory()
      case 'architecture': return renderArchitecture()
      case 'documents': return renderDocuments()
      default: return <div>选择功能模块</div>
    }
  }

  return (
    <div style={{ display: 'flex', gap: 20, padding: 20, minHeight: '100vh' }}>
      {/* 侧边栏 */}
      <div style={{
        width: 200, background: '#fff', borderRadius: 8, padding: 8,
        border: '1px solid #e5e7eb', height: 'fit-content', position: 'sticky', top: 20
      }}>
        <div style={{ padding: '8px 12px', fontWeight: 700, fontSize: 14, marginBottom: 8, color: '#333' }}>
          自我驱动
        </div>
        {tabs.map(tab => (
          <div
            key={tab.key}
            onClick={() => setActiveTab(tab.key)}
            style={{
              padding: '10px 12px', borderRadius: 6, cursor: 'pointer', marginBottom: 4,
              fontSize: 14, background: activeTab === tab.key ? '#3b82f6' : 'transparent',
              color: activeTab === tab.key ? '#fff' : '#333',
              fontWeight: activeTab === tab.key ? 600 : 400,
            }}
          >
            {tab.label}
          </div>
        ))}
      </div>

      {/* 内容区域 */}
      <div style={{
        flex: 1, background: '#fff', borderRadius: 8, padding: 24,
        border: '1px solid #e5e7eb'
      }}>
        {renderContent()}
      </div>
    </div>
  )
}
