let lastPath = window.location.pathname
let lastSearch = window.location.search
let lastHash = window.location.hash

setInterval(() => {
  const currentPath = window.location.pathname
  const currentSearch = window.location.search
  const currentHash = window.location.hash
  
  if (currentPath !== lastPath || currentSearch !== lastSearch || currentHash !== lastHash) {
    Sentry.addBreadcrumb({
      category: "navigation",
      message: `Route: ${lastPath}${lastSearch}${lastHash} -> ${currentPath}${currentSearch}${currentHash}`,
      level: "info"
    })
    Sentry.setTag("route", currentPath)
    Sentry.setTag("route_params", currentSearch)
    Sentry.setTag("route_hash", currentHash)
    lastPath = currentPath
    lastSearch = currentSearch
    lastHash = currentHash
  }
}, 300)

// ============================================
// 8. 内存监控（最宽）
// ============================================

if ((performance as any).memory) {
  setInterval(() => {
    const mem = (performance as any).memory
    const used = Math.round(mem.usedJSHeapSize / 1048576)
    const total = Math.round(mem.totalJSHeapSize / 1048576)
    const limit = Math.round(mem.jsHeapSizeLimit / 1048576)
    const percent = Math.round(mem.usedJSHeapSize / mem.totalJSHeapSize * 100)
    
    Sentry.setTag("memoryUsed", used.toString())
    Sentry.setTag("memoryTotal", total.toString())
    Sentry.setTag("memoryPercent", percent.toString())
    
    if (percent > 85) {
      Sentry.captureMessage(`Critical memory: ${used}MB / ${total}MB (${percent}%)`, {
        level: "fatal",
        tags: { type: "memory_critical" },
        extra: { usedMB: used, totalMB: total, limitMB: limit, percent }
      })
    } else if (percent > 70) {
      Sentry.captureMessage(`High memory: ${used}MB / ${total}MB (${percent}%)`, {
        level: "warning",
        tags: { type: "memory_warning" },
        extra: { usedMB: used, totalMB: total, percent }
      })
    }
  }, 15000)  // 每 15 秒
}

