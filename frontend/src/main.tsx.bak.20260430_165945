// ---- 1. 全局错误收集器（最宽） ----
const globalErrors: string[] = []

function collectGlobalError(type: string, data: any) {
  const entry = `[${new Date().toISOString()}] ${type}: ${JSON.stringify(data).substring(0, 500)}`
  globalErrors.push(entry)
  if (globalErrors.length > 100) globalErrors.shift()
}

