    tags: { type: "rejectionhandled" }
  })
})

// 资源加载错误
window.addEventListener("error", (event) => {
  const target = event.target as any
  if (target && (target.src || target.href)) {
    const resourceUrl = target.src || target.href
    collectGlobalError("resource_error", { url: resourceUrl, tag: target.tagName })
    Sentry.captureMessage("Resource load failed: " + resourceUrl, {
      level: "error",
      tags: { type: "resource_error", tagName: target.tagName },
      extra: {
        resourceUrl,
        tagName: target.tagName,
        currentSrc: target.currentSrc,
        crossOrigin: target.crossOrigin,
      }
    })
  }
}, true)

// 语法错误 / 运行时错误
window.addEventListener("error", (event) => {
  if (!event.target || !(event.target as any).src) {
    collectGlobalError("window_error", {
      message: event.message,
      filename: event.filename,
      lineno: event.lineno,
      colno: event.colno,
    })
  }
})

// ============================================
// 5. Web Vitals 全量监控（最宽）
// ============================================

if (typeof PerformanceObserver !== "undefined") {
  try {
    // LCP - 最大内容绘制
    const lcpObserver = new PerformanceObserver((list) => {
      const entries = list.getEntries()
      const lastEntry = entries[entries.length - 1] as any
      if (lastEntry) {
        Sentry.setTag("LCP", Math.round(lastEntry.startTime).toString())
        Sentry.setMeasurement("LCP", lastEntry.startTime, "millisecond")
        
        if (lastEntry.startTime > 4000) {
          Sentry.captureMessage("Poor LCP: " + Math.round(lastEntry.startTime) + "ms", {
            level: "warning",
            tags: { type: "webvital", metric: "LCP" }
          })
        }
      }
    })
    lcpObserver.observe({ entryTypes: ["largest-contentful-paint"] as any })
    
    // CLS - 累积布局偏移
    let clsValue = 0
    const clsObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        if (!(entry as any).hadRecentInput) {
          clsValue += (entry as any).value
        }
      }
      Sentry.setTag("CLS", clsValue.toFixed(4))
      Sentry.setMeasurement("CLS", clsValue, "")
      
      if (clsValue > 0.25) {
        Sentry.captureMessage("Poor CLS: " + clsValue.toFixed(4), {
          level: "warning",
          tags: { type: "webvital", metric: "CLS" }
        })
      }
    })
    clsObserver.observe({ entryTypes: ["layout-shift"] as any })
    
    // FID / INP - 首次输入 / 交互到下一帧
    const inpObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        const duration = (entry as any).processingStart - entry.startTime
        Sentry.setTag("FID", Math.round(duration).toString())
        Sentry.setMeasurement("FID", duration, "millisecond")
        
        if (duration > 300) {
          Sentry.captureMessage("Poor FID/INP: " + Math.round(duration) + "ms", {
            level: "warning",
            tags: { type: "webvital", metric: "FID" }
          })
        }
      }
    })
    inpObserver.observe({ entryTypes: ["first-input"] as any })
    inpObserver.observe({ entryTypes: ["event"] as any })
    
    // FCP - 首次内容绘制
    const fcpObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        if ((entry as any).name === "first-contentful-paint") {
          Sentry.setTag("FCP", Math.round(entry.startTime).toString())
          Sentry.setMeasurement("FCP", entry.startTime, "millisecond")
        }
      }
    })
    fcpObserver.observe({ entryTypes: ["paint"] as any })
    
    // TTFB - 首字节时间
    const navObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        const nav = entry as PerformanceNavigationTiming
        const ttfb = nav.responseStart - nav.startTime
        Sentry.setTag("TTFB", Math.round(ttfb).toString())
        Sentry.setMeasurement("TTFB", ttfb, "millisecond")
        
        if (ttfb > 800) {
          Sentry.captureMessage("Poor TTFB: " + Math.round(ttfb) + "ms", {
            level: "warning",
            tags: { type: "webvital", metric: "TTFB" }
          })
        }
      }
    })
    navObserver.observe({ entryTypes: ["navigation"] as any })
    
    // Long Tasks - 长任务
    const longTaskObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        Sentry.addBreadcrumb({
          category: "performance",
          message: `Long task: ${Math.round(entry.duration)}ms`,
          level: entry.duration > 100 ? "warning" : "info",
          data: { duration: entry.duration, startTime: entry.startTime }
        })
        
        if (entry.duration > 200) {
          Sentry.captureMessage("Very long task: " + Math.round(entry.duration) + "ms", {
            level: "warning",
            tags: { type: "performance", metric: "longtask" }
          })
        }
      }
    })
    longTaskObserver.observe({ entryTypes: ["longtask"] as any })
    
    // Resource Timing - 资源加载时间
    const resourceObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        const res = entry as PerformanceResourceTiming
        if (res.duration > 3000) {
          Sentry.addBreadcrumb({
            category: "performance",
            message: `Slow resource: ${res.name.substring(0, 100)} took ${Math.round(res.duration)}ms`,
            level: "warning",
            data: { 
              url: res.name.substring(0, 200),
              duration: res.duration,
              transferSize: res.transferSize,
              initiatorType: res.initiatorType
            }
          })
        }
      }
    })
    resourceObserver.observe({ entryTypes: ["resource"] as any })
    
  } catch (e) {
    console.error("PerformanceObserver error:", e)
  }
}

