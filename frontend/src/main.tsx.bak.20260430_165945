// 拦截所有 Fetch 请求
const originalFetch = window.fetch
window.fetch = async function(...args: any[]) {
  const url = args[0]?.toString() || "unknown"
  const startTime = performance.now()
  
  try {
    const response = await originalFetch.apply(window, args as any)
    const duration = Math.round(performance.now() - startTime)
    
    if (!response.ok) {
      Sentry.addBreadcrumb({
        category: "http",
        message: `Fetch failed: ${url} -> ${response.status} ${response.statusText}`,
        level: "error",
        data: { status: response.status, duration, method: args[1]?.method || "GET" }
      })
    } else {
      Sentry.addBreadcrumb({
        category: "http",
        message: `Fetch: ${url} -> ${response.status}`,
        level: "info",
        data: { status: response.status, duration, method: args[1]?.method || "GET" }
      })
    }
    
    return response
  } catch (error) {
    Sentry.addBreadcrumb({
      category: "http",
      message: `Fetch error: ${url} -> ${String(error)}`,
      level: "error",
      data: { error: String(error), duration: Math.round(performance.now() - startTime) }
    })
    throw error
  }
}

// 拦截所有 XMLHttpRequest
const originalXHROpen = XMLHttpRequest.prototype.open
const originalXHRSend = XMLHttpRequest.prototype.send

XMLHttpRequest.prototype.open = function(method: string, url: string, ...args: any[]) {
  (this as any).__sentry_url = url
  ;(this as any).__sentry_method = method
  return originalXHROpen.call(this, method, url, ...args)
}

XMLHttpRequest.prototype.send = function(...args: any[]) {
  const xhr = this
  const startTime = performance.now()
  const url = (xhr as any).__sentry_url || "unknown"
  const method = (xhr as any).__sentry_method || "GET"
  
  xhr.addEventListener('loadend', function() {
    const duration = Math.round(performance.now() - startTime)
    
    if (xhr.status >= 400 || xhr.status === 0) {
      Sentry.addBreadcrumb({
        category: "http",
        message: `XHR failed: ${method} ${url} -> ${xhr.status}`,
        level: "error",
        data: { status: xhr.status, duration, response: xhr.responseText?.substring(0, 200) }
      })
    } else {
      Sentry.addBreadcrumb({
        category: "http",
        message: `XHR: ${method} ${url} -> ${xhr.status}`,
        level: "info",
        data: { status: xhr.status, duration }
      })
    }
  })
  
  return originalXHRSend.call(this, ...args)
}

