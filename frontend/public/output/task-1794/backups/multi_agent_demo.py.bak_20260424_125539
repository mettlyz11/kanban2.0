import json
import time
import uuid
from datetime import datetime
from typing import Dict, List, Optional
from dataclasses import dataclass, asdict

# -----------------------------------------------------------------------------
# ACP 消息协议实现
# -----------------------------------------------------------------------------

@dataclass
class ACPMessage:
    """Agent Communication Protocol 消息"""
    message_id: str
    from_agent: str
    to_agent: str
    type: str  # task_dispatch | status_report | result_submit
    timestamp: str
    payload: Dict
    metadata: Dict

    def to_json(self) -> str:
        return json.dumps(asdict(self), ensure_ascii=False, indent=2)


def create_message(from_agent: str, to_agent: str, msg_type: str, 
                   payload: Dict, metadata: Dict = None) -> ACPMessage:
    return ACPMessage(
        message_id=f"msg-{uuid.uuid4().hex[:8]}",
        from_agent=from_agent,
        to_agent=to_agent,
        type=msg_type,
        timestamp=datetime.now().isoformat(),
        payload=payload,
        metadata=metadata or {}
    )


# -----------------------------------------------------------------------------
# Agent 基类和具体实现
# -----------------------------------------------------------------------------

class BaseAgent:
    """Agent 基类"""
    
    def __init__(self, agent_id: str, name: str):
        self.agent_id = agent_id
        self.name = name
        self.message_queue: List[ACPMessage] = []
    
    def receive_message(self, msg: ACPMessage):
        """接收消息"""
        self.message_queue.append(msg)
        print(f"  📥 [{self.name}] 收到消息: {msg.type}")
    
    def process_messages(self) -> List[ACPMessage]:
        """处理消息队列，返回响应"""
        responses = []
        for msg in self.message_queue:
            response = self._handle_message(msg)
            if response:
                responses.append(response)
        self.message_queue.clear()
        return responses
    
    def _handle_message(self, msg: ACPMessage) -> Optional[ACPMessage]:
        """处理单条消息 - 由子类实现"""
        raise NotImplementedError


class ResearchAgent(BaseAgent):
    """研究代理 - 负责信息收集和搜索"""
    
    def __init__(self):
        super().__init__("research_agent", "研究代理")
        self._mock_knowledge = {
            "多Agent协作架构": [
                "AutoGen: Microsoft开发的多Agent框架，支持对话式Agent协作",
                "CrewAI: 基于角色的Agent编排框架，支持工具集成",
                "LangGraph: LangChain的图状工作流引擎",
                "OpenAgents: 开源Agent平台"
            ],
            "Graph RAG": [
                "Graph RAG: Microsoft提出的知识图谱增强检索",
                "Neo4j + Chroma混合存储方案",
                "3阶段检索管道: 向量粗过滤 → 图谱扩展 → 语义重排",
                "检索准确率提升30-40%"
            ],
            "可观测性": [
                "OpenTelemetry 分布式追踪",
                "Prometheus 指标监控",
                "Grafana 仪表板",
                "日志聚合系统"
            ]
        }
    
    def _handle_message(self, msg: ACPMessage) -> Optional[ACPMessage]:
        if msg.type == "task_dispatch":
            print(f"  🔍 [{self.name}] 开始研究任务...")
            time.sleep(1)
            
            query = msg.payload.get("query", "")
            results = []
            
            for keyword, items in self._mock_knowledge.items():
                if any(k in query for k in keyword.split()):
                    results.extend(items)
            
            # 模拟进度
            for i in range(3):
                time.sleep(0.5)
                print(f"     正在搜索相关资源... ({i+1}/3)")
            
            result_payload = {
                "task_id": msg.payload.get("task_id"),
                "query": query,
                "findings": results or ["未找到匹配结果，进行通用搜索"],
                "sources_checked": 5,
                "confidence": 0.85
            }
            
            print(f"  ✅ [{self.name}] 研究完成，发现 {len(result_payload['findings'])} 条结果")
            
            return create_message(
                from_agent=self.agent_id,
                to_agent=msg.from_agent,
                msg_type="result_submit",
                payload=result_payload,
                metadata={"source": "research_agent", "quality": "high"}
            )
        return None


class AnalysisAgent(BaseAgent):
    """分析代理 - 负责深度分析和报告生成"""
    
    def __init__(self):
        super().__init__("analysis_agent", "分析代理")
    
    def _handle_message(self, msg: ACPMessage) -> Optional[ACPMessage]:
        if msg.type == "task_dispatch":
            print(f"  📊 [{self.name}] 开始分析任务...")
            time.sleep(0.8)
            
            findings = msg.payload.get("findings", [])
            query = msg.payload.get("query", "")
            
            # 模拟分析过程
            time.sleep(1)
            print(f"     正在分析 {len(findings)} 条研究结果...")
            time.sleep(0.5)
            print(f"     提取关键要点...")
            time.sleep(0.5)
            print(f"     生成结构化报告...")
            
            analysis_result = {
                "task_id": msg.payload.get("task_id"),
                "original_query": query,
                "summary": f"关于「{query}」的深度分析报告",
                "key_points": self._generate_key_points(findings),
                "recommendations": self._generate_recommendations(),
                "architecture_options": self._generate_architecture(),
                "confidence_score": 0.92
            }
            
            print(f"  ✅ [{self.name}] 分析完成")
            
            return create_message(
                from_agent=self.agent_id,
                to_agent=msg.from_agent,
                msg_type="result_submit",
                payload=analysis_result,
                metadata={"source": "analysis_agent", "quality": "excellent"}
            )
        return None
    
    def _generate_key_points(self, findings: List[str]) -> List[str]:
        return [
            "✅ 多Agent协作已成为行业标准架构",
            "✅ Graph RAG显著提升复杂查询准确率",
            "✅ 统一可观测性层是生产环境必备",
            "✅ ACP消息协议标准化Agent间通信"
        ]
    
    def _generate_recommendations(self) -> List[str]:
        return [
            "🚀 优先落地Multi-Agent协作框架",
            "📈 部署Graph RAG知识检索系统",
            "📊 搭建可观测性Dashboard",
            "⚡ 优化Agent性能基准测试"
        ]
    
    def _generate_architecture(self) -> Dict:
        return {
            "layers": ["ACP 消息层", "Graph 记忆层", "Orchestrator 编排层"],
            "agents": 4,
            "routing_rules": 6,
            "estimated_accuracy": "85%+"
        }


class Orchestrator:
    """编排器 - 负责任务调度和协调"""
    
    def __init__(self):
        self.agents: Dict[str, BaseAgent] = {}
        self.task_history: List[Dict] = []
    
    def register_agent(self, agent: BaseAgent):
        """注册Agent"""
        self.agents[agent.agent_id] = agent
        print(f"✅ 注册Agent: {agent.name} ({agent.agent_id})")
    
    def execute_collaborative_task(self, task_description: str, task_id: str) -> Dict:
        """执行协作任务: Research → Analysis 流水线"""
        
        print(f"\n{'='*70}")
        print(f"🚀 开始协作任务: {task_description}")
        print(f"📋 任务ID: {task_id}")
        print(f"{'='*70}\n")
        
        # ─── 阶段1: Research Agent 收集信息 ───
        print("📦 阶段 1/2: Research Agent 信息收集")
        print("-" * 70)
        
        research_msg = create_message(
            from_agent="orchestrator",
            to_agent="research_agent",
            msg_type="task_dispatch",
            payload={
                "task_id": task_id,
                "task_type": "research",
                "query": task_description,
                "priority": "high"
            }
        )
        
        self.agents["research_agent"].receive_message(research_msg)
        research_responses = self.agents["research_agent"].process_messages()
        
        if not research_responses:
            return {"status": "failed", "error": "Research Agent 未返回结果"}
        
        research_result = research_responses[0].payload
        
        self.task_history.append({
            "phase": "research",
            "agent": "research_agent",
            "result": research_result,
            "timestamp": datetime.now().isoformat()
        })
        
        print(f"\n📊 Research 完成: {len(research_result['findings'])} 条发现")
        
        # ─── 阶段2: Analysis Agent 深度分析 ───
        print(f"\n{'='*70}")
        print("📦 阶段 2/2: Analysis Agent 深度分析")
        print("-" * 70)
        
        analysis_msg = create_message(
            from_agent="orchestrator",
            to_agent="analysis_agent",
            msg_type="task_dispatch",
            payload={
                "task_id": task_id,
                "task_type": "analysis",
                "query": task_description,
                "findings": research_result["findings"],
                "prior_results": research_result
            }
        )
        
        self.agents["analysis_agent"].receive_message(analysis_msg)
        analysis_responses = self.agents["analysis_agent"].process_messages()
        
        if not analysis_responses:
            return {"status": "failed", "error": "Analysis Agent 未返回结果"}
        
        analysis_result = analysis_responses[0].payload
        
        self.task_history.append({
            "phase": "analysis",
            "agent": "analysis_agent",
            "result": analysis_result,
            "timestamp": datetime.now().isoformat()
        })
        
        # ─── 结果整合 ───
        final_result = {
            "status": "success",
            "task_id": task_id,
            "task_description": task_description,
            "collaboration_phases": [
                {"agent": "research_agent", "role": "信息收集与搜索", "duration": "~2.5s"},
                {"agent": "analysis_agent", "role": "深度分析与报告", "duration": "~2.3s"}
            ],
            "research_findings": research_result["findings"],
            "analysis_summary": analysis_result["summary"],
            "key_points": analysis_result["key_points"],
            "recommendations": analysis_result["recommendations"],
            "architecture": analysis_result["architecture_options"],
            "confidence": analysis_result["confidence_score"],
            "total_agents_involved": 2,
            "total_messages_exchanged": 4,
            "timestamp": datetime.now().isoformat()
        }
        
        print(f"\n{'='*70}")
        print("🎉 协作任务完成!")
        print(f"🤝 参与Agent: 2个 (Research + Analysis)")
        print(f"📨 消息交换: 4条")
        print(f"🎯 置信度: {final_result['confidence']:.1%}")
        print(f"{'='*70}\n")
        
        return final_result


