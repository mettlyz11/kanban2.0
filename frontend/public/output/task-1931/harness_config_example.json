{
  "$schema": "https://openclaw.ai/schemas/harness-config-v2026.json",
  "version": "2026.1",
  "description": "OpenClaw ACP v2026 Harness Configuration Example",
  "last_updated": "2026-04-25",

  "harness": {
    "name": "OpenClaw-ACP-Harness",
    "mode": "production",
    "orchestration": "hierarchical",
    "max_agents": 50,
    "max_concurrent_tasks": 20,
    "global_timeout_seconds": 86400,
    "enable_tracing": true,
    "enable_metrics": true
  },

  "security_policy": {
    "default_sandbox_backend": "docker",
    "network_default_deny": true,
    "allowed_domains": [
      "pypi.org",
      "files.pythonhosted.org",
      "github.com",
      "api.openai.com",
      "openclaw.ai"
    ],
    "blocked_commands": [
      "rm -rf /",
      ":(){ :|:& };:",
      "dd if=/dev",
      "nc -l",
      "curl -X POST",
      "wget --post-data"
    ],
    "resource_quotas": {
      "default": {
        "cpu": "2.0",
        "memory": "4g",
        "disk": "10g",
        "pids": 100
      },
      "research": {
        "cpu": "4.0",
        "memory": "8g",
        "disk": "50g",
        "pids": 200
      },
      "production": {
        "cpu": "8.0",
        "memory": "16g",
        "disk": "100g",
        "pids": 500
      }
    }
  },

  "sandbox_profiles": {
    "minimal": {
      "description": "Minimal sandbox for simple tasks",
      "image": "openclaw/sandbox-minimal:v2026",
      "capabilities": ["filesystem"],
      "quota_profile": "default",
      "network_enabled": false,
      "persist_enabled": false
    },
    "code_execution": {
      "description": "Sandbox for code review and execution",
      "image": "openclaw/sandbox-python:v2026",
      "capabilities": ["shell", "filesystem", "memory"],
      "quota_profile": "default",
      "network_enabled": true,
      "persist_enabled": true,
      "pre_installed_packages": [
        "pandas==2.2.0",
        "numpy==1.26.0",
        "pytest==8.0.0",
        "flake8==7.0.0",
        "black==24.0.0"
      ]
    },
    "data_analysis": {
      "description": "Sandbox for data analysis and visualization",
      "image": "openclaw/sandbox-data:v2026",
      "capabilities": ["shell", "filesystem", "memory", "network"],
      "quota_profile": "research",
      "network_enabled": true,
      "persist_enabled": true,
      "pre_installed_packages": [
        "pandas==2.2.0",
        "numpy==1.26.0",
        "matplotlib==3.8.0",
        "seaborn==0.13.0",
        "scikit-learn==1.4.0",
        "scipy==1.12.0"
      ]
    },
    "research": {
      "description": "Sandbox for research and long-running experiments",
      "image": "openclaw/sandbox-research:v2026",
      "capabilities": ["shell", "filesystem", "memory", "network", "compaction"],
      "quota_profile": "research",
      "network_enabled": true,
      "persist_enabled": true,
      "checkpoint_enabled": true,
      "checkpoint_interval_seconds": 1800
    },
    "production": {
      "description": "Production-grade sandbox with all security features",
      "image": "openclaw/sandbox-production:v2026",
      "capabilities": ["shell", "filesystem", "memory", "network", "compaction", "skills"],
      "quota_profile": "production",
      "network_enabled": true,
      "persist_enabled": true,
      "checkpoint_enabled": true,
      "seccomp_enabled": true,
      "apparmor_enabled": true,
      "read_only_rootfs": true
    }
  },

  "agent_profiles": {
    "research_agent": {
      "model": "gpt-5.4",
      "temperature": 0.7,
      "max_tokens": 8192,
      "sandbox_profile": "research",
      "enable_memory": true,
      "memory_compaction_threshold": 80000,
      "max_steps": 500,
      "handoff_allowed": true,
      "escalation_rules": [
        {"condition": "uncertainty_high", "action": "ask_human"},
        {"condition": "error_3_times", "action": "escalate"},
        {"condition": "security_risk", "action": "pause_and_alert"}
      ]
    },
    "code_agent": {
      "model": "gpt-5.4",
      "temperature": 0.2,
      "max_tokens": 8192,
      "sandbox_profile": "code_execution",
      "enable_memory": true,
      "max_steps": 200,
      "guardrails": {
        "no_destructive_commands": true,
        "code_review_required": true,
        "test_required": true
      }
    },
    "data_agent": {
      "model": "gpt-5.4",
      "temperature": 0.1,
      "max_tokens": 4096,
      "sandbox_profile": "data_analysis",
      "enable_memory": true,
      "max_steps": 100
    },
    "orchestrator_agent": {
      "model": "gpt-5.4",
      "temperature": 0.3,
      "max_tokens": 16384,
      "sandbox_profile": "production",
      "enable_memory": true,
      "subagent_allowed": true,
      "max_subagents": 10,
      "max_steps": 1000,
      "memory_compaction_threshold": 150000
    }
  },

  "memory_config": {
    "provider": "graph_rag",
    "storage": {
      "type": "sqlite",
      "path": "/var/openclaw/memory/memory.db"
    },
    "embedding": {
      "model": "text-embedding-3-large",
      "dimensions": 3072
    },
    "graph": {
      "enabled": true,
      "path": "/var/openclaw/memory/graph.json",
      "decay_rate": 0.01,
      "boost_factor": 2.0
    },
    "compaction": {
      "enabled": true,
      "strategy": "hybrid",
      "threshold_tokens": 80000,
      "target_ratio": 0.1,
      "keep_critical": true,
      "keep_tool_outputs": false
    }
  },

  "checkpoint_config": {
    "enabled": true,
    "storage": {
      "type": "filesystem",
      "path": "/var/openclaw/checkpoints",
      "max_size": "100g"
    },
    "auto_checkpoint": {
      "enabled": true,
      "interval_seconds": 1800,
      "on_step": true,
      "on_tool_call": true,
      "on_error": true
    },
    "retention": {
      "keep_last": 10,
      "keep_daily": 7,
      "keep_weekly": 4
    },
    "recovery": {
      "auto_restore": true,
      "max_retries": 3,
      "fallback_strategy": "restart_from_beginning"
    }
  },

  "observability": {
    "metrics": {
      "enabled": true,
      "endpoint": "http://localhost:9090",
      "interval_seconds": 30,
      "labels": {
        "environment": "production",
        "cluster": "acp-main"
      }
    },
    "logging": {
      "level": "INFO",
      "format": "json",
      "destination": {
        "type": "file",
        "path": "/var/log/openclaw/harness.log",
        "rotation": "daily",
        "retention_days": 30
      },
      "audit_log": {
        "enabled": true,
        "path": "/var/log/openclaw/audit.log",
        "immutable": true
      }
    },
    "tracing": {
      "enabled": true,
      "backend": "opentelemetry",
      "endpoint": "http://localhost:4317",
      "sample_rate": 1.0
    },
    "alerts": {
      "enabled": true,
      "channels": ["slack", "email", "pagerduty"],
      "rules": {
        "sandbox_failure": {"threshold": 3, "window": "5m"},
        "high_token_usage": {"threshold": 100000, "window": "1h"},
        "long_running_task": {"threshold": 3600, "window": "1h"},
        "security_anomaly": {"threshold": 1, "window": "1m"}
      }
    }
  },

  "guardrails": {
    "content_policy": {
      "enabled": true,
      "deny_hate": true,
      "deny_violence": true,
      "deny_self_harm": true,
      "deny_sexual": true
    },
    "output_validation": {
      "enabled": true,
      "max_length": 100000,
      "required_fields": [],
      "forbidden_patterns": ["password", "secret", "api_key", "token"]
    },
    "circuit_breakers": {
      "max_tool_calls_per_minute": 60,
      "max_total_tokens_per_hour": 1000000,
      "max_errors_per_hour": 10,
      "loop_detection": {
        "enabled": true,
        "window_steps": 10,
        "similarity_threshold": 0.9
      }
    },
    "human_in_the_loop": {
      "enabled": true,
      "require_approval": [
        "destructive_file_operation",
        "network_post_request",
        "shell_command_sudo",
        "subagent_spawn"
      ],
      "approval_timeout_seconds": 3600,
      "escalation_channel": "slack"
    }
  },

  "acp_protocol": {
    "version": "1.0",
    "message_queue": {
      "backend": "redis",
      "host": "localhost",
      "port": 6379,
      "db": 0
    },
    "message_types": {
      "task_dispatch": {"enabled": true, "priority": "normal"},
      "status_report": {"enabled": true, "interval_seconds": 30},
      "result_submit": {"enabled": true, "ack_required": true},
      "context_request": {"enabled": true, "max_pending": 5},
      "escalation": {"enabled": true, "priority": "high"},
      "handoff": {"enabled": true, "require_orchestrator_approval": true}
    },
    "retry_policy": {
      "max_attempts": 3,
      "backoff_base": 2,
      "backoff_max_seconds": 60
    }
  },

  "subagent_orchestration": {
    "enabled": true,
    "patterns": {
      "fan_out_fan_in": {
        "enabled": true,
        "max_parallel": 10,
        "timeout_per_subtask": 1800
      },
      "pipeline": {
        "enabled": true,
        "max_stages": 10
      },
      "hierarchical": {
        "enabled": true,
        "max_depth": 5
      },
      "blackboard": {
        "enabled": true,
        "max_agents": 20
      }
    },
    "load_balancing": {
      "strategy": "least_busy",
      "max_queue_length": 10
    }
  },

  "skills_registry": {
    "location": "/var/openclaw/skills",
    "auto_discover": true,
    "auto_install_deps": true,
    "sandboxed_execution": true,
    "allowed_skills": [
      "web_search",
      "code_interpreter",
      "data_visualization",
      "document_qa",
      "git_operations"
    ]
  },

  "storage": {
    "working_directory": "/var/openclaw/workspace",
    "artifact_storage": {
      "type": "s3",
      "bucket": "openclaw-artifacts",
      "prefix": "sandbox-outputs/",
      "encryption": "AES256"
    },
    "retention": {
      "task_artifacts_days": 30,
      "checkpoints_days": 7,
      "logs_days": 90
    }
  }
}
