#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
项目级缺口分析引擎 V1.0
精准分析每个项目的真实缺口，生成高价值任务推荐

6维度缺口分析：
1. 进度缺口 - 完成率低且临近截止
2. 活跃度缺口 - 长时间无更新
3. 质量缺口 - 连续任务验证失败
4. 产出缺口 - 预期产出物缺失
5. 依赖缺口 - 前置依赖未完成
6. 文档缺口 - 项目文档缺失/不完整

创建日期: 2026-04-27
"""

import re
import sys
import os
import logging
import random
import json
import time
import requests
from pathlib import Path
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass
from enum import Enum

# 日志配置
logging.basicConfig(
    level=logging.INFO,
    format='[%(asctime)s] [%(levelname)s] [%(name)s] %(message)s',
    handlers=[
        logging.FileHandler('/Users/mettlyz/.openclaw/workspace/logs/sds-project-gap-analyzer.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('ProjectGapAnalyzer')

sys.path.insert(0, str(Path(__file__).parent.parent.parent / "scripts"))
from lib.db_connector import execute_query

# 🔑 加载.env文件的环境变量
_env_path = Path.home() / '.openclaw' / '.env'
if _env_path.exists():
    with open(_env_path) as _f:
        for _line in _f:
            _line = _line.strip()
            if _line and not _line.startswith('#') and '=' in _line:
                _k, _v = _line.split('=', 1)
                os.environ[_k.strip()] = _v.strip()  # 强制设置，不setdefault
    logger.info(f"✅ 已加载环境变量从 {_env_path}")
    logger.info(f"   MOONSHOT_API_KEY前10位: {os.environ.get('MOONSHOT_API_KEY', '未设置')[:10]}...")
    logger.info(f"   ALICODINGPLAN_API_KEY前10位: {os.environ.get('ALICODINGPLAN_API_KEY', '未设置')[:10]}...")
else:
    logger.warning(f"⚠️ .env文件不存在: {_env_path}")

# 📚 知识库检索器（延迟加载）
_knowledge_retriever = None
def get_knowledge_retriever():
    """延迟加载知识库检索器"""
    global _knowledge_retriever
    if _knowledge_retriever is None:
        try:
            # 确保 sds/ 在 Python 路径中
            sds_root = Path(__file__).parent.parent
            if str(sds_root) not in sys.path:
                sys.path.insert(0, str(sds_root))
            from core.knowledge_retriever import KnowledgeRetriever
            _knowledge_retriever = KnowledgeRetriever()
            logger.info("✅ 知识库检索器加载成功")
        except Exception as e:
            logger.warning(f"⚠️ 知识库检索器加载失败: {e}")
            _knowledge_retriever = False  # 标记为不可用
    return _knowledge_retriever if _knowledge_retriever else None

class GapType(Enum):
    """缺口类型枚举"""
    PROGRESS = "progress_gap"           # 进度缺口
    ACTIVITY = "activity_gap"           # 活跃度缺口
    QUALITY = "quality_gap"             # 质量缺口
    OUTPUT = "output_gap"               # 产出缺口
    DEPENDENCY = "dependency_gap"       # 依赖缺口
    DOCUMENTATION = "documentation_gap" # 文档缺口

@dataclass
class Gap:
    """单个缺口数据结构"""
    project_id: int
    project_name: str
    gap_type: GapType
    severity: int  # 1-5，5最严重
    description: str
    recommended_task: Dict  # 推荐的任务模板

@dataclass
class ProjectHealth:
    """项目健康度画像"""
    project_id: int
    project_name: str
    status: str
    total_tasks: int
    completed_tasks: int
    completion_rate: float
    last_activity_date: datetime
    days_since_activity: int
    failed_tasks: int
    gaps: List[Gap]
    # 新增：丰富上下文
    description: str = ''
    goal: str = ''
    goal_id: int = 0
    goal_title: str = ''
    goal_description: str = ''
    recent_completed_tasks: str = ''
    
    @property
    def health_score(self) -> float:
        """综合健康度评分 0-100"""
        score = 100
        
        # 完成率扣分 (权重40%)
        score -= (1 - self.completion_rate) * 40
        
        # 活跃度扣分 (权重25%)
        if self.days_since_activity > 14:
            score -= min(25, (self.days_since_activity - 7) * 2)
        
        # 失败任务扣分 (权重25%)
        score -= min(25, self.failed_tasks * 5)
        
        # 缺口数量扣分 (权重10%)
        score -= min(10, len(self.gaps) * 2)
        
        return max(0, score)

class ProjectGapAnalyzer:
    """项目缺口分析引擎"""
    
    def __init__(self):
        self.projects = []
        self.project_healths = {}
        self.all_gaps = []
        
    def analyze_all_projects(self) -> List[ProjectHealth]:
        """分析所有项目的缺口"""
        print("🔍 开始项目缺口分析...")
        
        # 1. 获取所有活跃项目
        projects = execute_query("""
            SELECT id, name, status, created_at, updated_at,
                   description, goal, start_date, end_date, deadline
            FROM projects 
            WHERE status IN ('active', 'todo')
            ORDER BY id
        """)
        
        print(f"📦 发现 {len(projects)} 个活跃项目")
        
        healths = []
        for p in projects:
            health = self.analyze_single_project(p)
            healths.append(health)
            self.project_healths[p['id']] = health
        
        # 按健康度排序，最不健康的在前
        healths.sort(key=lambda x: x.health_score)
        
        self.all_gaps = []
        for h in healths:
            self.all_gaps.extend(h.gaps)
        
        print(f"✅ 分析完成，共发现 {len(self.all_gaps)} 个缺口")
        return healths
    
    def analyze_single_project(self, project: Dict) -> ProjectHealth:
        """分析单个项目的缺口"""
        project_id = project['id']
        project_name = project['name']
        
        # 1. 统计任务情况
        task_stats = execute_query("""
            SELECT 
                status, COUNT(*) as cnt,
                MAX(updated_at) as last_update
            FROM tasks 
            WHERE project_id = %s
            GROUP BY status
        """, (project_id,))
        
        status_map = {s['status']: s['cnt'] for s in task_stats}
        total = sum(status_map.values())
        completed = status_map.get('completed', 0)
        failed = status_map.get('failed_retryable', 0) + status_map.get('failed', 0)
        
        # 2. 计算最后活跃时间
        last_activity = project['updated_at']
        for s in task_stats:
            if s['last_update'] and s['last_update'] > last_activity:
                last_activity = s['last_update']
        
        days_since = (datetime.now() - last_activity).days
        
        # 3. 完成率
        completion_rate = completed / total if total > 0 else 0
        
        # 4. 读取项目描述和目标
        proj_desc = (project.get('description') or '').strip()
        proj_goal = (project.get('goal') or '').strip()
        goal_id = project.get('goal_id', 0) or 0
        goal_title = ''
        goal_desc = ''
        if goal_id:
            goal_rows = execute_query("SELECT title, description FROM goals WHERE id = %s", (goal_id,))
            if goal_rows:
                goal_title = (goal_rows[0].get('title') or '').strip()
                goal_desc = (goal_rows[0].get('description') or '').strip()
        
        # 5. 读取最近5个已完成任务的标题（供 LLM 参考，避免重复）
        recent_done = execute_query(
            "SELECT title FROM tasks WHERE project_id = %s AND status = 'completed' ORDER BY updated_at DESC LIMIT 5",
            (project_id,))
        recent_done_text = '\n'.join([f"- {t['title']}" for t in recent_done]) if recent_done else '（暂无已完成任务）'
        
        health = ProjectHealth(
            project_id=project_id,
            project_name=project_name,
            status=project['status'],
            total_tasks=total,
            completed_tasks=completed,
            completion_rate=completion_rate,
            last_activity_date=last_activity,
            days_since_activity=days_since,
            failed_tasks=failed,
            gaps=[],
            description=proj_desc,
            goal=proj_goal,
            goal_id=goal_id,
            goal_title=goal_title,
            goal_description=goal_desc,
            recent_completed_tasks=recent_done_text,
        )
        
        # 4. 6维度缺口检测（只检测，不生成模板任务）
        self._detect_progress_gap(project, health)
        self._detect_activity_gap(project, health)
        self._detect_quality_gap(project, health)
        self._detect_output_gap(project, health)
        self._detect_documentation_gap(project, health)
        
        # 5. LLM 为所有非进度缺口生成具体任务（替换模板）
        non_progress_gaps = [g for g in health.gaps if g.gap_type != GapType.PROGRESS and not g.recommended_task]
        if non_progress_gaps:
            self._llm_generate_tasks_for_gaps(health, non_progress_gaps)
        
        return health
    
    def _detect_progress_gap(self, project: Dict, health: ProjectHealth):
        """检测进度缺口"""
        # 完成率 < 30% 且 创建超过7天 → 严重进度缺口
        if health.completion_rate < 0.3 and health.total_tasks > 0:
            severity = 5
        elif health.completion_rate < 0.5:
            severity = 3
        else:
            return
        
        # 🧠 LLM智能生成任务（多模型重试链 + 指数退避）
        try:
            # 构建丰富的项目上下文（项目描述 + 战略目标 + 已完成任务）
            context_parts = []
            if health.description:
                context_parts.append(f"【项目详情】\n{health.description}")
            if health.goal:
                context_parts.append(f"【项目目标】\n{health.goal}")
            if health.goal_title:
                context_parts.append(f"【所属战略目标】{health.goal_title}：{health.goal_description}")
            
            context_block = '\n\n'.join(context_parts) if context_parts else ''
            
            # 📚 注入本地知识库上下文
            knowledge_context = ''
            retriever = get_knowledge_retriever()
            if retriever:
                # 根据项目名称和描述检索相关知识
                search_query = f"{health.project_name} {health.description[:50]}"
                knowledge_context = retriever.format_context(search_query, top_k=3, max_tokens=1500)
                if knowledge_context:
                    logger.debug(f"为项目 {health.project_name} 检索到知识库上下文 ({len(knowledge_context)} 字)")
                else:
                    logger.debug(f"知识库未找到与 {health.project_name} 相关的内容")
            
            # 构建禁止任务类型清单
            recent_done_list = health.recent_completed_tasks
            
            prompt = f"""你是一个专业的项目管理助手，负责为项目生成下一步具体可执行的任务。

【项目信息】
项目名称：{health.project_name}
项目ID：{health.project_id}
当前完成率：{health.completion_rate:.0%}
总任务数：{health.total_tasks}
已完成：{health.completed_tasks}
失败任务：{health.failed_tasks}
距离上次更新：{health.days_since_activity} 天

{context_block}

{knowledge_context}

【已完成的任务】（绝对不要生成相同或近似的任务！）
{recent_done_list}

【要求】
1. 生成 3-5 个具体、可执行、有明确交付物的任务
2. 绝对不要生成上面已完成列表中已经做过的任务
3. 每个任务都要针对项目当前的进度和状态
4. 不要生成空泛的规划类任务（如“制定计划”、“梳理情况”、“整理文档”、“归档”等）
5. 每个任务要有明确的验收标准
6. 如果项目有具体目标，请生成直接推动目标达成的任务
7. 只返回纯JSON，不要任何其他文字，格式如下：
{{"tasks": [{{"title": "任务标题", "description": "任务详细说明+验收标准"}}]}}
"""
            
            # 2. 调用系统配置的LLM（从openclaw.json读取配置，自动fallback）
            config_path = Path.home() / '.openclaw' / 'openclaw.json'
            with open(config_path) as f:
                cfg = json.load(f)
            
            # 全量 fallback 链（10 个，含变体；不可用的会快速跳过进入下一个）
            providers = cfg.get('models', {}).get('providers', {})
            acp = providers.get('alicodingplan', {})
            ds = providers.get('deepseek', {})
            ms = providers.get('moonshot', {})
            hsc = providers.get('huoshanCoding', {})
            dmx = providers.get('dmxapi', {})
            hs = providers.get('huoshan', {})
            kmc = providers.get('kimicode', {})
            al = providers.get('aliyun', {})
            
            models_to_try = [
                {'name': 'alicodingplan',  'base_url': acp.get('baseUrl'), 'model': 'kimi-k2.5',                'headers': acp.get('headers', {}), 'timeout': 15},
                {'name': 'deepseek',       'base_url': ds.get('baseUrl'),  'model': 'deepseek-chat',            'headers': ds.get('headers', {}), 'timeout': 15},
                {'name': 'moonshot',       'base_url': ms.get('baseUrl'),  'model': 'kimi-k2.6',                'headers': ms.get('headers', {}), 'timeout': 15},
                {'name': 'alicodingplan+', 'base_url': acp.get('baseUrl'), 'model': 'qwen3.6-plus',             'headers': acp.get('headers', {}), 'timeout': 15},
                {'name': 'huoshanCoding',  'base_url': hsc.get('baseUrl'), 'model': 'ark-code-latest',          'headers': hsc.get('headers', {}), 'timeout': 15},
                {'name': 'dmxapi',         'base_url': dmx.get('baseUrl'), 'model': 'gpt-5.4',                  'headers': dmx.get('headers', {}), 'timeout': 15},
                {'name': 'huoshan',        'base_url': hs.get('baseUrl'),  'model': 'doubao-seed-2-0-pro-260215','headers': hs.get('headers', {}), 'timeout': 15},
                {'name': 'kimicode',       'base_url': kmc.get('baseUrl'), 'model': 'kimi-k2.5',                'headers': kmc.get('headers', {}), 'timeout': 15},
                {'name': 'aliyun',         'base_url': al.get('baseUrl'),  'model': 'qwen3.6-plus',             'headers': al.get('headers', {}), 'timeout': 15},
            ]
            
            llm_tasks = None
            used_model = None
            
            for model_cfg in models_to_try:
                if llm_tasks is not None:
                    break
                
                if not model_cfg.get('base_url'):
                    logger.debug(f"模型{model_cfg['name']}无baseUrl，跳过")
                    continue
                
                try:
                    url = f"{model_cfg['base_url']}/chat/completions"
                    headers = {
                        'Content-Type': 'application/json',
                        **model_cfg.get('headers', {})
                    }
                    # 替换环境变量 - 用正则正确提取 ${VAR_NAME}
                    for k, v in list(headers.items()):
                        if '${' in str(v):
                            # 用正则提取所有 ${VAR_NAME} 占位符
                            def replace_env(match):
                                env_var = match.group(1).strip()
                                value = os.environ.get(env_var, '')
                                if not value:
                                    env_file = Path.home() / '.openclaw' / '.env'
                                    if env_file.exists():
                                        with open(env_file) as ef:
                                            for line in ef:
                                                if '=' in line and line.split('=')[0].strip() == env_var:
                                                    value = line.split('=', 1)[1].strip()
                                                    break
                                return value
                            
                            headers[k] = re.sub(r'\$\{([^}]+)\}', replace_env, v)
                            logger.warning(f"[DEBUG] {k}: {v[:30]} -> {headers[k][:20]}...")
                    
                    # 调试日志：显示Authorization header的前20个字符
                    auth_header = headers.get('Authorization', '无')
                    logger.warning(f"[DEBUG] 模型{model_cfg['name']} - Auth: {auth_header[:20]}... URL: {url}")
                    
                    payload = {
                        'model': model_cfg['model'],
                        'messages': [{'role': 'user', 'content': prompt}],
                        'temperature': 1.0,  # Moonshot要求必须是1.0
                        'response_format': {'type': 'json_object'}
                    }
                    
                    timeout = model_cfg.get('timeout', 15)
                    resp = requests.post(url, json=payload, headers=headers, timeout=timeout)
                    
                    # 容错1：检查响应是否为 None
                    if resp is None:
                        raise ValueError(f"API返回空响应")
                    
                    logger.warning(f"[DEBUG] 模型{model_cfg['name']} - 响应状态: {resp.status_code}, 响应前200字: {resp.text[:200]}")
                    
                    # 容错2：检查 HTTP 状态码
                    if resp.status_code != 200:
                        raise ValueError(f"HTTP {resp.status_code}: {resp.text[:200]}")
                    
                    # 容错3：检查响应体是否为空
                    if not resp.text or not resp.text.strip():
                        raise ValueError("API返回空body")
                    
                    # 容错4：安全解析 JSON
                    try:
                        result = resp.json()
                    except json.JSONDecodeError as e:
                        raise ValueError(f"JSON解析失败: {e}, 原始响应: {resp.text[:200]}")
                    
                    # 容错5：检查 choices 结构
                    if not result or not isinstance(result, dict):
                        raise ValueError(f"API返回格式异常: {type(result)}")
                    
                    if not result.get('choices'):
                        raise ValueError(f"API返回无choices: {result}")
                    
                    # 容错6：安全访问 message.content
                    choice = result['choices'][0]
                    message = choice.get('message', {})
                    content = message.get('content', '')
                    
                    if not content:
                        raise ValueError(f"LLM返回空content: {message}")
                    
                    # 容错7：安全解析任务 JSON
                    try:
                        tasks_data = json.loads(content)
                    except json.JSONDecodeError as e:
                        # 尝试提取 JSON 块（LLM 可能包裹 markdown）
                        json_match = re.search(r'\{[\s\S]*"tasks"[\s\S]*\}', content)
                        if json_match:
                            tasks_data = json.loads(json_match.group())
                        else:
                            raise ValueError(f"任务JSON解析失败: {e}, content: {content[:200]}")
                    
                    llm_tasks = tasks_data.get('tasks', [])
                    if not llm_tasks or not isinstance(llm_tasks, list):
                        raise ValueError(f"tasks字段无效: {type(llm_tasks)}")
                    
                    used_model = model_cfg['name']
                    logger.warning(f"[DEBUG] LLM成功 - 生成{len(llm_tasks)}个任务")
                    
                except Exception as e:
                    logger.warning(f"模型{model_cfg['name']}调用失败: {e}")
                    continue
            
            # 3. 把LLM生成的任务加入推荐
            for i, task in enumerate(llm_tasks[:5]):
                health.gaps.append(Gap(
                    project_id=health.project_id,
                    project_name=health.project_name,
                    gap_type=GapType.PROGRESS,
                    severity=max(1, severity - i),
                    description=f"LLM智能生成任务",
                    recommended_task={
                        'title': task['title'],
                        'description': task['description'],
                        'priority': 2,
                        'task_type': 'llm_generated'
                    }
                ))
            
            logger.info(f"LLM({used_model})为项目{health.project_name}生成了{len(llm_tasks)}个智能任务")
            
        except Exception as e:
            # ❌ 永远不切换回模板！LLM失败就失败，宁可不生成下个周期重试
            logger.error(f"LLM生成失败（项目：{health.project_name}）: {e}")
            logger.info("不使用模板兜底，记录失败，下个周期自动重试")
    
    def _llm_generate_tasks_for_gaps(self, health: ProjectHealth, gaps: List[Gap]):
        """统一LLM方法：为所有非进度缺口生成具体任务（替代模板）"""
        if not gaps:
            return
        
        try:
            # 构建缺口上下文
            gap_context = []
            for g in gaps:
                gap_context.append(f"- {g.gap_type.value}: {g.description}（严重度 {g.severity}/5）")
            gap_text = '\n'.join(gap_context)
            
            # 构建项目上下文
            context_parts = []
            if health.description:
                context_parts.append(f"【项目详情】\n{health.description}")
            if health.goal:
                context_parts.append(f"【项目目标】\n{health.goal}")
            if health.goal_title:
                context_parts.append(f"【所属战略目标】{health.goal_title}：{health.goal_description}")
            context_block = '\n\n'.join(context_parts) if context_parts else ''
            
            # 📚 知识库上下文
            knowledge_context = ''
            retriever = get_knowledge_retriever()
            if retriever:
                search_query = f"{health.project_name} {health.description[:50]}"
                knowledge_context = retriever.format_context(search_query, top_k=3, max_tokens=1500)
            
            # 已完成任务
            recent_done_list = health.recent_completed_tasks
            
            prompt = f"""你是一个专业的项目管理AI，负责根据项目的真实缺口生成具体、可执行的任务。

【项目信息】
项目名称：{health.project_name}
项目ID：{health.project_id}
当前完成率：{health.completion_rate:.0%}
总任务数：{health.total_tasks}
已完成：{health.completed_tasks}
失败任务：{health.failed_tasks}
距离上次更新：{health.days_since_activity} 天

{context_block}

{knowledge_context}

【检测到的缺口】
{gap_text}

【已完成的任务】（绝对不要生成相同或近似的任务！）
{recent_done_list}

【要求】
1. 为【每一个缺口】生成 1-2 个具体、可执行、有明确交付物的任务
2. 绝对不要生成上面已完成列表中已经做过的任务
3. 任务必须针对对应的缺口，解决实际问题
4. 不要生成空泛的模板任务（如“整理文档”、“归档”、“梳理情况”、“盘点”、“评估”等）
5. 每个任务要有明确的验收标准和交付物
6. 任务标题 10-25 字，要有具体动作
7. 只返回纯JSON，格式如下：
{{"tasks": [{{"gap_type": "activity_gap|quality_gap|output_gap|documentation_gap", "title": "任务标题", "description": "任务详细说明+验收标准"}}]}}
"""
            
            # 调用LLM（复用 openclaw.json 配置）
            config_path = Path.home() / '.openclaw' / 'openclaw.json'
            with open(config_path) as f:
                cfg = json.load(f)
            
            providers = cfg.get('models', {}).get('providers', {})
            acp = providers.get('alicodingplan', {})
            ds = providers.get('deepseek', {})
            ms = providers.get('moonshot', {})
            hsc = providers.get('huoshanCoding', {})
            dmx = providers.get('dmxapi', {})
            hs = providers.get('huoshan', {})
            al = providers.get('aliyun', {})
            
            models_to_try = [
                {'name': 'alicodingplan',  'base_url': acp.get('baseUrl'), 'model': 'kimi-k2.5',                'headers': acp.get('headers', {}), 'timeout': 15},
                {'name': 'deepseek',       'base_url': ds.get('baseUrl'),  'model': 'deepseek-chat',            'headers': ds.get('headers', {}), 'timeout': 15},
                {'name': 'moonshot',       'base_url': ms.get('baseUrl'),  'model': 'kimi-k2.6',                'headers': ms.get('headers', {}), 'timeout': 15},
                {'name': 'alicodingplan+', 'base_url': acp.get('baseUrl'), 'model': 'qwen3.6-plus',             'headers': acp.get('headers', {}), 'timeout': 15},
                {'name': 'huoshanCoding',  'base_url': hsc.get('baseUrl'), 'model': 'ark-code-latest',          'headers': hsc.get('headers', {}), 'timeout': 15},
                {'name': 'dmxapi',         'base_url': dmx.get('baseUrl'), 'model': 'gpt-5.4',                  'headers': dmx.get('headers', {}), 'timeout': 15},
                {'name': 'huoshan',        'base_url': hs.get('baseUrl'),  'model': 'doubao-seed-2-0-pro-260215','headers': hs.get('headers', {}), 'timeout': 15},
                {'name': 'aliyun',         'base_url': al.get('baseUrl'),  'model': 'qwen3.6-plus',             'headers': al.get('headers', {}), 'timeout': 15},
            ]
            
            llm_tasks = None
            used_model = None
            
            for model_cfg in models_to_try:
                if llm_tasks is not None:
                    break
                if not model_cfg.get('base_url'):
                    continue
                
                try:
                    url = f"{model_cfg['base_url']}/chat/completions"
                    headers = {
                        'Content-Type': 'application/json',
                        **model_cfg.get('headers', {})
                    }
                    for k, v in list(headers.items()):
                        if '${' in str(v):
                            def replace_env(match):
                                env_var = match.group(1).strip()
                                value = os.environ.get(env_var, '')
                                if not value:
                                    env_file = Path.home() / '.openclaw' / '.env'
                                    if env_file.exists():
                                        with open(env_file) as ef:
                                            for line in ef:
                                                if '=' in line and line.split('=')[0].strip() == env_var:
                                                    value = line.split('=', 1)[1].strip()
                                                    break
                                return value
                            headers[k] = re.sub(r'\$\{([^}]+)\}', replace_env, v)
                    
                    payload = {
                        'model': model_cfg['model'],
                        'messages': [{'role': 'user', 'content': prompt}],
                        'temperature': 1.0,
                        'response_format': {'type': 'json_object'}
                    }
                    
                    timeout = model_cfg.get('timeout', 15)
                    resp = requests.post(url, json=payload, headers=headers, timeout=timeout)
                    
                    if resp is None:
                        raise ValueError("API返回空响应")
                    if resp.status_code != 200:
                        raise ValueError(f"HTTP {resp.status_code}: {resp.text[:200]}")
                    if not resp.text or not resp.text.strip():
                        raise ValueError("API返回空body")
                    
                    result = resp.json()
                    if not result or not isinstance(result, dict):
                        raise ValueError(f"API返回格式异常: {type(result)}")
                    if not result.get('choices'):
                        raise ValueError(f"API返回无choices: {result}")
                    
                    choice = result['choices'][0]
                    message = choice.get('message', {})
                    content = message.get('content', '')
                    if not content:
                        raise ValueError(f"LLM返回空content: {message}")
                    
                    try:
                        tasks_data = json.loads(content)
                    except json.JSONDecodeError as e:
                        json_match = re.search(r'\{[\s\S]*"tasks"[\s\S]*\}', content)
                        if json_match:
                            tasks_data = json.loads(json_match.group())
                        else:
                            raise ValueError(f"JSON解析失败: {e}")
                    
                    llm_tasks = tasks_data.get('tasks', [])
                    if not llm_tasks or not isinstance(llm_tasks, list):
                        raise ValueError(f"tasks字段无效")
                    
                    used_model = model_cfg['name']
                    
                except Exception as e:
                    logger.debug(f"模型{model_cfg['name']}调用失败: {e}")
                    continue
            
            if llm_tasks:
                # 将LLM生成的任务填充到对应的缺口中
                # 按 gap_type 匹配
                gap_type_map = {}
                for g in gaps:
                    gt = g.gap_type.value
                    gap_type_map.setdefault(gt, []).append(g)
                
                for task in llm_tasks:
                    task_gap_type = task.get('gap_type', '')
                    matched_gaps = gap_type_map.get(task_gap_type, [])
                    
                    if matched_gaps:
                        # 匹配到对应缺口
                        target_gap = matched_gaps[0]
                        target_gap.recommended_task = {
                            'title': task.get('title', f'【{health.project_name}】{task_gap_type}'),
                            'description': task.get('description', ''),
                            'priority': max(1, 5 - target_gap.severity),
                            'task_type': 'llm_generated'
                        }
                        logger.info(f"✅ LLM为缺口 {task_gap_type} 生成任务: {task.get('title', '')}")
                    else:
                        # 未匹配到具体缺口，作为通用任务
                        if gaps:
                            first_gap = gaps[0]
                            first_gap.recommended_task = {
                                'title': task.get('title', ''),
                                'description': task.get('description', ''),
                                'priority': 2,
                                'task_type': 'llm_generated'
                            }
                
                logger.info(f"LLM({used_model})为 {health.project_name} 的 {len(gaps)} 个非进度缺口生成了 {len(llm_tasks)} 个任务")
            else:
                logger.warning(f"⚠️ LLM未能为 {health.project_name} 的非进度缺口生成任务，下周期重试")
                
        except Exception as e:
            logger.error(f"LLM为缺口生成任务失败（项目：{health.project_name}）: {e}")
            logger.info("不使用模板兜底，记录失败，下个周期自动重试")
    
    def _detect_activity_gap(self, project: Dict, health: ProjectHealth):
        """检测活跃度缺口 —— 只检测，不生成任务模板"""
        if health.days_since_activity > 21:
            severity = 5
        elif health.days_since_activity > 14:
            severity = 3
        else:
            return
        
        # 仅记录缺口数据，不生成 recommended_task
        health.gaps.append(Gap(
            project_id=health.project_id,
            project_name=health.project_name,
            gap_type=GapType.ACTIVITY,
            severity=severity,
            description=f"项目已沉寂{health.days_since_activity}天，无任何活动更新",
            recommended_task={}  # 占位，由 _llm_generate_tasks_for_all_gaps 统一填充
        ))
    
    def _detect_quality_gap(self, project: Dict, health: ProjectHealth):
        """检测质量缺口 —— 只检测，不生成任务模板"""
        if health.failed_tasks >= 5:
            severity = 4
        elif health.failed_tasks >= 3:
            severity = 2
        else:
            return
        
        health.gaps.append(Gap(
            project_id=health.project_id,
            project_name=health.project_name,
            gap_type=GapType.QUALITY,
            severity=severity,
            description=f"项目有{health.failed_tasks}个任务验证失败，执行质量存在问题",
            recommended_task={}  # 占位，由 _llm_generate_tasks_for_all_gaps 统一填充
        ))
    
    def _detect_output_gap(self, project: Dict, health: ProjectHealth):
        """检测产出缺口 —— 只检测，不生成任务模板"""
        project_id = health.project_id
        output_dir = Path(f"/Users/mettlyz/.openclaw/workspace/output/task-{project_id}")
        
        has_output = output_dir.exists() and len(list(output_dir.glob('*'))) > 0
        
        if not has_output and health.total_tasks > 0:
            health.gaps.append(Gap(
                project_id=health.project_id,
                project_name=health.project_name,
                gap_type=GapType.OUTPUT,
                severity=3,
                description=f"项目执行了{health.total_tasks}个任务，但没有任何产出物留存",
                recommended_task={}  # 占位，由 _llm_generate_tasks_for_all_gaps 统一填充
            ))
    
    def _detect_documentation_gap(self, project: Dict, health: ProjectHealth):
        """检测文档缺口 —— 只检测，不生成任务模板"""
        description = project.get('description') or ''
        goal = project.get('goal') or ''
        
        has_adequate_docs = len(description) > 100 or len(goal) > 100
        
        if not has_adequate_docs and health.status == 'active':
            health.gaps.append(Gap(
                project_id=health.project_id,
                project_name=health.project_name,
                gap_type=GapType.DOCUMENTATION,
                severity=2,
                description=f"项目缺少详细的描述文档和目标定义",
                recommended_task={}  # 占位，由 _llm_generate_tasks_for_all_gaps 统一填充
            ))
    
    def get_task_recommendations(self, limit: int = 15, ensure_project_diversity: bool = True) -> List[Dict]:
        """获取任务推荐列表
        
        Args:
            limit: 最大推荐数量
            ensure_project_diversity: 是否确保项目多样性（每个项目只推荐1个任务，避免集中在少数项目）
        """
        if not self.all_gaps:
            self.analyze_all_projects()
        
        # 按严重程度排序，最严重的在前
        sorted_gaps = sorted(self.all_gaps, key=lambda g: g.severity, reverse=True)
        
        # 7大目标ID映射（避免全部任务堆在目标7）
        GOAL_ID_MAP = {
            '和光智成': 2, 'T109': 3, '专利': 3, '学术': 3,
            '财富': 4, '投资': 4, '资产': 4,
            '家庭': 5, '子女': 5, '睡眠': 7, '运动': 7, '身心': 7,
            '法律': 6, '诉讼': 6, 'SDS': 1, '自我驱动': 1, 'AI': 1, '效率': 1,
            '渠道': 2, '商业化': 2, '产品线': 2
        }
        
        recommendations = []
        seen_projects = set()  # 记录已经推荐过的项目
        
        # 第一轮：每个项目只选最严重的1个缺口，确保项目多样性
        if ensure_project_diversity:
            for gap in sorted_gaps:
                if gap.project_id not in seen_projects:
                    task = self._create_task_from_gap(gap, GOAL_ID_MAP)
                    recommendations.append(task)
                    seen_projects.add(gap.project_id)
                    if len(recommendations) >= limit:
                        break
            
            logger.info(f"第一轮推荐（项目多样性）: 从 {len(seen_projects)} 个不同项目中生成 {len(recommendations)} 个推荐")
            
            # 第二轮：如果还没达到limit，补充每个项目的第二个缺口
            if len(recommendations) < limit:
                seen_projects_round2 = set()
                for gap in sorted_gaps:
                    if gap.project_id in seen_projects and gap.project_id not in seen_projects_round2:
                        task = self._create_task_from_gap(gap, GOAL_ID_MAP)
                        # 确保不重复添加完全相同的任务（标题不同）
                        if task['title'] not in [r['title'] for r in recommendations]:
                            recommendations.append(task)
                            seen_projects_round2.add(gap.project_id)
                            if len(recommendations) >= limit:
                                break
                
                logger.info(f"第二轮补充: 补充 {len(seen_projects_round2)} 个项目的第二个缺口，总计 {len(recommendations)} 个推荐")
        else:
            # 不保证多样性的模式：直接按严重程度取前limit个
            for gap in sorted_gaps[:limit]:
                task = self._create_task_from_gap(gap, GOAL_ID_MAP)
                recommendations.append(task)
        
        # 扩展推荐池到 limit * 2，确保被拦截后还有备用
        extended_recommendations = []
        seen_projects_extended = set()
        for gap in sorted_gaps:
            if len(extended_recommendations) >= limit * 2:
                break
            task = self._create_task_from_gap(gap, GOAL_ID_MAP)
            # 只添加不在主推荐列表且项目不同的任务
            if task['title'] not in [r['title'] for r in recommendations] and gap.project_id not in seen_projects_extended:
                extended_recommendations.append(task)
                seen_projects_extended.add(gap.project_id)
        
        # 保存备用推荐池供任务生成器使用
        self.backup_recommendations = extended_recommendations
        logger.info(f"备用推荐池: 准备了 {len(extended_recommendations)} 个备用任务推荐")
        
        return recommendations
    
    def _create_task_from_gap(self, gap, GOAL_ID_MAP: Dict) -> Dict:
        """从缺口创建任务推荐"""
        # 确保 recommended_task 有基本字段
        base_task = gap.recommended_task or {}
        if not base_task.get('title'):
            base_task = {
                'title': f"【{gap.project_name}】{gap.gap_type.value}处理",
                'description': gap.description,
                'priority': max(1, 5 - gap.severity),
                'task_type': 'auto_generated'
            }
        
        task = base_task.copy()
        task['gap_type'] = gap.gap_type.value
        task['gap_severity'] = gap.severity
        task['project_id'] = gap.project_id
        task['project_name'] = gap.project_name
        
        # 智能分配goal_id，避免全部堆在目标7
        project_name = gap.project_name
        assigned_goal_id = 7  # 默认
        for keyword, goal_id in GOAL_ID_MAP.items():
            if keyword in project_name:
                assigned_goal_id = goal_id
                break
        
        task['goal_id'] = assigned_goal_id
        return task
    
    def get_backup_recommendations(self, exclude_titles: List[str], limit: int = 10) -> List[Dict]:
        """获取备用推荐，用于主推荐被拦截后的补充
        
        Args:
            exclude_titles: 需要排除的标题列表（已经拦截过的）
            limit: 最多返回多少个
        """
        if not hasattr(self, 'backup_recommendations') or not self.backup_recommendations:
            return []
        
        backups = []
        for rec in self.backup_recommendations:
            if rec['title'] not in exclude_titles and len(backups) < limit:
                backups.append(rec)
        
        return backups
    
    def print_report(self):
        """打印分析报告"""
        print("\\n" + "=" * 80)
        print("📊 项目缺口分析报告")
        print("=" * 80)
        
        for health in sorted(self.project_healths.values(), key=lambda x: x.health_score):
            icon = "🔴" if health.health_score < 50 else "🟡" if health.health_score < 75 else "🟢"
            print(f"\\n{icon} 项目 #{health.project_id}: {health.project_name}")
            print(f"   健康度: {health.health_score:.0f}/100 | 任务: {health.total_tasks} | "
                  f"完成率: {health.completion_rate:.0%} | 沉寂: {health.days_since_activity}天")
            
            if health.gaps:
                print(f"   发现缺口:")
                for g in health.gaps:
                    severity_icon = "🔥" * g.severity
                    print(f"      {severity_icon} {g.gap_type.value}: {g.description}")
        
        print("\\n" + "=" * 80)
        print(f"✅ 共分析 {len(self.project_healths)} 个项目，发现 {len(self.all_gaps)} 个缺口")
        print("=" * 80)


