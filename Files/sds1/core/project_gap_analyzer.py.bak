if __name__ == "__main__":
    analyzer = ProjectGapAnalyzer()
    analyzer.analyze_all_projects()
    analyzer.print_report()
    
    print("\\n📋 前10个任务推荐:")
    for i, rec in enumerate(analyzer.get_task_recommendations(10), 1):
        print(f"\\n{i}. {rec['title']}")
        print(f"   严重度: {rec['gap_severity']}/5 | 项目: {rec['project_name']}")
        print(f"   {rec['description'][:100]}...")
